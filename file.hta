    Randomize Timer
    Dim r1: r1 = Hex(Int(Rnd * &HFFFF) + &H1000)
    Dim r2: r2 = Hex(Int(Rnd * &HFFFF) + &H1000)
    Dim r3: r3 = Hex(Int(Rnd * &HFFFF) + &H1000)
    SafeGuid = "DEADBEEF" & r1 & r2 & "4" & r3 & "A0000001B3B4"
End Function
</script>
</head><body></body></html>
